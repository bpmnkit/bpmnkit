<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="order-fulfilment" name="Order fulfilment" isExecutable="true">
    <bpmn:startEvent id="start" name="Order received">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="check-stock" name="Check stock">
      <bpmn:extensionElements><zeebe:taskDefinition type="check-stock" retries="3" /></bpmn:extensionElements>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="charge-card" name="Charge card">
      <bpmn:extensionElements><zeebe:taskDefinition type="charge-card" retries="3" /></bpmn:extensionElements>
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="declined" name="Payment declined" attachedToRef="charge-card">
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:errorEventDefinition id="declined-def" errorRef="error-declined" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="fulfilled" name="Order fulfilled">
      <bpmn:incoming>f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="notify" name="Notify customer">
      <bpmn:extensionElements><zeebe:script expression="=&quot;payment declined, order cancelled&quot;" resultVariable="notification" /></bpmn:extensionElements>
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="cancelled" name="Order cancelled">
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="check-stock" />
    <bpmn:sequenceFlow id="f2" sourceRef="check-stock" targetRef="charge-card" />
    <bpmn:sequenceFlow id="f3" sourceRef="charge-card" targetRef="fulfilled" />
    <bpmn:sequenceFlow id="f4" sourceRef="declined" targetRef="notify" />
    <bpmn:sequenceFlow id="f5" sourceRef="notify" targetRef="cancelled" />
  </bpmn:process>
  <bpmn:error id="error-declined" name="Payment declined" errorCode="PAYMENT_DECLINED" />
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="order-fulfilment">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="152" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="131" y="145" width="78" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="check-stock_di" bpmnElement="check-stock"><dc:Bounds x="240" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="charge-card_di" bpmnElement="charge-card"><dc:Bounds x="390" y="80" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fulfilled_di" bpmnElement="fulfilled"><dc:Bounds x="552" y="102" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="532" y="145" width="76" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notify_di" bpmnElement="notify"><dc:Bounds x="390" y="220" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cancelled_di" bpmnElement="cancelled"><dc:Bounds x="552" y="242" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="530" y="285" width="80" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="declined_di" bpmnElement="declined"><dc:Bounds x="422" y="142" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="468" y="175" width="60" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="188" y="120" /><di:waypoint x="240" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="340" y="120" /><di:waypoint x="390" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="490" y="120" /><di:waypoint x="552" y="120" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="440" y="178" /><di:waypoint x="440" y="220" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5"><di:waypoint x="490" y="260" /><di:waypoint x="552" y="260" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
