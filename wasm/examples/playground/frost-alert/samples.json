[
	{
		"name": "frost tomorrow",
		"element": "forecast",
		"baseVar": "meteoBase",
		"variables": { "location": "Berlin", "latitude": 52.52, "longitude": 13.41 },
		"http": {
			"method": "GET",
			"path": "/v1/forecast",
			"status": 200,
			"body": "{\"daily\":{\"time\":[\"2026-11-26\",\"2026-11-27\"],\"temperature_2m_min\":[-1.4,-2.0]}}"
		},
		"expect": { "complete": { "variables": { "tomorrowMin": -2.0, "forecastDate": "2026-11-27" } } }
	},
	{
		"name": "mild tomorrow",
		"element": "forecast",
		"baseVar": "meteoBase",
		"variables": { "location": "Singapore", "latitude": 1.29, "longitude": 103.85 },
		"http": {
			"method": "GET",
			"path": "/v1/forecast",
			"status": 200,
			"body": "{\"daily\":{\"time\":[\"2026-11-26\",\"2026-11-27\"],\"temperature_2m_min\":[24.9,25.3]}}"
		},
		"expect": { "complete": { "variables": { "tomorrowMin": 25.3, "forecastDate": "2026-11-27" } } }
	},
	{
		"name": "api error fails the job",
		"element": "forecast",
		"baseVar": "meteoBase",
		"variables": { "location": "Nowhere", "latitude": 999, "longitude": 0 },
		"http": {
			"method": "GET",
			"path": "/v1/forecast",
			"status": 400,
			"body": "{\"error\":true,\"reason\":\"Latitude must be in range of -90 to 90°.\"}"
		},
		"expect": { "fail": {} }
	}
]
