{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bpmnkit-drop",
	"main": "src/worker.ts",
	"compatibility_date": "2026-07-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		// Bumped whenever the Terms of Use / Privacy Policy change; recorded on each drop.
		"TOS_VERSION": "2026-09-24",
		// AI process review. AI_PASSCODE is a secret (wrangler secret put) — unset = feature off.
		"AI_MODEL": "@cf/openai/gpt-oss-120b",
		// Describe-to-diagram. Pick from MODEL_PROFILES in src/lib/generate.ts, by the bench:
		// glm-4.7-flash had the steadiest latency (first byte < 0.7 s, total < 3.7 s) with
		// thinking off — doc/drop-ai-generate-analysis.md §8.
		"AI_GENERATE_MODEL": "@cf/zai-org/glm-4.7-flash",
		// Asked too if glm has written nothing after AI_GENERATE_HEDGE_MS (Workers AI queueing);
		// the first to write wins. Remove to turn the hedge off.
		"AI_GENERATE_FALLBACK_MODEL": "@cf/google/gemma-4-26b-a4b-it",
		"AI_GENERATE_HEDGE_MS": "1500",
		// Reads a whiteboard, sketch or photo for a first draft. Unset = no image input.
		"AI_GENERATE_IMAGE_MODEL": "@cf/google/gemma-4-26b-a4b-it",
		// Changes a shared diagram from its review comments. Unset = off. glm-4.7-flash until
		// `bench:generate --feedback` says otherwise (doc/drop-ai-feedback-edits-analysis.md §13).
		"AI_FEEDBACK_MODEL": "@cf/zai-org/glm-4.7-flash",
		// Configures the connectors of a diagram that has its shape (the second pass of
		// doc/ai-connector-generation-plan.md §4). Unset = off. glm-4.7-flash until
		// `bench:generate --connect` says otherwise.
		"AI_CONNECT_MODEL": "@cf/zai-org/glm-4.7-flash",
		"AI_DAILY_BUDGET": "8000",
		"TURNSTILE_SITE_KEY": "0x4AAAAAAExoiG_f6MSVcEiN"
		// Turnstile on the edit claim. Add TURNSTILE_SITE_KEY here (it is public and
		// rendered into the page) and `wrangler secret put TURNSTILE_SECRET`. With
		// neither, claims are not challenged; with the secret alone, every claim
		// fails — which is the right way round for a check whose job is to say no.
	},
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bpmnkit-drop",
			// Replace with the real database id after `wrangler d1 create bpmnkit-drop`.
			"database_id": "4f6807dc-95a5-442f-bae0-876977eb4072",
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOM",
				"class_name": "DocRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PresenceRoom"]
		},
		// The presence room grew into the document room; renaming keeps the existing
		// instances (and their stored view counters) rather than starting fresh ones.
		{
			"tag": "v2",
			"renamed_classes": [{ "from": "PresenceRoom", "to": "DocRoom" }]
		}
	],
	"triggers": {
		// Daily at 03:17 UTC — delete drops past their sliding-TTL expiry.
		"crons": ["17 3 * * *"]
	},
	"routes": [{ "pattern": "bpmnkit.com/drop*", "zone_name": "bpmnkit.com" }]
}
