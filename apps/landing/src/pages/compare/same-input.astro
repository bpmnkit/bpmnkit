---
import "../../styles/global.css"
import Seo from "@bpmnkit/astro-shared/Seo.astro"
import Footer from "../../components/Footer.astro"
import Nav from "../../components/Nav.astro"
import { AI_BENCHMARK_REPLAY } from "../../generated/ai-benchmark-replay"

// Generated by `node scripts/build-compare-data.mjs` and committed, so building the site never
// needs a recording or an LLM.
const data = import.meta.glob("../../generated/compare/*.json", { eager: true, import: "default" })
const svgs = import.meta.glob("../../generated/compare/*/*.svg", {
	eager: true,
	query: "?raw",
	import: "default",
}) as Record<string, string>

interface Run {
	route: string
	runId: string
	recordedAt: string
	durationMs: number | null
	inputTokens: number | null
	outputTokens: number | null
	parses: boolean
	diComplete: boolean | null
	lintErrors: number | null
	closeness: number | null
	error: string | null
	model: string | null
	costUsd: number | null
	tests: TestResult
}
interface TestResult {
	status: "pass" | "fail" | "unavailable"
	passed: number
	total: number
	failure: string | null
}
interface RouteSummary {
	runs: number
	parsed: number
	diComplete: number
	zeroLintErrors: number
	featuredRunId: string | null
	closenessMedian: number | null
	closenessBest: number | null
	closenessWorst: number | null
	durationMsMedian: number | null
	inputTokensMedian: number | null
	outputTokensMedian: number | null
	costUsdMedian: number | null
	costedRuns: number
	testsRan: number
	testsPassed: number
}
interface Scenario {
	scenario: string
	prompt: string
	pricesAsOf: string
	reference: {
		durationMs: number
		parses: boolean
		diComplete: boolean
		lintErrors: number
		closeness: number
		tests: TestResult
	}
	routes: Record<string, RouteSummary>
	runs: Run[]
}

const ROUTE_LABEL: Record<string, string> = {
	"raw-xml": "LLM → raw XML",
	"compact-json": "LLM → compact JSON",
	"compact-dsl": "LLM → compact notation",
	"builder-script": "LLM → builder script",
	plan: "LLM → plan (casen synth)",
}
const ORDER = ["raw-xml", "compact-json", "compact-dsl", "builder-script", "plan"]

const scenarios = (Object.values(data) as Scenario[]).sort((a, b) =>
	a.scenario.localeCompare(b.scenario),
)
const svgOf = (scenario: string, name: string) =>
	svgs[`../../generated/compare/${scenario}/${name}.svg`] ?? null

const fmt = (n: number | null | undefined, digits = 0) =>
	n == null ? "—" : n.toLocaleString("en-US", { maximumFractionDigits: digits })
const secs = (ms: number | null | undefined) => (ms == null ? "—" : `${(ms / 1000).toFixed(1)} s`)
const tokens = (r: RouteSummary) =>
	r.inputTokensMedian == null && r.outputTokensMedian == null
		? "—"
		: `${fmt(r.inputTokensMedian)} in / ${fmt(r.outputTokensMedian)} out`
const day = (iso: string) => iso.slice(0, 10)
const usd = (n: number | null | undefined) =>
	n == null ? "—" : `$${n < 0.1 ? n.toFixed(3) : n.toFixed(2)}`
const testCell = (t: TestResult) =>
	t.status === "unavailable" ? "not run" : t.status === "pass" ? "pass" : "fail"
const routeCost = (r: RouteSummary) =>
	r.costedRuns === 0
		? "—"
		: `${usd(r.costUsdMedian)} median (${r.costedRuns} of ${r.runs} runs priced)`
const routeTests = (r: RouteSummary) =>
	r.testsRan === 0 ? "not run" : `${r.testsPassed} / ${r.testsRan} runs pass`

// Builder-script runs that failed when recorded, joined to the replay of the same recording.
const replayById = new Map(AI_BENCHMARK_REPLAY.runs.map((r) => [r.recording, r]))
const replayNote = (s: Scenario) => {
	const failed = s.runs.filter((r) => r.route === "builder-script" && r.error)
	if (!failed.length) return null
	const replays = failed.map((r) => replayById.get(r.runId))
	const compiled = replays.filter((r) => r?.replayed && r.usable).length
	return `${failed.length} of the ${s.routes["builder-script"]?.runs} builder-script runs below failed when recorded. Re-running those scripts against @bpmnkit/core ${AI_BENCHMARK_REPLAY.coreVersion} compiles ${compiled} of the ${failed.length}.`
}
// Fewer than 3 runs is too few for a median to mean much.
const MIN_RUNS = 3

const allRuns = scenarios.flatMap((s) => s.runs)
const dates = allRuns.map((r) => r.recordedAt).sort()
const firstDate = dates.length ? day(dates[0]) : "—"
const lastDate = dates.length ? day(dates[dates.length - 1]) : "—"
const models = [
	...new Set(allRuns.map((r) => r.model).filter((m): m is string => m != null)),
].sort()
const unrecorded = allRuns.filter((r) => r.model == null).length
const pricesAsOf = scenarios[0]?.pricesAsOf ?? "—"
// Stale numbers are the page's main risk; warn once the newest recording is ~90 days old.
const newest = dates[dates.length - 1]
const ageDays = newest ? (Date.now() - Date.parse(newest)) / 864e5 : 0
const stale = ageDays > 90
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <Seo
    title="Same input, up to five routes — BPMN Kit comparison"
    description="One prompt, recorded LLM runs and a hand-written no-AI reference, side by side: tokens, time, validity and closeness to the reference."
  />
  <style is:global>
    .si-wrap { min-height: 100dvh; display: flex; flex-direction: column; }
    .si-main { flex: 1; max-width: 1080px; margin: 0 auto; width: 100%; padding: calc(var(--nav-h) + 56px) 24px 80px; }
    .si-main h1 { font-size: clamp(1.8rem, 4vw, 2.4rem); font-weight: 700; letter-spacing: -0.02em; margin-bottom: 14px; }
    .si-main h2 { font-family: var(--font-mono); font-size: 1.3rem; font-weight: 700; margin: 56px 0 12px; }
    .si-main p, .si-main li { color: var(--ink-body); line-height: 1.6; }
    .si-main p { margin-bottom: 12px; }
    .si-main code, .si-label { font-family: var(--font-mono); font-size: 0.8rem; }
    .si-main a { color: var(--accent); }
    .si-intro { max-width: 760px; margin-bottom: 8px; }
    .si-label { color: var(--ink-meta); text-transform: uppercase; letter-spacing: 0.04em; }
    .si-prompt { border: 1px solid var(--rule); background: var(--panel); border-radius: 0; padding: 14px 16px; font-family: var(--font-mono); font-size: 0.78rem; line-height: 1.55; white-space: pre-wrap; color: var(--ink-body); margin: 8px 0 20px; }
    .si-note { border-left: 1px solid var(--accent); padding-left: 14px; }
    /* The whole grid is one bordered box; rows are separated by hairlines only. */
    .si-grid { border: 1px solid var(--rule-strong); border-radius: 0; background: var(--panel); }
    .si-row { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.9fr); border-top: 1px solid var(--rule); }
    .si-row:first-child { border-top: 0; }
    .si-meta { padding: 16px; }
    .si-meta h3 { font-family: var(--font-mono); font-size: 0.95rem; font-weight: 700; margin-bottom: 10px; }
    .si-meta dl { display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; margin: 0; }
    .si-meta dt { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-meta); text-transform: uppercase; }
    .si-meta dd { font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink); margin: 0; }
    .si-row.is-ref .si-meta h3 { color: var(--accent); }
    .si-fig { border-left: 1px solid var(--rule); padding: 8px; overflow: auto; background: var(--ground); min-height: 120px; display: flex; align-items: center; }
    .si-fig svg { max-width: 100%; height: auto; }
    .si-empty { font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-meta); padding: 16px; }
    details.si-runs { margin-top: 12px; border: 1px solid var(--rule); border-radius: 0; background: var(--panel); }
    details.si-runs summary { cursor: pointer; padding: 10px 16px; font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink); }
    .si-table-wrap { overflow-x: auto; border-top: 1px solid var(--rule); }
    .si-table { width: 100%; border-collapse: collapse; font-family: var(--font-mono); font-size: 0.74rem; }
    .si-table th, .si-table td { text-align: left; padding: 6px 10px; border-top: 1px solid var(--rule); white-space: nowrap; }
    .si-table tr:first-child th { border-top: 0; color: var(--ink-meta); text-transform: uppercase; font-weight: 400; }
    .si-bad { color: var(--state-bad); }
    @media (max-width: 760px) { .si-row { grid-template-columns: 1fr; } .si-fig { border-left: 0; border-top: 1px solid var(--rule); } }
  </style>
</head>
<body>
  <Nav />
  <div class="si-wrap">
    <main class="si-main">
      <p class="si-label">Compare</p>
      <h1>Same input, up to five routes</h1>
      <div class="si-intro">
        <p>
          Each scenario below is one prompt. It was given through up to five routes — raw BPMN
          XML, compact JSON, a compact line notation, a <code>@bpmnkit/core</code> builder script
          and a plan compiled by <code>casen synth</code> — and recorded between
          {firstDate} and {lastDate}. Only the July recordings have the line notation, and
          only recordings made since November 2026 have compact JSON and plan rows. The first row,
          labelled <strong>no AI</strong>, is a builder script written by hand from the prompt alone.
        </p>
        <p>
          These are <strong>recordings, not live runs</strong>. Each recording stores the model's
          output; the builder-script and compact-JSON outputs are re-executed against the current
          library, as on the <a href="/#ai-benchmark">homepage benchmark</a>, so a replay says what
          the library does with that output today, not what the model would write now. Recordings
          made since November 2026 store the model id ({models.length ? models.join(", ") : "none yet"});
          {unrecorded} older runs do not, so they show no model and no cost.
        </p>
        {stale && (
          <p class="si-note si-bad">
            The newest recording is {Math.round(ageDays)} days old. Models change; treat these numbers as history.
          </p>
        )}
        <p>
          <strong>Closeness</strong> (0–100) is how near an output is to the reference:
          structure 25, configuration 45, annotations 15, layout 15 points. Because each model picks its
          own ids and names, elements are matched by <em>structure</em>, not by name: each element is
          described by its type (and event definition), its depth in the flow and how many flows enter
          and leave it, and elements are paired greedily by smallest difference. Configuration compares
          which kind of Zeebe setting an element carries (job type, I/O mapping, form, called
          element), not its value, and layout compares positions after scaling each diagram to the
          same box. The full definition is in
          <a href="https://github.com/bpmnkit/bpmnkit/blob/main/scripts/lib/closeness.mjs"><code>scripts/lib/closeness.mjs</code></a>.
          It measures agreement with <em>one</em> hand-written model, not quality, and the reference
          scores 100 against itself by construction. A different but equally valid process scores
          lower, so a gap to the reference is not by itself an error.
        </p>
        <p class="si-note">
          Where a number below says the no-AI reference is cheaper or faster, it is: it needs no
          tokens and builds in milliseconds. What it cannot show is what writing it cost the person
          who wrote it, and it was written for exactly these three prompts. Runs per route range from 1 to 5, so treat the medians as anecdotal. Failed runs are kept as
          rows. Tokens and time are medians over all runs of a route; closeness is the median over
          the runs that parse.
        </p>
        <p class="si-note">
          <strong>Cost</strong> is tokens × Anthropic list prices per million input and output
          tokens from <a href="https://github.com/bpmnkit/bpmnkit/blob/main/scripts/lib/model-prices.mjs"><code>scripts/lib/model-prices.mjs</code></a>
          (table dated {pricesAsOf}). It is shown only for a run whose model is in that table and
          that recorded an input/output token split, and is "—" otherwise. Recorded input tokens
          include cache reads and writes, which this prices as plain input, so a cached prompt is
          overstated.
        </p>
        <p class="si-note">
          <strong>Tests</strong> run the scenario's Camunda process-test file
          (<code>scripts/compare/references/&lt;scenario&gt;.test.json</code>, the main happy path
          from the prompt) on reebe-wasm, as <code>casen test</code> does. The test addresses the
          hand-written reference's process id, element ids and job types, and the prompts do not
          fix those, so a model's output fails at its first instruction for naming alone, whatever
          its logic. Read "fail" as "does not match this reference's names", not as "wrong process".
          Where the data build could not run the engine the column says "not run"; it is never
          filled in by hand. Test files cannot publish a message and no DMN is deployed, so the
          happy paths supply the decision outcome as a variable (loan approval, KYC) and stop at the
          signature wait (quote-to-cash).
        </p>
      </div>

      {scenarios.map((s) => {
        const refSvg = svgOf(s.scenario, "reference")
        return (
          <section id={s.scenario}>
            <h2>{s.scenario}</h2>
            <p class="si-label">Prompt</p>
            <pre class="si-prompt">{s.prompt}</pre>
            <div class="si-grid">
              <div class="si-row is-ref">
                <div class="si-meta">
                  <h3>Hand-written reference (no AI)</h3>
                  <dl>
                    <dt>Tokens</dt><dd>0</dd>
                    <dt>Time</dt><dd>{fmt(s.reference.durationMs)} ms</dd>
                    <dt>Parses</dt><dd>{s.reference.parses ? "yes" : "no"}</dd>
                    <dt>DI</dt><dd>{s.reference.diComplete ? "complete" : "incomplete"}</dd>
                    <dt>Lint errors</dt><dd>{s.reference.lintErrors}</dd>
                    <dt>Cost</dt><dd>$0</dd>
                    <dt>Tests</dt><dd>{testCell(s.reference.tests)}</dd>
                    <dt>Closeness</dt><dd>{fmt(s.reference.closeness, 1)} (by definition)</dd>
                  </dl>
                </div>
                <div class="si-fig">
                  {refSvg ? <Fragment set:html={refSvg} /> : <span class="si-empty">no diagram</span>}
                </div>
              </div>
              {ORDER.filter((k) => s.routes[k]).map((k) => {
                const r = s.routes[k]
                const svg = svgOf(s.scenario, k)
                return (
                  <div class="si-row">
                    <div class="si-meta">
                      <h3>{ROUTE_LABEL[k]}</h3>
                      <dl>
                        <dt>Tokens</dt><dd>{tokens(r)}</dd>
                        <dt>Time</dt><dd>{secs(r.durationMsMedian)}</dd>
                        <dt>Cost</dt><dd>{routeCost(r)}</dd>
                        <dt>Parses</dt><dd>{r.parsed} / {r.runs} runs</dd>
                        <dt>Tests</dt><dd>{routeTests(r)}</dd>
                        <dt>DI</dt><dd>{r.diComplete} / {r.runs} complete</dd>
                        <dt>Lint errors</dt><dd>{r.zeroLintErrors} / {r.runs} with none</dd>
                        <dt>Closeness</dt>
                        <dd>{fmt(r.closenessMedian, 1)} median ({fmt(r.closenessWorst, 1)}–{fmt(r.closenessBest, 1)}){r.runs < MIN_RUNS ? " — indicative, fewer than 3 runs" : ""}</dd>
                        <dt>Diagram</dt><dd>{r.featuredRunId ?? "none parsed"}</dd>
                      </dl>
                    </div>
                    <div class="si-fig">
                      {svg ? <Fragment set:html={svg} /> : <span class="si-empty">no run produced a diagram</span>}
                    </div>
                  </div>
                )
              })}
            </div>
            {replayNote(s) && <p class="si-note">{replayNote(s)}</p>}
            <details class="si-runs">
              <summary>All {s.runs.length} runs</summary>
              <div class="si-table-wrap">
                <table class="si-table">
                  <tbody>
                    <tr>
                      <th>Route</th><th>Run</th><th>Recorded</th><th>Model</th><th>Time</th><th>In</th><th>Out</th><th>Cost</th>
                      <th>Parses</th><th>Tests</th><th>DI</th><th>Lint err</th><th>Closeness</th>
                    </tr>
                    {s.runs.map((r) => (
                      <tr>
                        <td>{ROUTE_LABEL[r.route]}</td>
                        <td>{r.runId}</td>
                        <td>{day(r.recordedAt)}</td>
                        <td>{r.model ?? "not recorded"}</td>
                        <td>{secs(r.durationMs)}</td>
                        <td>{fmt(r.inputTokens)}</td>
                        <td>{fmt(r.outputTokens)}</td>
                        <td>{usd(r.costUsd)}</td>
                        <td class={r.parses ? "" : "si-bad"}>{r.parses ? "yes" : "no"}</td>
                        <td title={r.tests.failure ?? ""}>{testCell(r.tests)}</td>
                        <td>{r.diComplete == null ? "—" : r.diComplete ? "yes" : "no"}</td>
                        <td>{fmt(r.lintErrors)}</td>
                        <td title={r.error ?? ""} class={r.error ? "si-bad" : ""}>
                          {r.error ? `failed: ${r.error.slice(0, 48)}` : fmt(r.closeness, 1)}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          </section>
        )
      })}
    </main>
    <Footer />
  </div>
</body>
</html>
