---
import "../../styles/global.css"
import Seo from "@bpmnkit/astro-shared/Seo.astro"
import { breadcrumbJsonLd } from "@bpmnkit/astro-shared/seo.js"
import { CATALOG } from "@bpmnkit/connector-gen"
import { BPMNKIT_CONNECTOR_TEMPLATES, listConnectors } from "@bpmnkit/connectors"
import Footer from "../../components/Footer.astro"
import Nav from "../../components/Nav.astro"

const bpmnkitIds = new Set(BPMNKIT_CONNECTOR_TEMPLATES.map((t) => t.id))
const all = listConnectors().sort((a, b) => a.name.localeCompare(b.name))
const connectors = all.filter((c) => !bpmnkitIds.has(c.id))
const maintained = all.filter((c) => bpmnkitIds.has(c.id))

const jsonLd = breadcrumbJsonLd([
	{ name: "Home", url: "https://bpmnkit.com" },
	{ name: "Connectors", url: "https://bpmnkit.com/connectors" },
])
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <Seo
    title={`${connectors.length} Camunda 8 Connectors — BPMN Kit`}
    description={`Browse ${connectors.length} built-in Camunda 8 connector templates for @bpmnkit/connectors — Slack, ServiceNow, Stripe, GitHub, and more. Typed inputs, generated from real element templates.`}
    jsonLd={jsonLd}
  />
  <style is:global>
    .connectors-wrap { min-height: 100dvh; display: flex; flex-direction: column; }
    .connectors-main { flex: 1; max-width: var(--max-width); margin: 0 auto; width: 100%; padding: calc(var(--nav-h) + 56px) 24px 80px; }
    .connectors-hero { text-align: center; margin-bottom: 48px; }
    .connectors-hero h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 700; letter-spacing: -0.02em; margin-bottom: 12px; }
    .connectors-hero p { color: var(--text-muted); font-size: 1.05rem; max-width: 640px; margin: 0 auto; }
    .connectors-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; }
    .connector-card { display: block; padding: 18px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); text-decoration: none; transition: border-color 0.2s, transform 0.2s; }
    .connector-card:hover { border-color: var(--ink); }
    .connector-card h3 { font-size: 0.95rem; font-weight: 600; color: var(--text); margin-bottom: 6px; }
    .connector-card p { font-size: 0.82rem; color: var(--text-muted); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .connector-badge { display: inline-block; font-family: var(--font-mono); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-top: 8px; }
    .connectors-section { margin-top: 56px; border-top: 1px solid var(--border); padding-top: 40px; }
    .connectors-section h2 { font-size: 1.4rem; font-weight: 700; margin-bottom: 10px; }
    .connectors-section > p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.65; max-width: 720px; margin-bottom: 20px; }
  </style>
</head>
<body>

  <Nav />

  <div class="connectors-wrap">
    <main class="connectors-main">
      <div class="connectors-hero">
        <h1>{connectors.length} Camunda 8 Connectors</h1>
        <p>Every built-in Camunda 8 out-of-the-box connector template, bundled with <code>@bpmnkit/connectors</code> and applicable to a BPMN element in one call. Need something else? Browse <a href="/integrations">{CATALOG.length} more services ready to generate</a> from their OpenAPI specs.</p>
      </div>
      <div class="connectors-grid">
        {connectors.map((c) => (
          <a href={`/connectors/${encodeURIComponent(c.id)}`} class="connector-card">
            <h3>{c.name}</h3>
            <p>{c.description ?? "Camunda 8 connector template."}</p>
            <span class="connector-badge">{c.direction}</span>
          </a>
        ))}
      </div>
      <section class="connectors-section">
        <h2>Maintained by BPMN Kit</h2>
        <p>Templates for services Camunda does not ship a connector for. They run on Camunda's REST connector, so a cluster needs no extra job worker, and <code>@bpmnkit/connectors</code> bundles them in the same catalog.</p>
        <div class="connectors-grid">
          {maintained.map((c) => (
            <a href={`/connectors/${encodeURIComponent(c.id)}`} class="connector-card">
              <h3>{c.name}</h3>
              <p>{c.description}</p>
              <span class="connector-badge">{BPMNKIT_CONNECTOR_TEMPLATES.find((t) => t.id === c.id)?.category?.name ?? c.direction}</span>
            </a>
          ))}
        </div>
      </section>
    </main>
    <Footer />
  </div>
</body>
</html>
