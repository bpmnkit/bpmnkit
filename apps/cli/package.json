{
	"name": "@bpmnkit/cli-legacy",
	"version": "1.10.0",
	"description": "Legacy Node CLI for Camunda 8, the fallback behind the native bpmnkit binary for commands not ported yet",
	"type": "module",
	"bin": {
		"bpmnkit-legacy": "./dist/index.js"
	},
	"files": ["LICENSE", "README.md", "dist/**/*.js", "skills/**/*.md", "agent-cards/*.md"],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc && node scripts/build-dev-ui.mjs",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.dev-ui.json && tsc -p agent-cards",
		"check": "biome check .",
		"test": "vitest run"
	},
	"dependencies": {
		"@bpmnkit/api": "workspace:^",
		"@bpmnkit/ascii": "workspace:^",
		"@bpmnkit/connector-gen": "workspace:^",
		"@bpmnkit/connectors": "workspace:^",
		"@bpmnkit/core": "workspace:^",
		"@bpmnkit/engine": "workspace:^",
		"@bpmnkit/flow": "workspace:^",
		"@bpmnkit/patterns": "workspace:^",
		"@bpmnkit/profiles": "workspace:^",
		"@bpmnkit/proxy": "workspace:^",
		"@bpmnkit/viewer-lite": "workspace:^"
	},
	"optionalDependencies": {
		"@resvg/resvg-js": "^2.6.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/bpmnkit/bpmnkit"
	},
	"keywords": ["camunda", "bpmn", "cli", "terminal", "zeebe", "workflow", "typescript", "bpmnkit"],
	"license": "MIT",
	"homepage": "https://bpmnkit.com",
	"bugs": {
		"url": "https://github.com/bpmnkit/bpmnkit/issues"
	}
}
