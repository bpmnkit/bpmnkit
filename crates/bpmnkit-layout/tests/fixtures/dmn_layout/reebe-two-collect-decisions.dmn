<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="Definitions_multi" name="DRD" namespace="http://camunda.org/schema/1.0/dmn">
  <decision id="multiValidation" name="Multi-field Validation">
    <decisionTable id="dt1" hitPolicy="COLLECT">
      <input id="i1" label="name">
        <inputExpression id="ie1">
          <text>name</text>
        </inputExpression>
      </input>
      <output id="o1" name="error" typeRef="string"/>
      <rule id="r1">
        <inputEntry id="ie1r1">
          <text>null</text>
        </inputEntry>
        <outputEntry id="oe1r1">
          <text>"name is required"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="ageValidation" name="Age Validation">
    <decisionTable id="dt2" hitPolicy="COLLECT">
      <input id="i2" label="age">
        <inputExpression id="ie2">
          <text>age</text>
        </inputExpression>
      </input>
      <output id="o2" name="error" typeRef="string"/>
      <rule id="r2">
        <inputEntry id="ie2r1">
          <text>&lt; 0</text>
        </inputEntry>
        <outputEntry id="oe2r1">
          <text>"age cannot be negative"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram>
      <dmndi:DMNShape dmnElementRef="multiValidation">
        <dc:Bounds height="80" width="180" x="160" y="100"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape dmnElementRef="ageValidation">
        <dc:Bounds height="80" width="180" x="160" y="220"/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>

