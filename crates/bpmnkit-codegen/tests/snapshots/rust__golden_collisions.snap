// @generated by bpmnkit <version> — sha256:8de0c351d33403387efef6afedd93c750a24a875161795354b43f1f8ee00af71 — DO NOT EDIT
use bpmnkit_worker::{ActivatedJob, Complete, Handler, JobError, WorkerConfig};
use serde::{Deserialize, Serialize};
pub const JOB_TYPE: &str = "fn";
/// Variables fetched for the job: the declared inputs. Empty means all (none declared).
pub const FETCH_VARIABLES: &[&str] = &[];
#[derive(Debug, Clone, Default, Deserialize)]
pub struct FnInput {}
#[derive(Debug, Clone, Default, Serialize)]
pub struct FnOutput {}
/// Implement this in `src/handlers/fn_.rs`. Delivery is at-least-once: be idempotent.
pub trait FnHandler: Send + Sync + 'static {
    fn handle(
        &self,
        input: FnInput,
        job: &ActivatedJob,
    ) -> impl std::future::Future<Output = Result<FnOutput, JobError>> + Send;
}
/// The worker settings of this job type; chain more builder calls to tune them.
pub fn config() -> WorkerConfig {
    let config = WorkerConfig::new(JOB_TYPE);
    if FETCH_VARIABLES.is_empty() {
        config
    } else {
        config.fetch_variables(FETCH_VARIABLES.iter().copied())
    }
}
/// Wraps a handler as a worker [`Handler`]: variables in, variables out, errors mapped.
pub struct Adapter<H>(pub H);
impl<H: FnHandler> Handler for Adapter<H> {
    async fn handle(&self, job: ActivatedJob) -> Result<Complete, JobError> {
        let input: FnInput = serde_json::from_value(
                serde_json::Value::Object(job.variables.clone()),
            )
            .map_err(|e| JobError::fail(
                format!("invalid variables for job type {JOB_TYPE}: {e}"),
            ))?;
        let output = self.0.handle(input, &job).await?;
        Complete::output(&output)
    }
}
===== src/gen/mod.rs [Generated] =====
// @generated by bpmnkit <version> — sha256:8de0c351d33403387efef6afedd93c750a24a875161795354b43f1f8ee00af71 — DO NOT EDIT
use bpmnkit_worker::Runtime;
pub mod errors;
pub mod fn_;
pub mod ship_order;
pub mod ship_order2;
/// Registers one worker per job type, each with its handler from `crate::handlers`.
pub fn register(runtime: Runtime) -> Runtime {
    runtime
        .register(fn_::config(), fn_::Adapter(crate::handlers::fn_::Handler))
        .register(
            ship_order::config(),
            ship_order::Adapter(crate::handlers::ship_order::Handler),
        )
        .register(
            ship_order2::config(),
            ship_order2::Adapter(crate::handlers::ship_order2::Handler),
        )
}
