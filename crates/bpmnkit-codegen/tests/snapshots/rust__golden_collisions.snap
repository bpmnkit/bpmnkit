===== src/handlers/fn_.rs [Once] =====
use bpmnkit_worker::{ActivatedJob, JobError};

use crate::gen::fn_::{FnHandler, FnInput, FnOutput};

pub struct Handler;

impl FnHandler for Handler {
    async fn handle(
        &self,
        _input: FnInput,
        _job: &ActivatedJob,
    ) -> Result<FnOutput, JobError> {
        // Return `Err(JobError::bpmn(code, message))` for a BPMN error (see `gen::errors`);
        // any other error fails the job with retries - 1.
        Err(JobError::fail("job type fn: handler not implemented"))
    }
}
