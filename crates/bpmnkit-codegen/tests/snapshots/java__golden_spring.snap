package com.example.orderworkers.gen;

/**
 * BPMN errors of the model and the mapping from handler exceptions to Camunda commands:
 * a {@link Thrown} becomes a BPMN error (caught by a boundary event), any other exception fails
 * the job with retries - 1 and the back-off of the `retryBackoff` task header (ISO-8601).
 */
public final class BpmnErrors {
    private BpmnErrors() {}

    public static final String PAYMENT_DECLINED = "PAYMENT_DECLINED";

    /** Thrown by a handler to raise a BPMN error. */
    public static final class Thrown extends RuntimeException {
        private final String code;

        public Thrown(String code, String message) {
            super(message);
            this.code = code;
        }

        public String code() {
            return code;
        }
    }

    public static Thrown of(String code, String message) {
        return new Thrown(code, message);
    }

    public static Thrown pAYMENTDECLINED(String message) {
        return new Thrown(PAYMENT_DECLINED, message);
    }

    /** The starter turns this into a BPMN error on the job. */
    public static io.camunda.client.exception.BpmnError toStarter(Thrown t) {
        return new io.camunda.client.exception.BpmnError(t.code(), t.getMessage());
    }
}
