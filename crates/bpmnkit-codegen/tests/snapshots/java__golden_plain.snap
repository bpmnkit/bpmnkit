===== src/main/java/com/example/orderworkers/App.java [Once] =====
package com.example.orderworkers;

import io.camunda.client.CamundaClient;
import io.camunda.client.api.worker.JobWorker;
import java.util.List;
import java.util.concurrent.CountDownLatch;
import com.example.orderworkers.gen.Workers;

/**
 * Written once. The client reads CAMUNDA_REST_ADDRESS, CAMUNDA_CLIENT_ID, CAMUNDA_CLIENT_SECRET,
 * CAMUNDA_AUTHORIZATION_SERVER_URL, CAMUNDA_TOKEN_AUDIENCE from the environment (default:
 * http://localhost:8080).
 */
public final class App {
    private App() {}

    public static void main(String[] args) throws InterruptedException {
        CamundaClient client = CamundaClient.newClientBuilder().build();
        List<JobWorker> workers = Workers.registerAll(client);
        Runtime.getRuntime()
            .addShutdownHook(
                new Thread(
                    () -> {
                        workers.forEach(JobWorker::close);
                        client.close();
                    }));
        new CountDownLatch(1).await();
    }
}
