// @generated by bpmnkit <version> — sha256:d84bf609f6bbb5e27a5c60743772c2d1c4906e25061b8ba3a1ca69191dde2dcf — DO NOT EDIT
package com.example.orderworkers.gen;

import io.camunda.client.CamundaClient;
import io.camunda.client.api.worker.JobWorker;
import java.util.ArrayList;
import java.util.List;
import com.example.orderworkers.handlers.*;

/** Opens one job worker per job type. */
public final class Workers {
    private Workers() {}

    public static List<JobWorker> registerAll(CamundaClient client) {
        List<JobWorker> workers = new ArrayList<>();
        workers.add(
            client
                .newWorker()
                .jobType(JobTypes.CHARGE_CARD)
                .handler(new ChargeCardWorker(new ChargeCardHandler()))
                .fetchVariables(ChargeCardWorker.FETCH_VARIABLES)
                .name("charge-card")
                .open());
        workers.add(
            client
                .newWorker()
                .jobType(JobTypes.SHIP_ORDER)
                .handler(new ShipOrderWorker(new ShipOrderHandler()))
                .name("ship.order")
                .open());
        return workers;
    }
}
