        try {
            ChargeCardOutput output = handler.handle(job.getVariablesAsType(ChargeCardInput.class), job);
            client.newCompleteCommand(job).variables(output).send().join();
        } catch (Exception e) {
            BpmnErrors.report(client, job, e);
        }
    }
