package com.example.orderworkers.gen;

import io.camunda.client.annotation.JobWorker;
import io.camunda.client.annotation.VariablesAsType;
import io.camunda.client.api.response.ActivatedJob;
import org.springframework.stereotype.Component;

/** Adapter between the starter and ChargeCardHandler. Fetches exactly the declared inputs. */
@Component
public class ChargeCardWorker {
    /** Implemented by the once-only stub in handlers/. */
    public interface Handler {
        ChargeCardOutput handle(ChargeCardInput input, ActivatedJob job) throws Exception;
    }

    private final Handler handler;

    public ChargeCardWorker(Handler handler) {
        this.handler = handler;
    }

    @JobWorker(type = JobTypes.CHARGE_CARD, fetchVariables = {"amount", "class", "customer-id"})
    public ChargeCardOutput handle(final ActivatedJob job, @VariablesAsType final ChargeCardInput input) throws Exception {
        try {
            return handler.handle(input, job);
        } catch (BpmnErrors.Thrown t) {
            throw BpmnErrors.toStarter(t);
        }
    }
}
