package com.example.orderworkers.gen;

import io.camunda.client.api.response.ActivatedJob;
import io.camunda.client.api.worker.JobClient;
import io.camunda.client.api.worker.JobHandler;
import java.util.List;

/** Adapter between the client and ChargeCardHandler. Fetches exactly the declared inputs. */
public final class ChargeCardWorker implements JobHandler {
    /** Implemented by the once-only stub in handlers/. */
    public interface Handler {
        ChargeCardOutput handle(ChargeCardInput input, ActivatedJob job) throws Exception;
    }

    public static final List<String> FETCH_VARIABLES = List.of("amount", "class", "customer-id");

    private final Handler handler;

    public ChargeCardWorker(Handler handler) {
        this.handler = handler;
    }

    @Override
    public void handle(JobClient client, ActivatedJob job) {
        try {
            ChargeCardOutput output = handler.handle(job.getVariablesAsType(ChargeCardInput.class), job);
            client.newCompleteCommand(job).variables(output).send().join();
        } catch (Exception e) {
            BpmnErrors.report(client, job, e);
        }
    }
}
