// @generated by bpmnkit <version> — sha256:b180e679db1466265059d93bca585400a6faf03dc97c84b607c53a64d3ffcafe — DO NOT EDIT
use bpmnkit_worker::Runtime;
pub mod errors;
pub mod reserve_stock;
/// Registers one worker per job type, each with its handler from `crate::handlers`.
pub fn register(runtime: Runtime) -> Runtime {
    runtime
        .register(
            reserve_stock::config(),
            reserve_stock::Adapter(crate::handlers::reserve_stock::Handler),
        )
}
