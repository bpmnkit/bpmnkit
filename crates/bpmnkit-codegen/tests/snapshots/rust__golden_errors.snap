===== src/handlers/reserve_stock.rs [Once] =====
use bpmnkit_worker::{ActivatedJob, JobError};

use crate::gen::reserve_stock::{ReserveStockHandler, ReserveStockInput, ReserveStockOutput};

pub struct Handler;

impl ReserveStockHandler for Handler {
    async fn handle(
        &self,
        _input: ReserveStockInput,
        _job: &ActivatedJob,
    ) -> Result<ReserveStockOutput, JobError> {
        // Return `Err(JobError::bpmn(code, message))` for a BPMN error (see `gen::errors`);
        // any other error fails the job with retries - 1.
        Err(JobError::fail("job type reserve-stock: handler not implemented"))
    }
}
