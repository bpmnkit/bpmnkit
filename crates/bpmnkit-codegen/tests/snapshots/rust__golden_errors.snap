// @generated by bpmnkit <version> — sha256:b180e679db1466265059d93bca585400a6faf03dc97c84b607c53a64d3ffcafe — DO NOT EDIT
use bpmnkit_worker::JobError;
pub const OUT_OF_STOCK: &str = "OUT_OF_STOCK";
pub const TYPE: &str = "type";
pub fn out_of_stock(message: impl Into<String>) -> JobError {
    JobError::bpmn(OUT_OF_STOCK, message)
}
pub fn type_(message: impl Into<String>) -> JobError {
    JobError::bpmn(TYPE, message)
}
