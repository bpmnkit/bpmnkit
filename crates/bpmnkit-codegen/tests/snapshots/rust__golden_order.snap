===== src/gen/mod.rs [Generated] =====
// @generated by bpmnkit <version> — sha256:18a73a4fdf92b4406dada6f620fbaaf20c100d7caf4e948a65f1ba489f1332d0 — DO NOT EDIT
use bpmnkit_worker::Runtime;
pub mod errors;
pub mod charge_card;
pub mod ship_order;
/// Registers one worker per job type, each with its handler from `crate::handlers`.
pub fn register(runtime: Runtime) -> Runtime {
    runtime
        .register(
            charge_card::config(),
            charge_card::Adapter(crate::handlers::charge_card::Handler),
        )
        .register(
            ship_order::config(),
            ship_order::Adapter(crate::handlers::ship_order::Handler),
        )
}
