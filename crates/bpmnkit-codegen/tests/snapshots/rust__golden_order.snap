===== src/handlers/charge_card.rs [Once] =====
use bpmnkit_worker::{ActivatedJob, JobError};

use crate::gen::charge_card::{ChargeCardHandler, ChargeCardInput, ChargeCardOutput};

pub struct Handler;

impl ChargeCardHandler for Handler {
    async fn handle(
        &self,
        _input: ChargeCardInput,
        _job: &ActivatedJob,
    ) -> Result<ChargeCardOutput, JobError> {
        // Return `Err(JobError::bpmn(code, message))` for a BPMN error (see `gen::errors`);
        // any other error fails the job with retries - 1.
        Err(JobError::fail("job type charge-card: handler not implemented"))
    }
}
