===== src/main.rs [Once] =====
use bpmnkit_worker::Runtime;
use demo_workers::gen;

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    // CAMUNDA_REST_ADDRESS, CAMUNDA_CLIENT_ID, CAMUNDA_CLIENT_SECRET, CAMUNDA_OAUTH_URL, ...
    let reports = gen::register(Runtime::from_env()?).run().await;
    for report in reports {
        eprintln!("{report:?}");
    }
    Ok(())
}
===== tests/agent_loop.rs [Once] =====
use bpmnkit_worker::testing::{run_handler, MockJob};
use demo_workers::gen::agent_loop::{Adapter, JOB_TYPE};
use demo_workers::handlers::agent_loop::Handler;

#[tokio::test]
#[ignore = "implement the handler, then assert on the command"]
async fn agent_loop_completes() {
    let job = MockJob::new(JOB_TYPE).build();
    let command = run_handler(&Adapter(Handler), job).await;
    assert!(matches!(command, bpmnkit_worker::Command::Complete(_)), "{command:?}");
}
