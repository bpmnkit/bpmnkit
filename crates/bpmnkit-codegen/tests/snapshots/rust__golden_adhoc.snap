// @generated by bpmnkit <version> — sha256:db88f295d58bfdcfa40c5a5e08246be515faf3841ef75be8dfa6ef0562de3679 — DO NOT EDIT
use bpmnkit_worker::Runtime;
pub mod errors;
pub mod agent_loop;
/// Registers one worker per job type, each with its handler from `crate::handlers`.
pub fn register(runtime: Runtime) -> Runtime {
    runtime
        .register(
            agent_loop::config(),
            agent_loop::Adapter(crate::handlers::agent_loop::Handler),
        )
}
===== src/handlers/agent_loop.rs [Once] =====
use bpmnkit_worker::{ActivatedJob, JobError};

use crate::gen::agent_loop::{AgentLoopHandler, AgentLoopInput, AgentLoopOutput};

// Ad-hoc sub-process job: complete with `Complete::output(..)?.result(JobResult::AdHocSubProcess { .. })`
// to activate elements.
pub struct Handler;

impl AgentLoopHandler for Handler {
    async fn handle(
        &self,
        _input: AgentLoopInput,
        _job: &ActivatedJob,
    ) -> Result<AgentLoopOutput, JobError> {
        // Return `Err(JobError::bpmn(code, message))` for a BPMN error (see `gen::errors`);
        // any other error fails the job with retries - 1.
        Err(JobError::fail("job type agent-loop: handler not implemented"))
    }
}
