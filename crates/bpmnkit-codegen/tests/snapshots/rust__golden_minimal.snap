===== src/handlers/send_mail.rs [Once] =====
use bpmnkit_worker::{ActivatedJob, JobError};

use crate::gen::send_mail::{SendMailHandler, SendMailInput, SendMailOutput};

pub struct Handler;

impl SendMailHandler for Handler {
    async fn handle(
        &self,
        _input: SendMailInput,
        _job: &ActivatedJob,
    ) -> Result<SendMailOutput, JobError> {
        // Return `Err(JobError::bpmn(code, message))` for a BPMN error (see `gen::errors`);
        // any other error fails the job with retries - 1.
        Err(JobError::fail("job type send-mail: handler not implemented"))
    }
}
