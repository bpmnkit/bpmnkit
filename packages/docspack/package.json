{
	"name": "@bpmnkit/docspack",
	"version": "1.3.1",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"bin": {
		"bpmnkit-docs": "./bin/bpmnkit-docs.mjs"
	},
	"files": ["bin", "LICENSE", "README.md", "llms.txt", ".llms", "dist/**/*.js", "dist/**/*.d.ts"],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc && node ./dist/cli.js build",
		"typecheck": "tsc --noEmit",
		"check": "biome check .",
		"test": "vitest run"
	},
	"docspack": {
		"source": "../../apps/landing/src/content/docs",
		"siteUrl": "https://bpmnkit.com/docs",
		"maxTokens": 800,
		"minTokens": 120,
		"startHere": {
			"intro": "Writing a BPMN process, DMN decision or form? Read its agent card first: a runnable script, the top options and the traps (`casen agent-card bpmn|dmn|form` prints the same card).",
			"docs": ["agent-cards/bpmn", "agent-cards/dmn", "agent-cards/form"]
		},
		"documents": [
			"@bpmnkit/core",
			"@bpmnkit/canvas",
			"@bpmnkit/editor",
			"@bpmnkit/engine",
			"@bpmnkit/feel",
			"@bpmnkit/plugins",
			"@bpmnkit/api",
			"@bpmnkit/ascii",
			"@bpmnkit/connector-gen",
			"@bpmnkit/connectors",
			"@bpmnkit/patterns",
			"@bpmnkit/worker-client",
			"@bpmnkit/cli"
		]
	},
	"description": "BPMN Kit documentation as an offline, version-locked docspack package with a built-in search CLI for AI agents",
	"keywords": ["docspack", "llms-txt", "ai-agents", "documentation", "search", "bpmn", "mcp"],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/bpmnkit/bpmnkit"
	},
	"homepage": "https://bpmnkit.com",
	"bugs": {
		"url": "https://github.com/bpmnkit/bpmnkit/issues"
	},
	"publishConfig": {
		"access": "public"
	}
}
