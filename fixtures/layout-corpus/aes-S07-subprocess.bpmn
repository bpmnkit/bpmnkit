<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs" targetNamespace="http://bpmn.io/schema/bpmn">
<process id="Process_1" isExecutable="true">
<startEvent id="start" name="Application received"><outgoing>fProcess_1_0</outgoing></startEvent>
<subProcess id="screen" name="Screen applicant"><incoming>fProcess_1_0</incoming><outgoing>fProcess_1_1</outgoing>
<startEvent id="sStart"><outgoing>fscreen_0</outgoing></startEvent>
<userTask id="cv" name="Review CV"><incoming>fscreen_0</incoming><outgoing>fscreen_1</outgoing></userTask>
<userTask id="call" name="Phone screen"><incoming>fscreen_1</incoming><outgoing>fscreen_2</outgoing></userTask>
<endEvent id="sEnd"><incoming>fscreen_2</incoming></endEvent>
<sequenceFlow id="fscreen_0" sourceRef="sStart" targetRef="cv"/>
<sequenceFlow id="fscreen_1" sourceRef="cv" targetRef="call"/>
<sequenceFlow id="fscreen_2" sourceRef="call" targetRef="sEnd"/>
</subProcess>
<exclusiveGateway id="decide" name="Hire?"><incoming>fProcess_1_1</incoming><outgoing>fProcess_1_2</outgoing><outgoing>fProcess_1_3</outgoing></exclusiveGateway>
<sendTask id="offer" name="Send offer"><incoming>fProcess_1_2</incoming><outgoing>fProcess_1_4</outgoing></sendTask>
<sendTask id="decline" name="Send rejection"><incoming>fProcess_1_3</incoming><outgoing>fProcess_1_5</outgoing></sendTask>
<endEvent id="endHired" name="Offer sent"><incoming>fProcess_1_4</incoming></endEvent>
<endEvent id="endRejected" name="Rejected"><incoming>fProcess_1_5</incoming></endEvent>
<sequenceFlow id="fProcess_1_0" sourceRef="start" targetRef="screen"/>
<sequenceFlow id="fProcess_1_1" sourceRef="screen" targetRef="decide"/>
<sequenceFlow id="fProcess_1_2" sourceRef="decide" targetRef="offer" name="yes"/>
<sequenceFlow id="fProcess_1_3" sourceRef="decide" targetRef="decline" name="no"/>
<sequenceFlow id="fProcess_1_4" sourceRef="offer" targetRef="endHired"/>
<sequenceFlow id="fProcess_1_5" sourceRef="decline" targetRef="endRejected"/>
</process>
</definitions>
