<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs" targetNamespace="http://bpmn.io/schema/bpmn">
<process id="Process_1" isExecutable="true">
<startEvent id="start" name="Claim submitted"><outgoing>fProcess_1_0</outgoing></startEvent>
<userTask id="assess" name="Assess claim"><incoming>fProcess_1_0</incoming><outgoing>fProcess_1_1</outgoing></userTask>
<exclusiveGateway id="gw" name="Claim amount?"><incoming>fProcess_1_1</incoming><outgoing>fProcess_1_2</outgoing><outgoing>fProcess_1_3</outgoing><outgoing>fProcess_1_4</outgoing></exclusiveGateway>
<serviceTask id="auto" name="Auto-approve"><incoming>fProcess_1_2</incoming><outgoing>fProcess_1_5</outgoing></serviceTask>
<userTask id="review" name="Manual review"><incoming>fProcess_1_3</incoming><outgoing>fProcess_1_6</outgoing></userTask>
<serviceTask id="reject" name="Reject claim"><incoming>fProcess_1_4</incoming><outgoing>fProcess_1_7</outgoing></serviceTask>
<exclusiveGateway id="join"><incoming>fProcess_1_5</incoming><incoming>fProcess_1_6</incoming><incoming>fProcess_1_7</incoming><outgoing>fProcess_1_8</outgoing></exclusiveGateway>
<serviceTask id="pay" name="Notify claimant"><incoming>fProcess_1_8</incoming><outgoing>fProcess_1_9</outgoing></serviceTask>
<endEvent id="end" name="Claim closed"><incoming>fProcess_1_9</incoming></endEvent>
<sequenceFlow id="fProcess_1_0" sourceRef="start" targetRef="assess"/>
<sequenceFlow id="fProcess_1_1" sourceRef="assess" targetRef="gw"/>
<sequenceFlow id="fProcess_1_2" sourceRef="gw" targetRef="auto" name="&lt; 1000"/>
<sequenceFlow id="fProcess_1_3" sourceRef="gw" targetRef="review" name=">= 1000"/>
<sequenceFlow id="fProcess_1_4" sourceRef="gw" targetRef="reject" name="invalid"/>
<sequenceFlow id="fProcess_1_5" sourceRef="auto" targetRef="join"/>
<sequenceFlow id="fProcess_1_6" sourceRef="review" targetRef="join"/>
<sequenceFlow id="fProcess_1_7" sourceRef="reject" targetRef="join"/>
<sequenceFlow id="fProcess_1_8" sourceRef="join" targetRef="pay"/>
<sequenceFlow id="fProcess_1_9" sourceRef="pay" targetRef="end"/>
</process>
</definitions>
