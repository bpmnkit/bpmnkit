<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="p" isExecutable="true" name="All the types">
    <bpmn:startEvent id="s" name="A start event with a very long name"><bpmn:outgoing>f0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="n0" name="task with quite a long name"><bpmn:incoming>f0</bpmn:incoming><bpmn:outgoing>f1</bpmn:outgoing></bpmn:task>
    <bpmn:serviceTask id="n1" name="serviceTask with quite a long name"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="n2" name="userTask with quite a long name"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="n3" name="scriptTask with quite a long name"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:sendTask id="n4" name="sendTask with quite a long name"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:sendTask>
    <bpmn:receiveTask id="n5" name="receiveTask with quite a long name"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:businessRuleTask id="n6" name="businessRuleTask with quite a long name"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:manualTask id="n7" name="manualTask with quite a long name"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:manualTask>
    <bpmn:callActivity id="n8" name="callActivity with quite a long name"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:callActivity>
    <bpmn:subProcess id="n9" name="subProcess with quite a long name"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:subProcess>
    <bpmn:transaction id="n10" name="transaction with quite a long name"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:transaction>
    <bpmn:intermediateThrowEvent id="n11" name="intermediateThrowEvent with quite a long name"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:intermediateThrowEvent>
    <bpmn:eventBasedGateway id="n12" name="eventBasedGateway with quite a long name"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="n13" name="intermediateCatchEvent with quite a long name"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e"><bpmn:incoming>f14</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f0" sourceRef="s" targetRef="n0" name="flow 0"/>
    <bpmn:sequenceFlow id="f1" sourceRef="n0" targetRef="n1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="n1" targetRef="n2"/>
    <bpmn:sequenceFlow id="f3" sourceRef="n2" targetRef="n3" name="flow 3"/>
    <bpmn:sequenceFlow id="f4" sourceRef="n3" targetRef="n4"/>
    <bpmn:sequenceFlow id="f5" sourceRef="n4" targetRef="n5"/>
    <bpmn:sequenceFlow id="f6" sourceRef="n5" targetRef="n6" name="flow 6"/>
    <bpmn:sequenceFlow id="f7" sourceRef="n6" targetRef="n7"/>
    <bpmn:sequenceFlow id="f8" sourceRef="n7" targetRef="n8"/>
    <bpmn:sequenceFlow id="f9" sourceRef="n8" targetRef="n9" name="flow 9"/>
    <bpmn:sequenceFlow id="f10" sourceRef="n9" targetRef="n10"/>
    <bpmn:sequenceFlow id="f11" sourceRef="n10" targetRef="n11"/>
    <bpmn:sequenceFlow id="f12" sourceRef="n11" targetRef="n12" name="flow 12"/>
    <bpmn:sequenceFlow id="f13" sourceRef="n12" targetRef="n13"/>
    <bpmn:sequenceFlow id="f14" sourceRef="n13" targetRef="e"/>
  </bpmn:process>
</bpmn:definitions>
