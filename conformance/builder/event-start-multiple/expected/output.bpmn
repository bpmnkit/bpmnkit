    <bpmn:sequenceFlow id="Flow_s1_t1" sourceRef="s1" targetRef="t1"/>
    <bpmn:sequenceFlow id="Flow_t1_e1" sourceRef="t1" targetRef="e1"/>
    <bpmn:sequenceFlow id="Flow_s2_t2" sourceRef="s2" targetRef="t2"/>
