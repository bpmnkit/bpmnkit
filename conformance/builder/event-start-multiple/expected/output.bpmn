      </bpmn:extensionElements>
      <bpmn:incoming>Flow_s1_t1</bpmn:incoming>
      <bpmn:outgoing>Flow_t1_e1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e1">
      <bpmn:incoming>Flow_t1_e1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="s2">
      <bpmn:outgoing>Flow_s2_t2</bpmn:outgoing>
