{
	"kind": "bpmn",
	"script": [
		["createProcess","p"],
		["startEvent","s"],
		["serviceTask","work",{"name":"work","taskType":"work"}],
		["exclusiveGateway","g",{"name":"Retry?"}],
		["branch","again",{"$ops":[["condition","=retry"],["serviceTask","fix",{"name":"fix","taskType":"fix"}],["connectTo","work"]]}],
		["branch","done",{"$ops":[["defaultFlow"],["endEvent","e"]]}],
		["build"]
	]
}
