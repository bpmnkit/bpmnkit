  <decision id="d" name="Discount">
    <decisionTable id="DecisionTable_0000001" hitPolicy="COLLECT">
      <input id="Input_0000002">
        <inputExpression id="InputExpression_0000003">
          <text>tier</text>
        </inputExpression>
      </input>
      <output id="Output_0000004" name="discount" typeRef="number"/>
      <output id="Output_0000005" name="reason"/>
      <rule id="DecisionRule_0000009">
        <inputEntry id="UnaryTests_0000006">
          <text>"gold"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0000007">
          <text>20</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_0000008">
          <text>"loyal"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_000000d">
        <inputEntry id="UnaryTests_000000a">
          <text>"silver"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_000000b">
          <text>10</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_000000c">
          <text>"ok"</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_000000h">
        <inputEntry id="UnaryTests_000000e">
          <text>-</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_000000f">
          <text>0</text>
        </outputEntry>
        <outputEntry id="LiteralExpression_000000g">
          <text>"none"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram>
