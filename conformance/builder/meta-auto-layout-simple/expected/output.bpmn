        <zeebe:taskDefinition type="b"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_a_b</bpmn:incoming>
      <bpmn:outgoing>Flow_b_e</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e">
      <bpmn:incoming>Flow_b_e</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_s_a" sourceRef="s" targetRef="a"/>
    <bpmn:sequenceFlow id="Flow_a_b" sourceRef="a" targetRef="b"/>
    <bpmn:sequenceFlow id="Flow_b_e" sourceRef="b" targetRef="e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="p_di">
    <bpmndi:BPMNPlane id="p_di_plane" bpmnElement="p">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="20" y="42" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_di" bpmnElement="a">
        <dc:Bounds x="116" y="20" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="b_di" bpmnElement="b">
        <dc:Bounds x="276" y="20" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
        <dc:Bounds x="436" y="42" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_s_a_di" bpmnElement="Flow_s_a">
        <di:waypoint x="56" y="60"/>
        <di:waypoint x="116" y="60"/>
