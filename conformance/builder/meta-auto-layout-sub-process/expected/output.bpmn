      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_is_a" sourceRef="is" targetRef="a"/>
      <bpmn:sequenceFlow id="Flow_a_ie" sourceRef="a" targetRef="ie"/>
    </bpmn:subProcess>
    <bpmn:endEvent id="e">
