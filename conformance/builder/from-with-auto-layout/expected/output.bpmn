<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0">
  <bpmn:process id="proc" isExecutable="true">
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="validate" name="Validate">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw" name="OK?">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end">
      <bpmn:incoming>f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="open" name="Open end">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>Flow_open_n</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n" name="n">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="n"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_open_n</bpmn:incoming>
      <bpmn:outgoing>Flow_n_z</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="z">
      <bpmn:incoming>Flow_n_z</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="validate"/>
    <bpmn:sequenceFlow id="f2" sourceRef="validate" targetRef="gw"/>
    <bpmn:sequenceFlow id="f3" sourceRef="gw" targetRef="end"/>
    <bpmn:sequenceFlow id="f4" sourceRef="gw" targetRef="open"/>
    <bpmn:sequenceFlow id="Flow_open_n" sourceRef="open" targetRef="n"/>
    <bpmn:sequenceFlow id="Flow_n_z" sourceRef="n" targetRef="z"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="proc">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="22" y="45" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="20" y="85" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="validate_di" bpmnElement="validate">
        <dc:Bounds x="118" y="23" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_di" bpmnElement="gw" isMarkerVisible="true">
        <dc:Bounds x="278" y="38" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="283" y="20" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="420" y="45" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="open_di" bpmnElement="open">
        <dc:Bounds x="388" y="141" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_di" bpmnElement="n">
        <dc:Bounds x="548" y="141" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="z_di" bpmnElement="z">
        <dc:Bounds x="708" y="163" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="58" y="63"/>
        <di:waypoint x="118" y="63"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="218" y="63"/>
        <di:waypoint x="278" y="63"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="328" y="63"/>
        <di:waypoint x="420" y="63"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="303" y="88"/>
        <di:waypoint x="303" y="181"/>
        <di:waypoint x="388" y="181"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_open_n_di" bpmnElement="Flow_open_n">
        <di:waypoint x="488" y="181"/>
        <di:waypoint x="548" y="181"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_n_z_di" bpmnElement="Flow_n_z">
        <di:waypoint x="648" y="181"/>
        <di:waypoint x="708" y="181"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

