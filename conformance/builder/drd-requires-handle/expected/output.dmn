    </informationRequirement>
    <decisionTable id="DecisionTable_0000009">
      <input id="Input_000000a">
        <inputExpression id="InputExpression_000000b">
          <text>risk</text>
        </inputExpression>
      </input>
      <output id="Output_000000c" name="approvalOut"/>
      <rule id="DecisionRule_000000f">
        <inputEntry id="UnaryTests_000000d">
