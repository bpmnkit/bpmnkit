        </inputEntry>
        <outputEntry id="LiteralExpression_000000e">
          <text>"v"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram>
      <dmndi:DMNShape dmnElementRef="riskScore">
        <dc:Bounds height="80" width="180" x="160" y="100"/>
