      <input id="Input_0000002">
        <inputExpression id="InputExpression_0000003">
          <text>age</text>
        </inputExpression>
      </input>
      <output id="Output_0000004" name="riskScoreOut"/>
      <rule id="DecisionRule_0000007">
        <inputEntry id="UnaryTests_0000005">
          <text>1</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_0000006">
          <text>"v"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="approval" name="APPROVAL">
