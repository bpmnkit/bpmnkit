  <bpmn:process id="proc" isExecutable="true">
    <bpmn:startEvent id="start" name="S" ><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent><bpmn:adHocSubProcess id="agent" name="Agent"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1" /><zeebe:adHoc outputCollection="toolCallResults" outputElement="=x" /><zeebe:ioMapping><zeebe:input source="=3" target="data.limits.maxModelCalls" /></zeebe:ioMapping></bpmn:extensionElements><bpmn:serviceTask id="t1" name="t1"><bpmn:documentation>Does a thing</bpmn:documentation><bpmn:extensionElements><zeebe:taskDefinition type="t" /><zeebe:ioMapping><zeebe:input source="=fromAi(toolCall.q, &quot;d&quot;, &quot;string&quot;)" target="q" /></zeebe:ioMapping></bpmn:extensionElements></bpmn:serviceTask></bpmn:adHocSubProcess><bpmn:endEvent id="end" name="E" ><bpmn:incoming>f2</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="agent" /><bpmn:sequenceFlow id="f2" sourceRef="agent" targetRef="end" />
