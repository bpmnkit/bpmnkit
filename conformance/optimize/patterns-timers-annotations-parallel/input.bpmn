<bpmn:boundaryEvent id="b2" attachedToRef="t0"><bpmn:timerEventDefinition id="b2d"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="b3" attachedToRef="u"><bpmn:timerEventDefinition id="b3d"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">0</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
