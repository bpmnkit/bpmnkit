<bpmn:boundaryEvent id="b5" attachedToRef="u"><bpmn:timerEventDefinition id="b5d"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression"> PT0M </bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="b6" attachedToRef="u"><bpmn:timerEventDefinition id="b6d"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT0H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
<bpmn:endEvent id="end" name="E" ><bpmn:incoming>f11</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="end2" name="E2" ><bpmn:incoming>h0</bpmn:incoming></bpmn:endEvent>
<bpmn:textAnnotation id="ta1"><bpmn:text>   </bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="ta2" /><bpmn:textAnnotation id="ta3"><bpmn:text>real note</bpmn:text></bpmn:textAnnotation>
<bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="single" /><bpmn:sequenceFlow id="f2" sourceRef="single" targetRef="fork" /><bpmn:sequenceFlow id="f3" sourceRef="fork" targetRef="w1" /><bpmn:sequenceFlow id="f4" sourceRef="fork" targetRef="w2" /><bpmn:sequenceFlow id="f5" sourceRef="fork" targetRef="w3" /><bpmn:sequenceFlow id="f6" sourceRef="w1" targetRef="join" /><bpmn:sequenceFlow id="f7" sourceRef="w2" targetRef="join" /><bpmn:sequenceFlow id="f8" sourceRef="w3" targetRef="join" /><bpmn:sequenceFlow id="f9" sourceRef="join" targetRef="t0" /><bpmn:sequenceFlow id="f10" sourceRef="t0" targetRef="u" /><bpmn:sequenceFlow id="f11" sourceRef="u" targetRef="end" /><bpmn:sequenceFlow id="h0" sourceRef="b0" targetRef="end2" />
