<bpmn:parallelGateway id="join" name="Join" ><bpmn:incoming>f6</bpmn:incoming><bpmn:incoming>f7</bpmn:incoming><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:parallelGateway><bpmn:userTask id="u" name="Review" ><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:userTask><bpmn:task id="t0" name="Waits" ><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:task>
<bpmn:boundaryEvent id="b0" attachedToRef="t0"><bpmn:outgoing>h0</bpmn:outgoing><bpmn:timerEventDefinition id="b0d"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT0S</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
