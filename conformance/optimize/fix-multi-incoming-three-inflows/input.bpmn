  xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  
  
  <bpmn:process id="proc" isExecutable="true">
    <bpmn:startEvent id="start" ><bpmn:outgoing>f1</bpmn:outgoing><bpmn:outgoing>f6</bpmn:outgoing></bpmn:startEvent><bpmn:exclusiveGateway id="x" default="f3" name="X?" ><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing><bpmn:outgoing>f3</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="a" name="A" ><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing></bpmn:task><bpmn:task id="b" name="B" ><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:task><bpmn:endEvent id="end" name="E" ><bpmn:incoming>f4</bpmn:incoming><bpmn:incoming>f5</bpmn:incoming><bpmn:incoming>f6</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="x" /><bpmn:sequenceFlow id="f2" sourceRef="x" targetRef="a"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= ok</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f3" sourceRef="x" targetRef="b" /><bpmn:sequenceFlow id="f4" sourceRef="a" targetRef="end" /><bpmn:sequenceFlow id="f5" sourceRef="b" targetRef="end" /><bpmn:sequenceFlow id="f6" sourceRef="start" targetRef="end" />
  </bpmn:process>
  
