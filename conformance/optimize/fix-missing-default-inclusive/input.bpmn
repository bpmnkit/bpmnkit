  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  
  
  <bpmn:process id="proc" isExecutable="true">
    <bpmn:startEvent id="start" name="S" /><bpmn:inclusiveGateway id="gw" name="Which?" /><bpmn:task id="a" name="A" /><bpmn:task id="b" name="B" /><bpmn:task id="c" name="C" /><bpmn:endEvent id="end" name="E" /><bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="gw" /><bpmn:sequenceFlow id="f2" sourceRef="gw" targetRef="a"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= x = 1</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f3" sourceRef="gw" targetRef="b"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= x = 2</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f4" sourceRef="gw" targetRef="c"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= x = 3</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="f5" sourceRef="a" targetRef="end" /><bpmn:sequenceFlow id="f6" sourceRef="b" targetRef="end" /><bpmn:sequenceFlow id="f7" sourceRef="c" targetRef="end" />
  </bpmn:process>
  
</bpmn:definitions>
