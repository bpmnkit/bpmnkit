  xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  
  
  <bpmn:process id="proc" isExecutable="true">
    <bpmn:startEvent id="start" name="S" /><bpmn:exclusiveGateway id="j" name="Merge" /><bpmn:task id="a" name="A" /><bpmn:endEvent id="end" name="E" /><bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="j" /><bpmn:sequenceFlow id="f0" sourceRef="a" targetRef="j" /><bpmn:sequenceFlow id="f2" sourceRef="j" targetRef="end" />
