  xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.6.0">
  
  
  <bpmn:process id="proc" isExecutable="true">
    <bpmn:startEvent id="start" name="S" /><bpmn:serviceTask id="c1" name="c1" zeebe:modelerTemplate="tpl.http"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:x:1" /><zeebe:ioMapping><zeebe:input source="=a" target="url" /><zeebe:output source="=r" target="result" /></zeebe:ioMapping></bpmn:extensionElements></bpmn:serviceTask><bpmn:serviceTask id="c2" name="c2" zeebe:modelerTemplate="tpl.http"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:x:1" /><zeebe:ioMapping><zeebe:input source="=a" target="url" /><zeebe:input source="=m" target="method" /></zeebe:ioMapping><zeebe:taskHeaders><zeebe:header key="resultVariable" value="v" /></zeebe:taskHeaders></bpmn:extensionElements></bpmn:serviceTask><bpmn:serviceTask id="c3" name="c3" zeebe:modelerTemplate="tpl.other"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:x:1" /><zeebe:properties><zeebe:property name="prop" value="v" /></zeebe:properties></bpmn:extensionElements></bpmn:serviceTask><bpmn:serviceTask id="c4" name="c4" zeebe:modelerTemplate="tpl.unknown"><bpmn:extensionElements><zeebe:taskDefinition type="io.camunda:x:1" /></bpmn:extensionElements></bpmn:serviceTask><bpmn:serviceTask id="plain" name="Plain"><bpmn:extensionElements><zeebe:taskDefinition type="x" /></bpmn:extensionElements></bpmn:serviceTask><bpmn:endEvent id="end" name="E" /><bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="c1" /><bpmn:sequenceFlow id="f2" sourceRef="c1" targetRef="c2" /><bpmn:sequenceFlow id="f3" sourceRef="c2" targetRef="c3" /><bpmn:sequenceFlow id="f4" sourceRef="c3" targetRef="c4" /><bpmn:sequenceFlow id="f5" sourceRef="c4" targetRef="plain" /><bpmn:sequenceFlow id="f6" sourceRef="plain" targetRef="end" />
  </bpmn:process>
  
