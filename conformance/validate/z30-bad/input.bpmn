<bpmn:startEvent id="s2"><bpmn:outgoing>f2</bpmn:outgoing><bpmn:conditionalEventDefinition id="c2"><bpmn:condition xsi:type="bpmn:tFormalExpression">=x &gt; 1</bpmn:condition></bpmn:conditionalEventDefinition></bpmn:startEvent>
<bpmn:sequenceFlow id="f2" sourceRef="s2" targetRef="t"/>
</bpmn:process>
