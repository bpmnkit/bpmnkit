<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://example.com" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:escalation id="X" name="esc" escalationCode="=code" />
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="Start"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:subProcess id="Task"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing>
    <bpmn:startEvent id="SS"><bpmn:outgoing>H1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:endEvent id="SE"><bpmn:incoming>H1</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="H1" sourceRef="SS" targetRef="SE" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End"><bpmn:incoming>F2</bpmn:incoming></bpmn:endEvent>
    <bpmn:boundaryEvent id="B" attachedToRef="Task"><bpmn:outgoing>F3</bpmn:outgoing><bpmn:escalationEventDefinition id="ED" escalationRef="X" /></bpmn:boundaryEvent>
    <bpmn:endEvent id="End2"><bpmn:incoming>F3</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F3" sourceRef="B" targetRef="End2" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task" targetRef="End" />
  </bpmn:process>
