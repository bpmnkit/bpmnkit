        <dc:Bounds x="416" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d_di" bpmnElement="d">
        <dc:Bounds x="576" y="22" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="574" y="62" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
