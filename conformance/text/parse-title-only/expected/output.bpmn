<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Only_a_title" name="Only a title" isExecutable="true">
    <bpmn:startEvent id="start" name="Process started">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="start_end" name="Process started">
      <bpmn:incoming>Flow_1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="start_end"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Only_a_title">
    <bpmndi:BPMNPlane id="BPMNPlane_Only_a_title" bpmnElement="Only_a_title">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="0" y="0" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-34.5" y="40" width="105" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_end_di" bpmnElement="start_end">
        <dc:Bounds x="123" y="0" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="88.5" y="40" width="105" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="36" y="18"/>
        <di:waypoint x="123" y="18"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

