<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="s" name="Order placed">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="wait" name="Payment confirmed">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="wait_MessageEventDefinition"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="ship" name="Ship order">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e" name="Shipped">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="cancel" name="Order cancelled" attachedToRef="ship" cancelActivity="true">
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="cancel_MessageEventDefinition"/>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="c" name="Cancelled">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="wait"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="wait" targetRef="ship"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="ship" targetRef="e"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="cancel" targetRef="c"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_1">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="0" y="22" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-24" y="62" width="84" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait_di" bpmnElement="wait">
        <dc:Bounds x="119.5" y="22" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="78" y="62" width="119" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ship_di" bpmnElement="ship">
        <dc:Bounds x="215.5" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
        <dc:Bounds x="375.5" y="22" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="369" y="62" width="49" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cancel_di" bpmnElement="cancel">
        <dc:Bounds x="247.5" y="62" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="156.5" y="102" width="105" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_di" bpmnElement="c">
        <dc:Bounds x="375.5" y="158" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="362" y="198" width="63" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="36" y="40"/>
        <di:waypoint x="119.5" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="155.5" y="40"/>
        <di:waypoint x="215.5" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="315.5" y="40"/>
        <di:waypoint x="375.5" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="265.5" y="98"/>
        <di:waypoint x="265.5" y="176"/>
        <di:waypoint x="375.5" y="176"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

