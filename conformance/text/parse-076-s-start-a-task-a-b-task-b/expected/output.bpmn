      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="a_join"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="a_split" targetRef="b"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="a_split" targetRef="c"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="b" targetRef="m_join"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="c" targetRef="m_join"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="m" targetRef="d" name="ok">
      <bpmn:conditionExpression>= merge = "ok"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="m" targetRef="a_join"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="d" targetRef="d_end"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="a" targetRef="a_split"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="a_join" targetRef="a"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="m_join" targetRef="m"/>
  </bpmn:process>
