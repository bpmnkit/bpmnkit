        <di:waypoint x="338" y="320"/>
        <di:waypoint x="338" y="180"/>
        <di:waypoint x="368" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="121" y="155"/>
        <di:waypoint x="121" y="40"/>
        <di:waypoint x="208" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="258" y="80"/>
        <di:waypoint x="258" y="110"/>
        <di:waypoint x="393" y="110"/>
        <di:waypoint x="393" y="155"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
