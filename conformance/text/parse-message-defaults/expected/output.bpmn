        <bpmndi:BPMNLabel>
          <dc:Bounds x="690.5" y="62" width="63" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="x_di" bpmnElement="x">
