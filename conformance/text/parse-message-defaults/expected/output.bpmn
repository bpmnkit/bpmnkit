        <bpmndi:BPMNLabel>
          <dc:Bounds x="-2" y="200" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="y_di" bpmnElement="y">
