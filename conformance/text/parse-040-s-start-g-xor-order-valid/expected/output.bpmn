        <bpmndi:BPMNLabel>
          <dc:Bounds x="350" y="302" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s3_di" bpmnElement="s3">
        <dc:Bounds x="0" y="532" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-2" y="572" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p_di" bpmnElement="p">
        <dc:Bounds x="96" y="525" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="x_di" bpmnElement="x">
        <dc:Bounds x="320" y="510" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
        <dc:Bounds x="590" y="532" width="36" height="36"/>
