<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="s" name="S">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="g" name="Order valid?" default="Flow_3">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="a" name="Accepted">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="b" name="Refused">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="s2" name="S2">
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s2_MessageEventDefinition"/>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="h" name="Size?" default="Flow_6">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="c" name="Big">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="d" name="Small">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="s3" name="S3">
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:timerEventDefinition id="s3_TimerEventDefinition"/>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="p">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="x" name="X">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e" name="Done">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="y" name="Y">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="e_join">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="g"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="g" targetRef="a" name="Yes: order is valid">
      <bpmn:conditionExpression>= orderValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="g" targetRef="b" name="No: order is not valid"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="s2" targetRef="h"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="h" targetRef="c" name="Big">
      <bpmn:conditionExpression>= size &gt; 10</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="h" targetRef="d" name="Small"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="s3" targetRef="p"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="p" targetRef="x"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="x" targetRef="e_join"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="p" targetRef="y"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="y" targetRef="e_join"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="e_join" targetRef="e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_1">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
