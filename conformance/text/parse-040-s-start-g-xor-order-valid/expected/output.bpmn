        <bpmndi:BPMNLabel>
          <dc:Bounds x="350" y="416" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d_di" bpmnElement="d">
