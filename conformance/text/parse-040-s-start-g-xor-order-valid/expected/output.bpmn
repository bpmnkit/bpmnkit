        <bpmndi:BPMNLabel>
          <dc:Bounds x="-2" y="302" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_di" bpmnElement="h" isMarkerVisible="true">
        <dc:Bounds x="96" y="255" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="101" y="237" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c_di" bpmnElement="c">
