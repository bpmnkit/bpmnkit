          <dc:Bounds x="249.5" y="312" width="49" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="late_di" bpmnElement="late">
        <dc:Bounds x="128" y="96" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="102" y="78" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="l_di" bpmnElement="l">
