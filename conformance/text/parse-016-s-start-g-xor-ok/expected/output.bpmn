    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="a_join">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="again_join">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="g"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="g" targetRef="a_join" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= ok</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="a" targetRef="again_join"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="g" targetRef="b" name="No"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="b" targetRef="again_join"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="again" targetRef="a_join" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= retry</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="again" targetRef="e" name="No"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="a_join" targetRef="a"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="again_join" targetRef="again"/>
  </bpmn:process>
