<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="s" name="S">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="review" name="Review claim">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="pay" name="Pay">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e" name="Paid">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e2" name="Rejected">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="s2" name="Update">
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="s2_MessageEventDefinition"/>
    </bpmn:startEvent>
    <bpmn:task id="both" name="Record update">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a" name="A">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e3" name="Done">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="b" name="B">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="review_split" name="Review claim outcome?" default="Flow_4">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="both_split">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="e3_join">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="review"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="review_split" targetRef="pay" name="Approved">
      <bpmn:conditionExpression>= reviewClaimOutcome = "Approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="pay" targetRef="e"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="review_split" targetRef="e2" name="Rejected"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="s2" targetRef="both"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="both_split" targetRef="a"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="a" targetRef="e3_join"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="both_split" targetRef="b"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="b" targetRef="e3_join"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="review" targetRef="review_split"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="both" targetRef="both_split"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="e3_join" targetRef="e3"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_1">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="0" y="22" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-2" y="62" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="review_di" bpmnElement="review">
        <dc:Bounds x="96" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pay_di" bpmnElement="pay">
        <dc:Bounds x="388.5" y="136" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
        <dc:Bounds x="555.5" y="158" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="553.5" y="198" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e2_di" bpmnElement="e2">
        <dc:Bounds x="420.5" y="22" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="410.5" y="62" width="56" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_di" bpmnElement="s2">
        <dc:Bounds x="0" y="318" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-3" y="358" width="42" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="both_di" bpmnElement="both">
        <dc:Bounds x="96" y="296" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_di" bpmnElement="a">
        <dc:Bounds x="388.5" y="296" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e3_di" bpmnElement="e3">
        <dc:Bounds x="658.5" y="318" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="656.5" y="358" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="b_di" bpmnElement="b">
        <dc:Bounds x="388.5" y="436" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="review_split_di" bpmnElement="review_split" isMarkerVisible="true">
        <dc:Bounds x="262.5" y="15" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="214" y="-3" width="147" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="both_split_di" bpmnElement="both_split">
        <dc:Bounds x="262.5" y="311" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e3_join_di" bpmnElement="e3_join">
        <dc:Bounds x="548.5" y="311" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="36" y="40"/>
        <di:waypoint x="96" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="287.5" y="65"/>
        <di:waypoint x="287.5" y="176"/>
        <di:waypoint x="388.5" y="176"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="488.5" y="176"/>
        <di:waypoint x="555.5" y="176"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="312.5" y="40"/>
        <di:waypoint x="420.5" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="36" y="336"/>
        <di:waypoint x="96" y="336"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="312.5" y="336"/>
        <di:waypoint x="388.5" y="336"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="488.5" y="336"/>
        <di:waypoint x="548.5" y="336"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="287.5" y="361"/>
        <di:waypoint x="287.5" y="476"/>
        <di:waypoint x="388.5" y="476"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="438.5" y="436"/>
        <di:waypoint x="438.5" y="406"/>
        <di:waypoint x="573.5" y="406"/>
        <di:waypoint x="573.5" y="361"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
