<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="start" name="Poll started">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="poll" name="Poll external system">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="poll"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="timeout" name="0:PT5M">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="timeout_TimerEventDefinition">
        <bpmn:timeDuration>PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="fail" name="Poll failed">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="get" name="Report from external system">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="get_MessageEventDefinition"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="done" name="Poll successful">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:eventBasedGateway id="poll_split">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start" targetRef="poll"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="poll_split" targetRef="timeout"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="timeout" targetRef="fail"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="poll_split" targetRef="get"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="get" targetRef="done"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="poll" targetRef="poll_split"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_1">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="0" y="22" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-24" y="62" width="84" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="poll_di" bpmnElement="poll">
        <dc:Bounds x="96" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="timeout_di" bpmnElement="timeout">
        <dc:Bounds x="400.5" y="22" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="397.5" y="62" width="42" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fail_di" bpmnElement="fail">
        <dc:Bounds x="565.5" y="22" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="545" y="62" width="77" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="get_di" bpmnElement="get">
        <dc:Bounds x="400.5" y="136" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="324" y="176" width="189" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="done_di" bpmnElement="done">
        <dc:Bounds x="565.5" y="136" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="531" y="176" width="105" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="poll_split_di" bpmnElement="poll_split">
        <dc:Bounds x="256" y="15" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="36" y="40"/>
        <di:waypoint x="96" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="306" y="40"/>
        <di:waypoint x="400.5" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="436.5" y="40"/>
        <di:waypoint x="565.5" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="281" y="65"/>
        <di:waypoint x="281" y="154"/>
        <di:waypoint x="400.5" y="154"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="436.5" y="154"/>
        <di:waypoint x="565.5" y="154"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="196" y="40"/>
        <di:waypoint x="256" y="40"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

