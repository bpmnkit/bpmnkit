        <bpmn:condition xsi:type="bpmn:tFormalExpression">= a &gt; 1</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="x5" name="X5">
      <bpmn:incoming>Flow_7</bpmn:incoming>
