        <bpmndi:BPMNLabel>
          <dc:Bounds x="506" y="62" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_di" bpmnElement="s2">
        <dc:Bounds x="0" y="307" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-2" y="347" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_di" bpmnElement="g" isMarkerVisible="true">
        <dc:Bounds x="96" y="300" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="101" y="282" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="big_di" bpmnElement="big">
        <dc:Bounds x="380" y="421" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="378" y="461" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="small_di" bpmnElement="small">
        <dc:Bounds x="380" y="307" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="378" y="347" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="36" y="40"/>
        <di:waypoint x="96" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="121" y="65"/>
        <di:waypoint x="121" y="180"/>
        <di:waypoint x="348" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="448" y="180"/>
        <di:waypoint x="508" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="146" y="40"/>
        <di:waypoint x="348" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="448" y="40"/>
        <di:waypoint x="508" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="36" y="325"/>
        <di:waypoint x="96" y="325"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="121" y="350"/>
        <di:waypoint x="121" y="439"/>
        <di:waypoint x="380" y="439"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
