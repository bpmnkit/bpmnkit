<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="s" name="S">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="t" name="Work">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="e" name="E">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="w" name="Late" attachedToRef="t" cancelActivity="true">
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:timerEventDefinition id="w_TimerEventDefinition">
        <bpmn:timeDuration>PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:task id="h" name="Handle">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="x" name="X">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="t_split">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="h_join">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="t"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="t_split" targetRef="e"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="t_split" targetRef="h_join"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="w" targetRef="h_join"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="h" targetRef="x"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="t" targetRef="t_split"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="h_join" targetRef="h"/>
    <bpmn:textAnnotation id="TextAnnotation_h_1">
      <bpmn:text>runs once the timer fires</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_h_1" sourceRef="h" targetRef="TextAnnotation_h_1" associationDirection="None"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_1">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="0" y="22" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-2" y="62" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_di" bpmnElement="t">
        <dc:Bounds x="96" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
        <dc:Bounds x="373" y="22" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="371" y="62" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="w_di" bpmnElement="w">
        <dc:Bounds x="128" y="62" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="102" y="102" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_di" bpmnElement="h">
        <dc:Bounds x="476" y="136" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="x_di" bpmnElement="x">
        <dc:Bounds x="636" y="158" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="634" y="198" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_split_di" bpmnElement="t_split">
        <dc:Bounds x="256" y="15" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="h_join_di" bpmnElement="h_join" isMarkerVisible="true">
        <dc:Bounds x="366" y="151" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TextAnnotation_h_1_di" bpmnElement="TextAnnotation_h_1">
        <dc:Bounds x="426" y="266" width="200" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="36" y="40"/>
        <di:waypoint x="96" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="306" y="40"/>
        <di:waypoint x="373" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="281" y="65"/>
        <di:waypoint x="281" y="176"/>
        <di:waypoint x="366" y="176"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="146" y="98"/>
        <di:waypoint x="146" y="176"/>
        <di:waypoint x="366" y="176"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="576" y="176"/>
        <di:waypoint x="636" y="176"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="196" y="40"/>
        <di:waypoint x="256" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="416" y="176"/>
        <di:waypoint x="476" y="176"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_h_1_di" bpmnElement="Association_h_1">
        <di:waypoint x="526" y="216"/>
        <di:waypoint x="526" y="266"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

