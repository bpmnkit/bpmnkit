        <bpmndi:BPMNLabel>
          <dc:Bounds x="101" y="-3" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a_di" bpmnElement="a">
        <dc:Bounds x="206" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="j_di" bpmnElement="j">
