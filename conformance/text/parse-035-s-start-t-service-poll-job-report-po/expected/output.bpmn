<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="s" name="S">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="t" name="Poll">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="report.poll"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e" name="E">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="w" name="Late" attachedToRef="t" cancelActivity="false">
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="w_TimerEventDefinition"/>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="f" name="F">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="t"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="t" targetRef="e"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="w" targetRef="f"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_1">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="0" y="22" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-2" y="62" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_di" bpmnElement="t">
        <dc:Bounds x="96" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
        <dc:Bounds x="256" y="22" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="254" y="62" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="w_di" bpmnElement="w">
        <dc:Bounds x="128" y="62" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="102" y="102" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="f_di" bpmnElement="f">
        <dc:Bounds x="256" y="158" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="254" y="198" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="36" y="40"/>
        <di:waypoint x="96" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="196" y="40"/>
        <di:waypoint x="256" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="146" y="98"/>
        <di:waypoint x="146" y="176"/>
        <di:waypoint x="256" y="176"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

