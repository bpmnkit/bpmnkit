<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="Definitions_eligible" name="DRD" namespace="http://camunda.org/schema/1.0/dmn">
  <decision id="eligibility" name="Eligibility">
    <decisionTable id="dt1" hitPolicy="UNIQUE">
      <input id="i1" label="age">
        <inputExpression id="ie1">
          <text>age</text>
        </inputExpression>
      </input>
      <output id="o1" name="eligible" typeRef="boolean"/>
      <rule id="r1">
        <inputEntry id="ie1r1">
          <text>&gt;= 18</text>
        </inputEntry>
        <outputEntry id="oe1r1">
          <text>true</text>
        </outputEntry>
      </rule>
      <rule id="r2">
        <inputEntry id="ie1r2">
          <text>&lt; 18</text>
        </inputEntry>
        <outputEntry id="oe1r2">
          <text>false</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>

