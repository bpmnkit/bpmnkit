<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="Definitions_text" name="Fish &amp; &quot;Chips&quot; &lt;ok&gt;" namespace="urn:text">
  <!-- a comment that is dropped -->
  <decision id="d1" name="Tom &amp; Jerry's &#65;&#x42; &#xe9; &unknown; 100%">
    <decisionTable id="t1">
      <input id="i1" label="a &lt; b">
        <inputExpression id="ie1" typeRef="string"><text><![CDATA[a < b && c > "d"]]></text></inputExpression>
      </input>
      <output id="o1" name="result" label='single "quoted"'/>
      <rule id="r1">
        <description>Uses &lt;, &gt;, &amp; and a CDATA <![CDATA[<tag> & more]]> end</description>
        <inputEntry id="e1"><text>&lt;= 10 and &gt;= 2</text></inputEntry>
        <outputEntry id="p1"><text><![CDATA["x" + "<y>"]]></text></outputEntry>
      </rule>
      <rule id="r2">
        <inputEntry id="e2"><text>
          multi
          line   spaced
        </text></inputEntry>
        <outputEntry id="p2"><text>"tab&#9;newline&#10;done"</text></outputEntry>
      </rule>
      <rule id="r3">
        <inputEntry id="e3"><text>"日本語 ünïcode 😀"</text></inputEntry>
        <outputEntry id="p3"/>
      </rule>
    </decisionTable>
  </decision>
  <textAnnotation id="ta"><text>1 &lt; 2 &amp;&amp; 3 &gt; 2</text></textAnnotation>
</definitions>
