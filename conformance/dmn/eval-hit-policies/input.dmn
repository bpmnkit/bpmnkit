      </rule>
      <rule id="collect_avg_r3">
        <inputEntry id="collect_avg_r3_i0"><text>&gt; 8</text></inputEntry>
        <outputEntry id="collect_avg_r3_o0"><text>-3.5</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="collect_sum_multi" name="collect_sum_multi">
    <decisionTable id="collect_sum_multi_t" hitPolicy="COLLECT" aggregation="SUM">
      <input id="collect_sum_multi_i0" label="in0"><inputExpression id="collect_sum_multi_ie0" typeRef="number"><text>x</text></inputExpression></input>
      <output id="collect_sum_multi_o0" name="a" />
      <output id="collect_sum_multi_o1" name="b" />
      <rule id="collect_sum_multi_r0">
        <inputEntry id="collect_sum_multi_r0_i0"><text>-</text></inputEntry>
        <outputEntry id="collect_sum_multi_r0_o0"><text>1</text></outputEntry>
        <outputEntry id="collect_sum_multi_r0_o1"><text>100</text></outputEntry>
      </rule>
      <rule id="collect_sum_multi_r1">
        <inputEntry id="collect_sum_multi_r1_i0"><text>-</text></inputEntry>
        <outputEntry id="collect_sum_multi_r1_o0"><text>2</text></outputEntry>
        <outputEntry id="collect_sum_multi_r1_o1"><text>200</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="keys" name="keys">
    <decisionTable id="keys_t" hitPolicy="UNIQUE">
      <input id="keys_i0" label="in0"><inputExpression id="keys_ie0" typeRef="number"><text>x</text></inputExpression></input>
      <output id="keys_o0" name="named" />
      <output id="keys_o1" label="Labelled" />
      <output id="keys_o2" />
      <rule id="keys_r0">
        <inputEntry id="keys_r0_i0"><text>-</text></inputEntry>
        <outputEntry id="keys_r0_o0"><text>1</text></outputEntry>
        <outputEntry id="keys_r0_o1"><text>2</text></outputEntry>
        <outputEntry id="keys_r0_o2"><text>3</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="entries" name="entries">
    <decisionTable id="entries_t" hitPolicy="RULE ORDER">
      <input id="entries_i0" label="in0"><inputExpression id="entries_ie0" typeRef="number"><text>s</text></inputExpression></input>
      <input id="entries_i1" label="in1"><inputExpression id="entries_ie1" typeRef="number"><text>x</text></inputExpression></input>
      <input id="entries_i2" label="in2"><inputExpression id="entries_ie2" typeRef="number"><text>flag</text></inputExpression></input>
      <input id="entries_i3" label="in3"><inputExpression id="entries_ie3" typeRef="number"><text>d</text></inputExpression></input>
      <input id="entries_i4" label="in4"><inputExpression id="entries_ie4" typeRef="number"><text>items</text></inputExpression></input>
      <output id="entries_o0" name="rule" />
      <rule id="entries_r0">
        <inputEntry id="entries_r0_i0"><text>"a", "b"</text></inputEntry>
        <inputEntry id="entries_r0_i1"><text></text></inputEntry>
        <inputEntry id="entries_r0_i2"><text></text></inputEntry>
        <inputEntry id="entries_r0_i3"><text></text></inputEntry>
        <inputEntry id="entries_r0_i4"><text></text></inputEntry>
        <outputEntry id="entries_r0_o0"><text>"str-list"</text></outputEntry>
      </rule>
      <rule id="entries_r1">
        <inputEntry id="entries_r1_i0"><text>not("a")</text></inputEntry>
        <inputEntry id="entries_r1_i1"><text></text></inputEntry>
        <inputEntry id="entries_r1_i2"><text></text></inputEntry>
        <inputEntry id="entries_r1_i3"><text></text></inputEntry>
        <inputEntry id="entries_r1_i4"><text></text></inputEntry>
        <outputEntry id="entries_r1_o0"><text>"not-a"</text></outputEntry>
      </rule>
      <rule id="entries_r2">
        <inputEntry id="entries_r2_i0"><text></text></inputEntry>
        <inputEntry id="entries_r2_i1"><text>not([1..5])</text></inputEntry>
        <inputEntry id="entries_r2_i2"><text></text></inputEntry>
        <inputEntry id="entries_r2_i3"><text></text></inputEntry>
        <inputEntry id="entries_r2_i4"><text></text></inputEntry>
        <outputEntry id="entries_r2_o0"><text>"outside"</text></outputEntry>
      </rule>
      <rule id="entries_r3">
        <inputEntry id="entries_r3_i0"><text></text></inputEntry>
        <inputEntry id="entries_r3_i1"><text>&gt; limit</text></inputEntry>
        <inputEntry id="entries_r3_i2"><text></text></inputEntry>
        <inputEntry id="entries_r3_i3"><text></text></inputEntry>
        <inputEntry id="entries_r3_i4"><text></text></inputEntry>
        <outputEntry id="entries_r3_o0"><text>"over-limit"</text></outputEntry>
      </rule>
      <rule id="entries_r4">
        <inputEntry id="entries_r4_i0"><text></text></inputEntry>
        <inputEntry id="entries_r4_i1"><text></text></inputEntry>
        <inputEntry id="entries_r4_i2"><text>true</text></inputEntry>
        <inputEntry id="entries_r4_i3"><text></text></inputEntry>
        <inputEntry id="entries_r4_i4"><text></text></inputEntry>
        <outputEntry id="entries_r4_o0"><text>"flag"</text></outputEntry>
      </rule>
      <rule id="entries_r5">
        <inputEntry id="entries_r5_i0"><text></text></inputEntry>
        <inputEntry id="entries_r5_i1"><text></text></inputEntry>
        <inputEntry id="entries_r5_i2"><text></text></inputEntry>
        <inputEntry id="entries_r5_i3"><text>date("2024-01-01")</text></inputEntry>
        <inputEntry id="entries_r5_i4"><text></text></inputEntry>
        <outputEntry id="entries_r5_o0"><text>"new-year"</text></outputEntry>
      </rule>
      <rule id="entries_r6">
        <inputEntry id="entries_r6_i0"><text></text></inputEntry>
        <inputEntry id="entries_r6_i1"><text></text></inputEntry>
        <inputEntry id="entries_r6_i2"><text></text></inputEntry>
        <inputEntry id="entries_r6_i3"><text>&gt; date("2024-06-30")</text></inputEntry>
        <inputEntry id="entries_r6_i4"><text></text></inputEntry>
        <outputEntry id="entries_r6_o0"><text>"h2"</text></outputEntry>
      </rule>
      <rule id="entries_r7">
        <inputEntry id="entries_r7_i0"><text></text></inputEntry>
        <inputEntry id="entries_r7_i1"><text></text></inputEntry>
        <inputEntry id="entries_r7_i2"><text></text></inputEntry>
        <inputEntry id="entries_r7_i3"><text></text></inputEntry>
        <inputEntry id="entries_r7_i4"><text>list contains(?, "x")</text></inputEntry>
        <outputEntry id="entries_r7_o0"><text>"has-x"</text></outputEntry>
      </rule>
      <rule id="entries_r8">
        <inputEntry id="entries_r8_i0"><text></text></inputEntry>
        <inputEntry id="entries_r8_i1"><text></text></inputEntry>
        <inputEntry id="entries_r8_i2"><text></text></inputEntry>
        <inputEntry id="entries_r8_i3"><text></text></inputEntry>
        <inputEntry id="entries_r8_i4"><text>count(?) &gt; 2</text></inputEntry>
        <outputEntry id="entries_r8_o0"><text>"many"</text></outputEntry>
      </rule>
      <rule id="entries_r9">
        <inputEntry id="entries_r9_i0"><text></text></inputEntry>
        <inputEntry id="entries_r9_i1"><text>1,2,3</text></inputEntry>
        <inputEntry id="entries_r9_i2"><text></text></inputEntry>
        <inputEntry id="entries_r9_i3"><text></text></inputEntry>
        <inputEntry id="entries_r9_i4"><text></text></inputEntry>
        <outputEntry id="entries_r9_o0"><text>"small"</text></outputEntry>
      </rule>
      <rule id="entries_r10">
        <inputEntry id="entries_r10_i0"><text></text></inputEntry>
        <inputEntry id="entries_r10_i1"><text>(1..3]</text></inputEntry>
        <inputEntry id="entries_r10_i2"><text></text></inputEntry>
        <inputEntry id="entries_r10_i3"><text></text></inputEntry>
        <inputEntry id="entries_r10_i4"><text></text></inputEntry>
        <outputEntry id="entries_r10_o0"><text>"half-open"</text></outputEntry>
      </rule>
      <rule id="entries_r11">
        <inputEntry id="entries_r11_i0"><text></text></inputEntry>
        <inputEntry id="entries_r11_i1"><text>null</text></inputEntry>
        <inputEntry id="entries_r11_i2"><text></text></inputEntry>
        <inputEntry id="entries_r11_i3"><text></text></inputEntry>
        <inputEntry id="entries_r11_i4"><text></text></inputEntry>
        <outputEntry id="entries_r11_o0"><text>"null-x"</text></outputEntry>
      </rule>
      <rule id="entries_r12">
        <inputEntry id="entries_r12_i0"><text></text></inputEntry>
        <inputEntry id="entries_r12_i1"><text>&gt;&gt;&gt; broken</text></inputEntry>
        <inputEntry id="entries_r12_i2"><text></text></inputEntry>
        <inputEntry id="entries_r12_i3"><text></text></inputEntry>
        <inputEntry id="entries_r12_i4"><text></text></inputEntry>
        <outputEntry id="entries_r12_o0"><text>"bad-entry-matches"</text></outputEntry>
      </rule>
      <rule id="entries_r13">
        <inputEntry id="entries_r13_i0"><text>"z"</text></inputEntry>
        <inputEntry id="entries_r13_i1"><text></text></inputEntry>
        <inputEntry id="entries_r13_i2"><text></text></inputEntry>
        <inputEntry id="entries_r13_i3"><text></text></inputEntry>
        <inputEntry id="entries_r13_i4"><text></text></inputEntry>
        <outputEntry id="entries_r13_o0"><text>x +</text></outputEntry>
      </rule>
      <rule id="entries_r14">
        <inputEntry id="entries_r14_i0"><text>"z"</text></inputEntry>
        <inputEntry id="entries_r14_i1"><text></text></inputEntry>
        <inputEntry id="entries_r14_i2"><text></text></inputEntry>
        <inputEntry id="entries_r14_i3"><text></text></inputEntry>
        <inputEntry id="entries_r14_i4"><text></text></inputEntry>
        <outputEntry id="entries_r14_o0"><text>s + "!" + string(x)</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="computed_input" name="computed_input">
    <decisionTable id="computed_input_t" hitPolicy="FIRST">
      <input id="computed_input_i0" label="in0"><inputExpression id="computed_input_ie0" typeRef="number"><text>a + b</text></inputExpression></input>
      <input id="computed_input_i1" label="in1"><inputExpression id="computed_input_ie1" typeRef="number"><text>upper case(name)</text></inputExpression></input>
      <input id="computed_input_i2" label="in2"><inputExpression id="computed_input_ie2" typeRef="number"><text></text></inputExpression></input>
      <output id="computed_input_o0" name="out" />
      <rule id="computed_input_r0">
        <inputEntry id="computed_input_r0_i0"><text>&gt; 10</text></inputEntry>
        <inputEntry id="computed_input_r0_i1"><text>"BOB"</text></inputEntry>
        <inputEntry id="computed_input_r0_i2"><text></text></inputEntry>
        <outputEntry id="computed_input_r0_o0"><text>"big bob"</text></outputEntry>
      </rule>
      <rule id="computed_input_r1">
        <inputEntry id="computed_input_r1_i0"><text>&gt; 10</text></inputEntry>
        <inputEntry id="computed_input_r1_i1"><text></text></inputEntry>
        <inputEntry id="computed_input_r1_i2"><text>-</text></inputEntry>
        <outputEntry id="computed_input_r1_o0"><text>"big"</text></outputEntry>
      </rule>
      <rule id="computed_input_r2">
        <inputEntry id="computed_input_r2_i0"><text>-</text></inputEntry>
        <inputEntry id="computed_input_r2_i1"><text>-</text></inputEntry>
        <inputEntry id="computed_input_r2_i2"><text>-</text></inputEntry>
        <outputEntry id="computed_input_r2_o0"><text>a * b</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="empty_table" name="empty_table">
    <decisionTable id="empty_table_t" hitPolicy="UNIQUE">
      <input id="empty_table_i0" label="in0"><inputExpression id="empty_table_ie0" typeRef="number"><text>x</text></inputExpression></input>
      <output id="empty_table_o0" name="o" />
    </decisionTable>
  </decision>
</definitions>
