  <decision id="single_unique" name="single_unique">
    <decisionTable id="single_unique_t" hitPolicy="UNIQUE">
      <input id="single_unique_i0" label="in0"><inputExpression id="single_unique_ie0" typeRef="number"><text>x</text></inputExpression></input>
      <output id="single_unique_o0" name="grade" typeRef="string" />
      <rule id="single_unique_r0">
        <inputEntry id="single_unique_r0_i0"><text>&lt; 10</text></inputEntry>
        <outputEntry id="single_unique_r0_o0"><text>"low"</text></outputEntry>
      </rule>
      <rule id="single_unique_r1">
        <inputEntry id="single_unique_r1_i0"><text>[10..20]</text></inputEntry>
        <outputEntry id="single_unique_r1_o0"><text>"mid"</text></outputEntry>
      </rule>
      <rule id="single_unique_r2">
        <inputEntry id="single_unique_r2_i0"><text>&gt;= 15</text></inputEntry>
        <outputEntry id="single_unique_r2_o0"><text>"high"</text></outputEntry>
      </rule>
      <rule id="single_unique_r3">
        <inputEntry id="single_unique_r3_i0"><text>-</text></inputEntry>
        <outputEntry id="single_unique_r3_o0"><text>"any"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="multi_unique" name="multi_unique">
    <decisionTable id="multi_unique_t" hitPolicy="UNIQUE">
      <input id="multi_unique_i0" label="in0"><inputExpression id="multi_unique_ie0" typeRef="number"><text>x</text></inputExpression></input>
      <output id="multi_unique_o0" name="label" />
      <output id="multi_unique_o1" name="score" />
      <rule id="multi_unique_r0">
        <inputEntry id="multi_unique_r0_i0"><text>&lt; 10</text></inputEntry>
        <outputEntry id="multi_unique_r0_o0"><text>"low"</text></outputEntry>
        <outputEntry id="multi_unique_r0_o1"><text>1</text></outputEntry>
      </rule>
      <rule id="multi_unique_r1">
        <inputEntry id="multi_unique_r1_i0"><text>&gt;= 5</text></inputEntry>
        <outputEntry id="multi_unique_r1_o0"><text>"five+"</text></outputEntry>
        <outputEntry id="multi_unique_r1_o1"><text>x * 2</text></outputEntry>
      </rule>
      <rule id="multi_unique_r2">
        <inputEntry id="multi_unique_r2_i0"><text></text></inputEntry>
