      <rule id="collect_sum_r0">
        <inputEntry id="collect_sum_r0_i0"><text>&gt; 0</text></inputEntry>
        <outputEntry id="collect_sum_r0_o0"><text>x</text></outputEntry>
      </rule>
      <rule id="collect_sum_r1">
        <inputEntry id="collect_sum_r1_i0"><text>&gt; 5</text></inputEntry>
        <outputEntry id="collect_sum_r1_o0"><text>10</text></outputEntry>
      </rule>
      <rule id="collect_sum_r2">
        <inputEntry id="collect_sum_r2_i0"><text>&gt; 7</text></inputEntry>
        <outputEntry id="collect_sum_r2_o0"><text>"text"</text></outputEntry>
      </rule>
      <rule id="collect_sum_r3">
        <inputEntry id="collect_sum_r3_i0"><text>&gt; 8</text></inputEntry>
        <outputEntry id="collect_sum_r3_o0"><text>-3.5</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="collect_min" name="collect_min">
    <decisionTable id="collect_min_t" hitPolicy="COLLECT" aggregation="MIN">
      <input id="collect_min_i0" label="in0"><inputExpression id="collect_min_ie0" typeRef="number"><text>x</text></inputExpression></input>
      <output id="collect_min_o0" name="v" />
      <rule id="collect_min_r0">
