      </rule>
      <rule id="collect_min_r2">
        <inputEntry id="collect_min_r2_i0"><text>&gt; 7</text></inputEntry>
        <outputEntry id="collect_min_r2_o0"><text>"text"</text></outputEntry>
      </rule>
      <rule id="collect_min_r3">
        <inputEntry id="collect_min_r3_i0"><text>&gt; 8</text></inputEntry>
        <outputEntry id="collect_min_r3_o0"><text>-3.5</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="collect_max" name="collect_max">
    <decisionTable id="collect_max_t" hitPolicy="COLLECT" aggregation="MAX">
      <input id="collect_max_i0" label="in0"><inputExpression id="collect_max_ie0" typeRef="number"><text>x</text></inputExpression></input>
      <output id="collect_max_o0" name="v" />
      <rule id="collect_max_r0">
