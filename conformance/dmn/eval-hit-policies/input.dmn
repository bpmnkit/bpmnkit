      </rule>
      <rule id="collect_max_r1">
        <inputEntry id="collect_max_r1_i0"><text>&gt; 5</text></inputEntry>
        <outputEntry id="collect_max_r1_o0"><text>10</text></outputEntry>
      </rule>
      <rule id="collect_max_r2">
        <inputEntry id="collect_max_r2_i0"><text>&gt; 7</text></inputEntry>
        <outputEntry id="collect_max_r2_o0"><text>"text"</text></outputEntry>
      </rule>
      <rule id="collect_max_r3">
        <inputEntry id="collect_max_r3_i0"><text>&gt; 8</text></inputEntry>
        <outputEntry id="collect_max_r3_o0"><text>-3.5</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="collect_count" name="collect_count">
    <decisionTable id="collect_count_t" hitPolicy="COLLECT" aggregation="COUNT">
      <input id="collect_count_i0" label="in0"><inputExpression id="collect_count_ie0" typeRef="number"><text>x</text></inputExpression></input>
      <output id="collect_count_o0" name="v" />
      <rule id="collect_count_r0">
        <inputEntry id="collect_count_r0_i0"><text>&gt; 0</text></inputEntry>
        <outputEntry id="collect_count_r0_o0"><text>x</text></outputEntry>
      </rule>
      <rule id="collect_count_r1">
        <inputEntry id="collect_count_r1_i0"><text>&gt; 5</text></inputEntry>
        <outputEntry id="collect_count_r1_o0"><text>10</text></outputEntry>
      </rule>
      <rule id="collect_count_r2">
        <inputEntry id="collect_count_r2_i0"><text>&gt; 7</text></inputEntry>
        <outputEntry id="collect_count_r2_o0"><text>"text"</text></outputEntry>
      </rule>
      <rule id="collect_count_r3">
        <inputEntry id="collect_count_r3_i0"><text>&gt; 8</text></inputEntry>
        <outputEntry id="collect_count_r3_o0"><text>-3.5</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="collect_avg" name="collect_avg">
    <decisionTable id="collect_avg_t" hitPolicy="COLLECT" aggregation="AVG">
      <input id="collect_avg_i0" label="in0"><inputExpression id="collect_avg_ie0" typeRef="number"><text>x</text></inputExpression></input>
      <output id="collect_avg_o0" name="v" />
      <rule id="collect_avg_r0">
        <inputEntry id="collect_avg_r0_i0"><text>&gt; 0</text></inputEntry>
        <outputEntry id="collect_avg_r0_o0"><text>x</text></outputEntry>
      </rule>
      <rule id="collect_avg_r1">
        <inputEntry id="collect_avg_r1_i0"><text>&gt; 5</text></inputEntry>
        <outputEntry id="collect_avg_r1_o0"><text>10</text></outputEntry>
      </rule>
      <rule id="collect_avg_r2">
        <inputEntry id="collect_avg_r2_i0"><text>&gt; 7</text></inputEntry>
