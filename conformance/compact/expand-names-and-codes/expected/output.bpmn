      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="stop_di" bpmnElement="stop">
        <dc:Bounds x="215.6" y="190" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="again_di" bpmnElement="again">
        <dc:Bounds x="724" y="100" width="36" height="36"/>
