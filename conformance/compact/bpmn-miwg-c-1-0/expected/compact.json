      "flows": [
        {
          "condition": "${approved}",
          "from": "invoice_approved",
          "id": "invoiceApproved",
          "name": "yes",
          "to": "prepareBankTransfer"
        },
        {
          "condition": "${!approved}",
          "from": "invoice_approved",
          "id": "invoiceNotApproved",
          "name": "no",
          "to": "reviewInvoice"
        },
        {
          "condition": "${clarified == 'yes'}",
          "from": "reviewSuccessful_gw",
          "id": "reviewSuccessful",
          "name": "yes",
          "to": "approveInvoice"
        },
        {
          "condition": "${clarified == 'no'}",
          "from": "reviewSuccessful_gw",
          "id": "reviewNotSuccessful",
          "name": "no",
          "to": "invoiceNotProcessed"
        },
        {
          "from": "approveInvoice",
