        </inputExpression>
      </input>
      <output id="o2" name="y"/>
      <rule id="r3">
        <inputEntry id="inputEntry_0_0000008">
          <text>1</text>
        </inputEntry>
        <outputEntry id="outputEntry_0_0000009">
          <text>"a"</text>
        </outputEntry>
      </rule>
      <rule id="r4">
        <inputEntry id="inputEntry_0_000000a">
          <text>-</text>
        </inputEntry>
        <outputEntry id="outputEntry_0_000000b">
          <text>"b"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="d_any" name="Any">
