  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="s1">
      <bpmn:timerEventDefinition id="s1_TimerEventDefinition">
        <bpmn:timeDuration>PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="s2">
      <bpmn:messageEventDefinition id="s2_MessageEventDefinition"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="s3">
      <bpmn:signalEventDefinition id="s3_SignalEventDefinition"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="s4">
      <bpmn:conditionalEventDefinition id="s4_ConditionalEventDefinition">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">= x &gt; 1</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="s5">
      <bpmn:timerEventDefinition id="s5_TimerEventDefinition"/>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="c1">
      <bpmn:timerEventDefinition id="c1_TimerEventDefinition">
        <bpmn:timeDuration>PT1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c2">
      <bpmn:messageEventDefinition id="c2_MessageEventDefinition"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c3">
      <bpmn:signalEventDefinition id="c3_SignalEventDefinition"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c4">
      <bpmn:conditionalEventDefinition id="c4_ConditionalEventDefinition">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">= ok</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="c5">
      <bpmn:linkEventDefinition id="c5_LinkEventDefinition"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="t1">
      <bpmn:messageEventDefinition id="t1_MessageEventDefinition"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="t2">
      <bpmn:signalEventDefinition id="t2_SignalEventDefinition"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="t3">
      <bpmn:escalationEventDefinition id="t3_EscalationEventDefinition"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="t4">
      <bpmn:compensateEventDefinition id="t4_CompensateEventDefinition"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="t5">
      <bpmn:linkEventDefinition id="t5_LinkEventDefinition"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="t6"/>
    <bpmn:endEvent id="e1">
      <bpmn:errorEventDefinition id="e1_ErrorEventDefinition"/>
    </bpmn:endEvent>
    <bpmn:endEvent id="e2">
      <bpmn:messageEventDefinition id="e2_MessageEventDefinition"/>
    </bpmn:endEvent>
    <bpmn:endEvent id="e3">
