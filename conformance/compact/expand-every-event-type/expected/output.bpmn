    </bpmn:endEvent>
    <bpmn:endEvent id="e4">
      <bpmn:escalationEventDefinition id="e4_EscalationEventDefinition"/>
    </bpmn:endEvent>
    <bpmn:endEvent id="e5">
      <bpmn:terminateEventDefinition id="e5_TerminateEventDefinition"/>
    </bpmn:endEvent>
    <bpmn:endEvent id="e6">
      <bpmn:compensateEventDefinition id="e6_CompensateEventDefinition"/>
    </bpmn:endEvent>
  </bpmn:process>
