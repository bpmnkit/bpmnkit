      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c4_di" bpmnElement="c4">
        <dc:Bounds x="0" y="1044" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="c5_di" bpmnElement="c5">
        <dc:Bounds x="0" y="1160" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1">
        <dc:Bounds x="0" y="1276" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2">
        <dc:Bounds x="0" y="1392" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3">
