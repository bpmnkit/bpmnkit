<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" id="unique-multiple-match" name="unique-multiple-match" namespace="http://bpmn.io/schema/dmn">
  <decision id="discount" name="discount">
    <decisionTable id="decisionTable_0000008" hitPolicy="UNIQUE">
      <input id="discount_i0" label="amount">
        <inputExpression id="inputExpression_0000001" typeRef="number">
          <text>amount</text>
        </inputExpression>
      </input>
      <output id="discount_o0" name="percent" typeRef="number"/>
      <rule id="small">
        <inputEntry id="inputEntry_0_0000002">
          <text>&lt; 100</text>
        </inputEntry>
        <outputEntry id="outputEntry_0_0000003">
          <text>0</text>
        </outputEntry>
      </rule>
      <rule id="medium">
        <inputEntry id="inputEntry_0_0000004">
          <text>[50..500]</text>
        </inputEntry>
        <outputEntry id="outputEntry_0_0000005">
          <text>5</text>
        </outputEntry>
      </rule>
      <rule id="large">
        <inputEntry id="inputEntry_0_0000006">
          <text>&gt; 300</text>
        </inputEntry>
        <outputEntry id="outputEntry_0_0000007">
          <text>10</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="same_output" name="same_output">
    <decisionTable id="decisionTable_000000e" hitPolicy="UNIQUE">
      <input id="same_output_i0">
        <inputExpression id="inputExpression_0000009">
          <text>amount</text>
        </inputExpression>
      </input>
      <output id="same_output_o0" name="v"/>
      <rule id="same_a">
        <inputEntry id="inputEntry_0_000000a">
          <text>&gt; 0</text>
        </inputEntry>
        <outputEntry id="outputEntry_0_000000b">
          <text>1</text>
        </outputEntry>
      </rule>
      <rule id="same_b">
        <inputEntry id="inputEntry_0_000000c">
          <text>&gt; 0</text>
        </inputEntry>
        <outputEntry id="outputEntry_0_000000d">
          <text>1</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram>
      <dmndi:DMNShape dmnElementRef="discount">
        <dc:Bounds height="80" width="180" x="160" y="100"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape dmnElementRef="same_output">
        <dc:Bounds height="80" width="180" x="160" y="220"/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>

