<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_data" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_data" name="Data wiring" isExecutable="true">
    <bpmn:dataObject id="DataObject_invoice" name="Invoice"/>
    <bpmn:dataObjectReference id="DataObjectRef_invoice" name="Invoice" dataObjectRef="DataObject_invoice"/>
    <bpmn:dataStoreReference id="DataStore_ledger" name="Ledger"/>
    <bpmn:startEvent id="Start_data">
      <bpmn:outgoing>Flow_d1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_post" name="Post to ledger">
      <bpmn:incoming>Flow_d1</bpmn:incoming>
      <bpmn:outgoing>Flow_d2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_data">
      <bpmn:incoming>Flow_d2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_d1" sourceRef="Start_data" targetRef="Task_post"/>
    <bpmn:sequenceFlow id="Flow_d2" sourceRef="Task_post" targetRef="End_data"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_data">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_data" bpmnElement="Process_data">
      <bpmndi:BPMNShape id="DataObject_invoice_di" bpmnElement="DataObject_invoice">
        <dc:Bounds x="7" y="0" width="36" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObjectRef_invoice_di" bpmnElement="DataObjectRef_invoice">
        <dc:Bounds x="7" y="130" width="36" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataStore_ledger_di" bpmnElement="DataStore_ledger">
        <dc:Bounds x="0" y="260" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_data_di" bpmnElement="Start_data">
        <dc:Bounds x="7" y="412" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_post_di" bpmnElement="Task_post">
        <dc:Bounds x="110" y="390" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_data_di" bpmnElement="End_data">
        <dc:Bounds x="270" y="412" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_d1_di" bpmnElement="Flow_d1">
        <di:waypoint x="43" y="430"/>
        <di:waypoint x="110" y="430"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_d2_di" bpmnElement="Flow_d2">
        <di:waypoint x="210" y="430"/>
        <di:waypoint x="270" y="430"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

