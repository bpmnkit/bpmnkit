<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="p" name="Links" isExecutable="true">
    <bpmn:documentation>Process doc</bpmn:documentation>
    <bpmn:startEvent id="s" name="Go">
      <bpmn:documentation>Start doc</bpmn:documentation>
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="out" name="Jump">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:linkEventDefinition id="out_LinkEventDefinition"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="in" name="Land">
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:linkEventDefinition id="in_LinkEventDefinition"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e">
      <bpmn:incoming>f2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="s" targetRef="out"/>
    <bpmn:sequenceFlow id="f2" sourceRef="in" targetRef="e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_p">
    <bpmndi:BPMNPlane id="BPMNPlane_p" bpmnElement="p">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="0" y="0" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-2" y="40" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="out_di" bpmnElement="out">
        <dc:Bounds x="96" y="0" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="94" y="40" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="in_di" bpmnElement="in">
        <dc:Bounds x="0" y="134" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-2" y="174" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
        <dc:Bounds x="96" y="134" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="36" y="18"/>
        <di:waypoint x="96" y="18"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="36" y="152"/>
        <di:waypoint x="96" y="152"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

