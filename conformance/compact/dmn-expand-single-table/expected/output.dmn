<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" id="defs" name="Defs" namespace="http://bpmn.io/schema/dmn">
  <decision id="risk" name="Risk">
    <decisionTable id="decisionTable_0000006" hitPolicy="UNIQUE">
      <input id="i1" label="Age">
        <inputExpression id="inputExpression_0000001" typeRef="number">
          <text>age</text>
        </inputExpression>
      </input>
      <output id="o1" name="risk" typeRef="string"/>
      <rule id="r1">
        <description>young</description>
        <inputEntry id="inputEntry_0_0000002">
          <text>&lt; 18</text>
        </inputEntry>
        <outputEntry id="outputEntry_0_0000003">
          <text>"low"</text>
        </outputEntry>
      </rule>
      <rule id="r2">
        <inputEntry id="inputEntry_0_0000004">
          <text>&gt;= 18</text>
        </inputEntry>
        <outputEntry id="outputEntry_0_0000005">
          <text>"high"</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram>
      <dmndi:DMNShape dmnElementRef="risk">
        <dc:Bounds height="80" width="180" x="160" y="100"/>
      </dmndi:DMNShape>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>

