{
  "id": "Definitions_1",
  "processes": [
    {
      "id": "Process_1",
      "elements": [
        {
          "id": "start",
          "type": "startEvent"
        },
        {
          "id": "call",
          "type": "serviceTask",
          "jobType": "io.camunda:http-json:1",
          "inputs": {
            "url": "https://api.github.com/repos/o/r/issues",
            "method": "POST",
            "authentication.type": "bearer",
            "authentication.token": "{{secrets.GITHUB_TOKEN}}",
            "body": "={title: title}"
          }
        },
        {
          "id": "end",
          "type": "endEvent"
        }
      ],
      "flows": [
        {
          "id": "f1",
          "from": "start",
          "to": "call"
        },
        {
          "id": "f2",
          "from": "call",
          "to": "end"
        }
      ]
    }
  ]
}
