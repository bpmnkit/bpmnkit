          <dc:Bounds x="778.5" y="69" width="126" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sendVerificationRejection_di" bpmnElement="sendVerificationRejection">
        <dc:Bounds x="1005.5" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endRejectedVerification_di" bpmnElement="endRejectedVerification">
        <dc:Bounds x="1210.5" y="22" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1123.5" y="62" width="210" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="screening_di" bpmnElement="screening">
        <dc:Bounds x="653.5" y="140" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dueDiligenceGateway_di" bpmnElement="dueDiligenceGateway" isMarkerVisible="true">
        <dc:Bounds x="816.5" y="155" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="771.5" y="137" width="140" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="standardDueDiligence_di" bpmnElement="standardDueDiligence">
        <dc:Bounds x="1005.5" y="140" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="complianceReview_di" bpmnElement="complianceReview">
        <dc:Bounds x="1005.5" y="280" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="riskClassification_di" bpmnElement="riskClassification">
        <dc:Bounds x="1351.5" y="140" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="outcomeGateway_di" bpmnElement="outcomeGateway" isMarkerVisible="true">
        <dc:Bounds x="1525" y="155" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1469.5" y="137" width="161" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="activateAccount_di" bpmnElement="activateAccount">
        <dc:Bounds x="1658" y="140" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endApproved_di" bpmnElement="endApproved">
        <dc:Bounds x="1838.5" y="162" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1797" y="202" width="119" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="escalateToCompliance_di" bpmnElement="escalateToCompliance">
        <dc:Bounds x="1658" y="280" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEscalated_di" bpmnElement="endEscalated">
        <dc:Bounds x="1838.5" y="302" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1776" y="342" width="161" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sendFinalRejection_di" bpmnElement="sendFinalRejection">
        <dc:Bounds x="1658" y="420" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endRejected_di" bpmnElement="endRejected">
        <dc:Bounds x="1838.5" y="442" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1797" y="482" width="119" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dueDiligenceGateway_join_di" bpmnElement="dueDiligenceGateway_join" isMarkerVisible="true">
        <dc:Bounds x="1203.5" y="155" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_xMEWWQ9P_di" bpmnElement="Flow_xMEWWQ9P">
        <di:waypoint x="36" y="40"/>
        <di:waypoint x="130.5" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_aFggSXlz_di" bpmnElement="Flow_aFggSXlz">
        <di:waypoint x="230.5" y="40"/>
        <di:waypoint x="290.5" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_nrWGBeCZ_di" bpmnElement="Flow_nrWGBeCZ">
        <di:waypoint x="390.5" y="40"/>
        <di:waypoint x="450.5" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Vp0HOfCz_di" bpmnElement="Flow_Vp0HOfCz">
        <di:waypoint x="475.5" y="65"/>
        <di:waypoint x="475.5" y="180"/>
        <di:waypoint x="653.5" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RETXa3Vt_di" bpmnElement="Flow_RETXa3Vt">
        <di:waypoint x="500.5" y="40"/>
        <di:waypoint x="653.5" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_i4OMbS2y_di" bpmnElement="Flow_i4OMbS2y">
        <di:waypoint x="753.5" y="40"/>
        <di:waypoint x="816.5" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8reekDVI_di" bpmnElement="Flow_8reekDVI">
        <di:waypoint x="841.5" y="15"/>
        <di:waypoint x="841.5" y="-40"/>
        <di:waypoint x="180.5" y="-40"/>
        <di:waypoint x="180.5" y="0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Y4q86h1Q_di" bpmnElement="Flow_Y4q86h1Q">
        <di:waypoint x="866.5" y="40"/>
        <di:waypoint x="1005.5" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_VNppp5Gg_di" bpmnElement="Flow_VNppp5Gg">
        <di:waypoint x="1105.5" y="40"/>
        <di:waypoint x="1210.5" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8ZqbzajU_di" bpmnElement="Flow_8ZqbzajU">
        <di:waypoint x="753.5" y="180"/>
        <di:waypoint x="816.5" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_hyodCBEu_di" bpmnElement="Flow_hyodCBEu">
        <di:waypoint x="866.5" y="180"/>
        <di:waypoint x="1005.5" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fj3alEoq_di" bpmnElement="Flow_Fj3alEoq">
        <di:waypoint x="1105.5" y="180"/>
        <di:waypoint x="1203.5" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_LXaUZMEX_di" bpmnElement="Flow_LXaUZMEX">
        <di:waypoint x="841.5" y="205"/>
        <di:waypoint x="841.5" y="320"/>
        <di:waypoint x="1005.5" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1u29yKxb_di" bpmnElement="Flow_1u29yKxb">
        <di:waypoint x="1055.5" y="280"/>
        <di:waypoint x="1055.5" y="250"/>
        <di:waypoint x="1228.5" y="250"/>
        <di:waypoint x="1228.5" y="205"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NFb6OA8f_di" bpmnElement="Flow_NFb6OA8f">
        <di:waypoint x="1451.5" y="180"/>
        <di:waypoint x="1525" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_hHN1OOEM_di" bpmnElement="Flow_hHN1OOEM">
        <di:waypoint x="1575" y="180"/>
        <di:waypoint x="1658" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1busQeAe_di" bpmnElement="Flow_1busQeAe">
        <di:waypoint x="1758" y="180"/>
