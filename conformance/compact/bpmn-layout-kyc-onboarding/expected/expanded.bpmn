        <dc:Bounds x="130.5" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="verifyDocument_di" bpmnElement="verifyDocument">
        <dc:Bounds x="290.5" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="qualityGateway_di" bpmnElement="qualityGateway" isMarkerVisible="true">
        <dc:Bounds x="450.5" y="15" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="412.5" y="-3" width="126" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="incrementRetry_di" bpmnElement="incrementRetry">
        <dc:Bounds x="653.5" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="retryGateway_di" bpmnElement="retryGateway" isMarkerVisible="true">
        <dc:Bounds x="816.5" y="15" width="50" height="50"/>
