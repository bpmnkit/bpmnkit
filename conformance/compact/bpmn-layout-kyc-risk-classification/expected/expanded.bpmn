        <bpmndi:BPMNLabel>
          <dc:Bounds x="1781" y="62" width="161" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sendKycRejection_di" bpmnElement="sendKycRejection">
        <dc:Bounds x="1663" y="140" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endRejected_di" bpmnElement="endRejected">
        <dc:Bounds x="1843.5" y="162" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1833.5" y="202" width="56" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dueDiligenceGateway_join_di" bpmnElement="dueDiligenceGateway_join" isMarkerVisible="true">
        <dc:Bounds x="1204" y="155" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_dzvGWk3K_di" bpmnElement="Flow_dzvGWk3K">
        <di:waypoint x="36" y="180"/>
        <di:waypoint x="99" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_jFSBMYJb_di" bpmnElement="Flow_jFSBMYJb">
        <di:waypoint x="199" y="180"/>
        <di:waypoint x="259" y="180"/>
      </bpmndi:BPMNEdge>
