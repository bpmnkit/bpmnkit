        <dc:Bounds x="847" y="283" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sendVerificationRejection_di" bpmnElement="sendVerificationRejection">
        <dc:Bounds x="847" y="423" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endRejectedDocument_di" bpmnElement="endRejectedDocument">
        <dc:Bounds x="1076" y="445" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1027.5" y="485" width="133" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sanctionsScreening_di" bpmnElement="sanctionsScreening">
        <dc:Bounds x="608" y="140" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dueDiligenceGateway_di" bpmnElement="dueDiligenceGateway" isMarkerVisible="true">
        <dc:Bounds x="872" y="155" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="827" y="209" width="140" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="standardDueDiligence_di" bpmnElement="standardDueDiligence">
        <dc:Bounds x="1044" y="283" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="enhancedDueDiligence_di" bpmnElement="enhancedDueDiligence">
        <dc:Bounds x="1044" y="140" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finalRiskClassification_di" bpmnElement="finalRiskClassification">
        <dc:Bounds x="1314" y="140" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="outcomeGateway_di" bpmnElement="outcomeGateway" isMarkerVisible="true">
        <dc:Bounds x="1474" y="155" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1507" y="209" width="105" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="activateAccount_di" bpmnElement="activateAccount">
        <dc:Bounds x="1663" y="283" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endApproved_di" bpmnElement="endApproved">
        <dc:Bounds x="1843.5" y="305" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1833.5" y="345" width="56" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="escalateToCompliance_di" bpmnElement="escalateToCompliance">
        <dc:Bounds x="1663" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEscalated_di" bpmnElement="endEscalated">
