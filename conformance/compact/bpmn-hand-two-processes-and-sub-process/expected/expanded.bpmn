<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="p1" name="One" isExecutable="true">
    <bpmn:startEvent id="s">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="sp" name="Sub">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:startEvent id="ss">
        <bpmn:outgoing>sf1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="st" name="Inner">
        <bpmn:incoming>sf1</bpmn:incoming>
        <bpmn:outgoing>sf2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="se">
        <bpmn:incoming>sf2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="sf1" sourceRef="ss" targetRef="st"/>
      <bpmn:sequenceFlow id="sf2" sourceRef="st" targetRef="se"/>
    </bpmn:subProcess>
    <bpmn:endEvent id="e">
      <bpmn:incoming>f2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="s" targetRef="sp"/>
    <bpmn:sequenceFlow id="f2" sourceRef="sp" targetRef="e"/>
  </bpmn:process>
  <bpmn:process id="p2" name="Two" isExecutable="true">
    <bpmn:startEvent id="s2">
      <bpmn:outgoing>g1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="e2">
      <bpmn:incoming>g1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="g1" sourceRef="s2" targetRef="e2"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_p1">
    <bpmndi:BPMNPlane id="BPMNPlane_p1" bpmnElement="p1">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="0" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sp_di" bpmnElement="sp" isExpanded="true">
        <dc:Bounds x="136" y="0" width="392" height="208"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
        <dc:Bounds x="628" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ss_di" bpmnElement="ss">
        <dc:Bounds x="186" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="st_di" bpmnElement="st">
        <dc:Bounds x="282" y="78" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="se_di" bpmnElement="se">
        <dc:Bounds x="442" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="36" y="118"/>
        <di:waypoint x="136" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="528" y="118"/>
        <di:waypoint x="628" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf1_di" bpmnElement="sf1">
        <di:waypoint x="222" y="118"/>
        <di:waypoint x="282" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sf2_di" bpmnElement="sf2">
        <di:waypoint x="382" y="118"/>
        <di:waypoint x="442" y="118"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_p2">
    <bpmndi:BPMNPlane id="BPMNPlane_p2" bpmnElement="p2">
      <bpmndi:BPMNShape id="s2_di" bpmnElement="s2">
        <dc:Bounds x="0" y="0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e2_di" bpmnElement="e2">
        <dc:Bounds x="96" y="0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="g1_di" bpmnElement="g1">
        <di:waypoint x="36" y="18"/>
        <di:waypoint x="96" y="18"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

