<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_unmodelled" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_unmodelled" name="Unmodelled content carrier" isExecutable="true">
    <bpmn:startEvent id="Start_u">
      <bpmn:outgoing>Flow_u1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_u" name="Review order">
      <bpmn:incoming>Flow_u1</bpmn:incoming>
      <bpmn:outgoing>Flow_u2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_u">
      <bpmn:incoming>Flow_u2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_u1" sourceRef="Start_u" targetRef="Task_u"/>
    <bpmn:sequenceFlow id="Flow_u2" sourceRef="Task_u" targetRef="End_u"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_unmodelled">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_unmodelled" bpmnElement="Process_unmodelled">
      <bpmndi:BPMNShape id="Start_u_di" bpmnElement="Start_u">
        <dc:Bounds x="0" y="22" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_u_di" bpmnElement="Task_u">
        <dc:Bounds x="96" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_u_di" bpmnElement="End_u">
        <dc:Bounds x="256" y="22" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_u1_di" bpmnElement="Flow_u1">
        <di:waypoint x="36" y="40"/>
        <di:waypoint x="96" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_u2_di" bpmnElement="Flow_u2">
        <di:waypoint x="196" y="40"/>
        <di:waypoint x="256" y="40"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

