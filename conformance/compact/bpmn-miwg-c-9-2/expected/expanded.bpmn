  <bpmn:error id="Error_x" name="02" errorCode="02"/>
  <bpmn:message id="Message_Message_DocumentRequested" name="Message_DocumentRequested">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="= documentReferenceId"/>
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_Message_FraudSuspected" name="Message_FraudSuspected">
