  <bpmn:process id="ManualCheck" name="Manual Check" isExecutable="true">
    <bpmn:userTask id="UserTask_DecideOnApplication" name="Decide on application">
      <bpmn:extensionElements>
        <zeebe:assignmentDefinition candidateGroups="clerks"/>
        <zeebe:ioMapping>
          <zeebe:input source="= string join(risks, &quot;, &quot;)" target="risksText"/>
          <zeebe:input source="= applicant.age" target="age"/>
          <zeebe:input source="= applicant.name" target="applicantName"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08vmski</bpmn:incoming>
      <bpmn:outgoing>Flow_0vjv3ik</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="StartEvent_DecideManually" name="Decide Manually">
      <bpmn:outgoing>Flow_08vmski</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:boundaryEvent id="TimerEvent_Timeout" name="Timeout (7 days)" attachedToRef="UserTask_DecideOnApplication" cancelActivity="true">
      <bpmn:outgoing>Flow_03n7pdb</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEvent_Timeout_TimerEventDefinition">
        <bpmn:timeDuration>P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:subProcess id="Activity_0uvp3cb" triggeredByEvent="true">
      <bpmn:startEvent id="StartMessageEvent_DocumentRequested" name="Document requested" isInterrupting="false">
        <bpmn:outgoing>Flow_0irfroh</bpmn:outgoing>
        <bpmn:messageEventDefinition id="StartMessageEvent_DocumentRequested_MessageEventDefinition" messageRef="Message_Message_DocumentRequested"/>
      </bpmn:startEvent>
      <bpmn:endEvent id="EndEvent_DocumentReceived" name="Document Received">
        <bpmn:incoming>Flow_1wwxns6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:callActivity id="CallActivity_RequestDocument" name="Document Request">
        <bpmn:extensionElements>
          <zeebe:calledElement processId="requestDocument_en"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0irfroh</bpmn:incoming>
        <bpmn:outgoing>Flow_1wwxns6</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics>
          <bpmn:extensionElements>
            <zeebe:loopCharacteristics inputCollection="=documents" inputElement="document"/>
          </bpmn:extensionElements>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:callActivity>
      <bpmn:sequenceFlow id="Flow_0irfroh" sourceRef="StartMessageEvent_DocumentRequested" targetRef="CallActivity_RequestDocument"/>
      <bpmn:sequenceFlow id="Flow_1wwxns6" sourceRef="CallActivity_RequestDocument" targetRef="EndEvent_DocumentReceived"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="Activity_1esx1s7" triggeredByEvent="true">
      <bpmn:startEvent id="StartTimerEvent_AcceleratedDecision" name="Accelerated decision" isInterrupting="false">
        <bpmn:outgoing>Flow_0kaot38</bpmn:outgoing>
        <bpmn:timerEventDefinition id="StartTimerEvent_AcceleratedDecision_TimerEventDefinition">
          <bpmn:timeCycle>R1/P5D</bpmn:timeCycle>
        </bpmn:timerEventDefinition>
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask_AccelerateDecision" name="Accelerate decision making">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="teamleaders"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1octlto</bpmn:incoming>
        <bpmn:outgoing>Flow_1t18skh</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="EndEvent_DecisionAccelerated" name="Decision accelerated">
        <bpmn:incoming>Flow_1t18skh</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sendTask id="SendTask_NotifyCustomerDelay" name="Notify customer about delay">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="notifyCustomerDelay"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0kaot38</bpmn:incoming>
        <bpmn:outgoing>Flow_1octlto</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sequenceFlow id="Flow_0kaot38" sourceRef="StartTimerEvent_AcceleratedDecision" targetRef="SendTask_NotifyCustomerDelay"/>
      <bpmn:sequenceFlow id="Flow_1t18skh" sourceRef="UserTask_AccelerateDecision" targetRef="EndEvent_DecisionAccelerated"/>
      <bpmn:sequenceFlow id="Flow_1octlto" sourceRef="SendTask_NotifyCustomerDelay" targetRef="UserTask_AccelerateDecision"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="Activity_02a6b2h" triggeredByEvent="true">
      <bpmn:userTask id="UserTask_CheckForFraud" name="Check for Fraud">
        <bpmn:extensionElements>
          <zeebe:assignmentDefinition candidateGroups="riskteam"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0nttki4</bpmn:incoming>
        <bpmn:outgoing>Flow_1istmr0</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:startEvent id="StartMessageEvent_FraudSuspected" name="Fraud suspected" isInterrupting="false">
        <bpmn:outgoing>Flow_0nttki4</bpmn:outgoing>
        <bpmn:messageEventDefinition id="StartMessageEvent_FraudSuspected_MessageEventDefinition" messageRef="Message_Message_FraudSuspected"/>
      </bpmn:startEvent>
      <bpmn:endEvent id="ErrorEndEvent_FraudDetected" name="Fraud Detected">
        <bpmn:incoming>SequenceFlow_Yes</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorEndEvent_FraudDetected_ErrorEventDefinition" errorRef="Error_x"/>
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="Gateway_FraudDetected" name="Fraud detected?" default="SequenceFlow_No">
        <bpmn:incoming>Flow_1istmr0</bpmn:incoming>
        <bpmn:outgoing>SequenceFlow_Yes</bpmn:outgoing>
        <bpmn:outgoing>SequenceFlow_No</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="EndEvent_FraudNoDetected" name="Fraud no detected">
        <bpmn:incoming>SequenceFlow_No</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_0nttki4" sourceRef="StartMessageEvent_FraudSuspected" targetRef="UserTask_CheckForFraud"/>
      <bpmn:sequenceFlow id="SequenceFlow_Yes" sourceRef="Gateway_FraudDetected" targetRef="ErrorEndEvent_FraudDetected" name="Yes">
        <bpmn:conditionExpression>=fraud</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_1istmr0" sourceRef="UserTask_CheckForFraud" targetRef="Gateway_FraudDetected"/>
      <bpmn:sequenceFlow id="SequenceFlow_No" sourceRef="Gateway_FraudDetected" targetRef="EndEvent_FraudNoDetected" name="No"/>
    </bpmn:subProcess>
    <bpmn:endEvent id="ErrorEndEvent_Timeout" name="Timeout">
      <bpmn:incoming>Flow_03n7pdb</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEndEvent_Timeout_ErrorEventDefinition" errorRef="Error_x"/>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_ManuallyDecided" name="Manually Decided">
      <bpmn:incoming>Flow_0vjv3ik</bpmn:incoming>
