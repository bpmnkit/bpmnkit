<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_LoanApproval" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="loan-approval-process" name="Loan Approval Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_LoanRequest" name="Loan Application Received">
      <bpmn:outgoing>Flow_ToCreditCheck</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_CreditScoreCheck" name="Credit Score Check">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1"/>
        <zeebe:taskHeaders>
          <zeebe:header key="resultVariable" value="creditResponse"/>
        </zeebe:taskHeaders>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;GET&quot;" target="method"/>
          <zeebe:input source="=&quot;https://api.creditbureau.example.com/v1/score/&quot; + applicantId" target="url"/>
          <zeebe:input source="noAuth" target="authentication.type"/>
          <zeebe:output source="=response.body.creditScore" target="creditScore"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCreditCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ToPreScreen</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PreScreen" name="Pre-Screening">
      <bpmn:incoming>Flow_ToPreScreen</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectLowScore</bpmn:outgoing>
      <bpmn:outgoing>Flow_PassPreScreen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_RiskScoring" name="Risk Scoring">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="risk-scoring" resultVariable="riskResult"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PassPreScreen</bpmn:incoming>
      <bpmn:outgoing>Flow_ToUnderwriter</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:userTask id="Task_UnderwriterReview" name="Manual Underwriter Review">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="underwriter-review-form"/>
        <zeebe:assignmentDefinition candidateGroups="underwriters"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToUnderwriter</bpmn:incoming>
      <bpmn:outgoing>Flow_ToDecisionGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_FinalDecision" name="Underwriter Decision">
      <bpmn:incoming>Flow_ToDecisionGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Approved" name="Loan Approved">
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Rejected" name="Loan Rejected">
      <bpmn:incoming>Flow_RejectLowScore</bpmn:incoming>
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToCreditCheck" sourceRef="StartEvent_LoanRequest" targetRef="Task_CreditScoreCheck"/>
    <bpmn:sequenceFlow id="Flow_ToPreScreen" sourceRef="Task_CreditScoreCheck" targetRef="Gateway_PreScreen"/>
    <bpmn:sequenceFlow id="Flow_RejectLowScore" sourceRef="Gateway_PreScreen" targetRef="EndEvent_Rejected" name="Score &lt; 580">
      <bpmn:conditionExpression>=creditScore &lt; 580</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PassPreScreen" sourceRef="Gateway_PreScreen" targetRef="Task_RiskScoring" name="Score >= 580">
      <bpmn:conditionExpression>=creditScore &gt;= 580</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ToUnderwriter" sourceRef="Task_RiskScoring" targetRef="Task_UnderwriterReview"/>
    <bpmn:sequenceFlow id="Flow_ToDecisionGateway" sourceRef="Task_UnderwriterReview" targetRef="Gateway_FinalDecision"/>
    <bpmn:sequenceFlow id="Flow_Approved" sourceRef="Gateway_FinalDecision" targetRef="EndEvent_Approved" name="Approved">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejected" sourceRef="Gateway_FinalDecision" targetRef="EndEvent_Rejected" name="Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_loan-approval-process">
    <bpmndi:BPMNPlane id="BPMNPlane_loan-approval-process" bpmnElement="loan-approval-process">
      <bpmndi:BPMNShape id="StartEvent_LoanRequest_di" bpmnElement="StartEvent_LoanRequest">
        <dc:Bounds x="0" y="22" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-69.5" y="62" width="175" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreditScoreCheck_di" bpmnElement="Task_CreditScoreCheck">
        <dc:Bounds x="123.5" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PreScreen_di" bpmnElement="Gateway_PreScreen" isMarkerVisible="true">
        <dc:Bounds x="283.5" y="15" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="263" y="-3" width="91" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RiskScoring_di" bpmnElement="Task_RiskScoring">
        <dc:Bounds x="437.5" y="114" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UnderwriterReview_di" bpmnElement="Task_UnderwriterReview">
        <dc:Bounds x="597.5" y="114" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_FinalDecision_di" bpmnElement="Gateway_FinalDecision" isMarkerVisible="true">
        <dc:Bounds x="760.5" y="129" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="715.5" y="183" width="140" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Approved_di" bpmnElement="EndEvent_Approved">
        <dc:Bounds x="901" y="136" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="873.5" y="176" width="91" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="901" y="22" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="873.5" y="4" width="91" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToCreditCheck_di" bpmnElement="Flow_ToCreditCheck">
        <di:waypoint x="36" y="40"/>
        <di:waypoint x="123.5" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToPreScreen_di" bpmnElement="Flow_ToPreScreen">
        <di:waypoint x="223.5" y="40"/>
        <di:waypoint x="283.5" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_RejectLowScore_di" bpmnElement="Flow_RejectLowScore">
        <di:waypoint x="333.5" y="40"/>
        <di:waypoint x="901" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PassPreScreen_di" bpmnElement="Flow_PassPreScreen">
        <di:waypoint x="308.5" y="65"/>
        <di:waypoint x="308.5" y="154"/>
        <di:waypoint x="437.5" y="154"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToUnderwriter_di" bpmnElement="Flow_ToUnderwriter">
        <di:waypoint x="537.5" y="154"/>
        <di:waypoint x="597.5" y="154"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToDecisionGateway_di" bpmnElement="Flow_ToDecisionGateway">
        <di:waypoint x="697.5" y="154"/>
        <di:waypoint x="760.5" y="154"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved">
        <di:waypoint x="810.5" y="154"/>
        <di:waypoint x="901" y="154"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Rejected_di" bpmnElement="Flow_Rejected">
        <di:waypoint x="785.5" y="129"/>
        <di:waypoint x="785.5" y="93.5"/>
        <di:waypoint x="919" y="93.5"/>
        <di:waypoint x="919" y="58"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

