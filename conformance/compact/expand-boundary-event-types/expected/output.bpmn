    </bpmn:endEvent>
    <bpmn:endEvent id="x2">
      <bpmn:incoming>f2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="b1" targetRef="x1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="b2" targetRef="x2"/>
  </bpmn:process>
