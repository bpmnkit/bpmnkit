  <bpmndi:BPMNDiagram id="BPMNDiagram_connector-process">
    <bpmndi:BPMNPlane id="BPMNPlane_connector-process" bpmnElement="connector-process">
      <bpmndi:BPMNShape id="c_start_di" bpmnElement="c_start">
