      <bpmndi:BPMNShape id="m_start_di" bpmnElement="m_start">
        <dc:Bounds x="0" y="0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="await_confirmation_di" bpmnElement="await_confirmation">
