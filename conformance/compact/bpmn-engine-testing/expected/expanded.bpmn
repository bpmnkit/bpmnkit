      <bpmndi:BPMNShape id="t_start_di" bpmnElement="t_start">
        <dc:Bounds x="0" y="0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait_hour_di" bpmnElement="wait_hour">
        <dc:Bounds x="96" y="0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_end_di" bpmnElement="t_end">
        <dc:Bounds x="192" y="0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="tf1_di" bpmnElement="tf1">
        <di:waypoint x="36" y="18"/>
        <di:waypoint x="96" y="18"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="tf2_di" bpmnElement="tf2">
        <di:waypoint x="132" y="18"/>
        <di:waypoint x="192" y="18"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_date-process">
    <bpmndi:BPMNPlane id="BPMNPlane_date-process" bpmnElement="date-process">
      <bpmndi:BPMNShape id="d_start_di" bpmnElement="d_start">
        <dc:Bounds x="0" y="0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="wait_new_year_di" bpmnElement="wait_new_year">
        <dc:Bounds x="96" y="0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="d_end_di" bpmnElement="d_end">
        <dc:Bounds x="192" y="0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="df1_di" bpmnElement="df1">
        <di:waypoint x="36" y="18"/>
        <di:waypoint x="96" y="18"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="df2_di" bpmnElement="df2">
