      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="escalate_di" bpmnElement="escalate">
        <dc:Bounds x="256" y="118" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="r_escalated_di" bpmnElement="r_escalated">
