  <bpmndi:BPMNDiagram id="BPMNDiagram_parallel-process">
    <bpmndi:BPMNPlane id="BPMNPlane_parallel-process" bpmnElement="parallel-process">
      <bpmndi:BPMNShape id="p_start_di" bpmnElement="p_start">
        <dc:Bounds x="0" y="22" width="36" height="36"/>
      </bpmndi:BPMNShape>
