<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="sid-bdb880ac-c464-4e5c-aa56-569d709436e0" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="handle-invoice" name="Invoice Handling (OMG BPMN MIWG Demo)" isExecutable="true">
    <bpmn:userTask id="approveInvoice" name="Approve Invoice">
      <bpmn:incoming>reviewSuccessful</bpmn:incoming>
      <bpmn:incoming>sequenceFlow_178</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow_180</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="invoice_approved" name="Invoice&#13;&#10;approved?">
      <bpmn:incoming>sequenceFlow_180</bpmn:incoming>
      <bpmn:outgoing>invoiceApproved</bpmn:outgoing>
      <bpmn:outgoing>invoiceNotApproved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="assignApprover" name="Assign&#13;&#10;Approver">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow_178</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="reviewInvoice" name="Rechnung klären">
      <bpmn:incoming>invoiceNotApproved</bpmn:incoming>
      <bpmn:outgoing>sequenceFlow_183</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="reviewSuccessful_gw" name="Review&#10;successful?">
      <bpmn:incoming>sequenceFlow_183</bpmn:incoming>
      <bpmn:outgoing>reviewSuccessful</bpmn:outgoing>
      <bpmn:outgoing>reviewNotSuccessful</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="invoiceNotProcessed" name="Invoice not&#10;processed">
      <bpmn:incoming>reviewNotSuccessful</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="StartEvent_1" name="Invoice&#13;&#10;received">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="prepareBankTransfer" name="Prepare&#13;&#10;Bank&#13;&#10;Transfer">
      <bpmn:incoming>invoiceApproved</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="invoiceProcessed" name="Invoice&#10;processed">
      <bpmn:incoming>SequenceFlow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="archiveInvoice" name="Archive&#10;Invoice">
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataObject id="Bpmn_DataObject_approver" name="approver"/>
    <bpmn:dataObjectReference id="Bpmn_DataObjectReference_assignApprover" name="approver" dataObjectRef="Bpmn_DataObject_approver"/>
    <bpmn:dataObject id="Bpmn_DataObject_WUfQYrH1EeSuDf0W70XLGw" name="approved"/>
    <bpmn:dataObjectReference id="Bpmn_DataObjectReference_YGA4YLH1EeSuDf0W70XLGw" name="approved" dataObjectRef="Bpmn_DataObject_WUfQYrH1EeSuDf0W70XLGw"/>
    <bpmn:dataObject id="Bpmn_DataObject_aT_L0rH1EeSuDf0W70XLGw" name="clarified"/>
    <bpmn:dataObjectReference id="Bpmn_DataObjectReference_cdsDQLH1EeSuDf0W70XLGw" name="clarified" dataObjectRef="Bpmn_DataObject_aT_L0rH1EeSuDf0W70XLGw"/>
    <bpmn:sequenceFlow id="invoiceApproved" sourceRef="invoice_approved" targetRef="prepareBankTransfer" name="yes">
      <bpmn:conditionExpression>=bpmn:getDataObject('approved')</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="invoiceNotApproved" sourceRef="invoice_approved" targetRef="reviewInvoice" name="no">
      <bpmn:conditionExpression>=not(bpmn:getDataObject('approved'))</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="reviewSuccessful" sourceRef="reviewSuccessful_gw" targetRef="approveInvoice" name="yes">
      <bpmn:conditionExpression>=bpmn:getDataObject('clarified') = 'yes'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="reviewNotSuccessful" sourceRef="reviewSuccessful_gw" targetRef="invoiceNotProcessed" name="no">
      <bpmn:conditionExpression>=bpmn:getDataObject('clarified') = 'no'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="sequenceFlow_180" sourceRef="approveInvoice" targetRef="invoice_approved"/>
    <bpmn:sequenceFlow id="sequenceFlow_183" sourceRef="reviewInvoice" targetRef="reviewSuccessful_gw"/>
    <bpmn:sequenceFlow id="sequenceFlow_178" sourceRef="assignApprover" targetRef="approveInvoice"/>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="prepareBankTransfer" targetRef="archiveInvoice"/>
    <bpmn:sequenceFlow id="SequenceFlow_3" sourceRef="archiveInvoice" targetRef="invoiceProcessed"/>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent_1" targetRef="assignApprover"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_handle-invoice">
    <bpmndi:BPMNPlane id="BPMNPlane_handle-invoice" bpmnElement="handle-invoice">
      <bpmndi:BPMNShape id="approveInvoice_di" bpmnElement="approveInvoice">
        <dc:Bounds x="256" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="invoice_approved_di" bpmnElement="invoice_approved" isMarkerVisible="true">
        <dc:Bounds x="416" y="15" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="378" y="-3" width="126" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="assignApprover_di" bpmnElement="assignApprover">
        <dc:Bounds x="96" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reviewInvoice_di" bpmnElement="reviewInvoice">
        <dc:Bounds x="526" y="140" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reviewSuccessful_gw_di" bpmnElement="reviewSuccessful_gw" isMarkerVisible="true">
        <dc:Bounds x="711" y="155" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="673" y="137" width="126" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="invoiceNotProcessed_di" bpmnElement="invoiceNotProcessed">
        <dc:Bounds x="872.5" y="162" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="817" y="202" width="147" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="0" y="22" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-41.5" y="62" width="119" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="prepareBankTransfer_di" bpmnElement="prepareBankTransfer">
        <dc:Bounds x="526" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="invoiceProcessed_di" bpmnElement="invoiceProcessed">
        <dc:Bounds x="872.5" y="22" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="831" y="62" width="119" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="archiveInvoice_di" bpmnElement="archiveInvoice">
        <dc:Bounds x="686" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Bpmn_DataObject_approver_di" bpmnElement="Bpmn_DataObject_approver">
        <dc:Bounds x="0" y="303" width="36" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Bpmn_DataObjectReference_assignApprover_di" bpmnElement="Bpmn_DataObjectReference_assignApprover">
        <dc:Bounds x="0" y="433" width="36" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Bpmn_DataObject_WUfQYrH1EeSuDf0W70XLGw_di" bpmnElement="Bpmn_DataObject_WUfQYrH1EeSuDf0W70XLGw">
        <dc:Bounds x="0" y="563" width="36" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Bpmn_DataObjectReference_YGA4YLH1EeSuDf0W70XLGw_di" bpmnElement="Bpmn_DataObjectReference_YGA4YLH1EeSuDf0W70XLGw">
        <dc:Bounds x="0" y="693" width="36" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Bpmn_DataObject_aT_L0rH1EeSuDf0W70XLGw_di" bpmnElement="Bpmn_DataObject_aT_L0rH1EeSuDf0W70XLGw">
        <dc:Bounds x="0" y="823" width="36" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Bpmn_DataObjectReference_cdsDQLH1EeSuDf0W70XLGw_di" bpmnElement="Bpmn_DataObjectReference_cdsDQLH1EeSuDf0W70XLGw">
        <dc:Bounds x="0" y="953" width="36" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="invoiceApproved_di" bpmnElement="invoiceApproved">
        <di:waypoint x="466" y="40"/>
        <di:waypoint x="526" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="invoiceNotApproved_di" bpmnElement="invoiceNotApproved">
        <di:waypoint x="441" y="65"/>
        <di:waypoint x="441" y="180"/>
        <di:waypoint x="526" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="reviewSuccessful_di" bpmnElement="reviewSuccessful">
        <di:waypoint x="736" y="205"/>
        <di:waypoint x="736" y="260"/>
        <di:waypoint x="306" y="260"/>
        <di:waypoint x="306" y="80"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="reviewNotSuccessful_di" bpmnElement="reviewNotSuccessful">
        <di:waypoint x="761" y="180"/>
        <di:waypoint x="872.5" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sequenceFlow_180_di" bpmnElement="sequenceFlow_180">
        <di:waypoint x="356" y="40"/>
        <di:waypoint x="416" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sequenceFlow_183_di" bpmnElement="sequenceFlow_183">
        <di:waypoint x="626" y="180"/>
        <di:waypoint x="711" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sequenceFlow_178_di" bpmnElement="sequenceFlow_178">
        <di:waypoint x="196" y="40"/>
        <di:waypoint x="256" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_2_di" bpmnElement="SequenceFlow_2">
        <di:waypoint x="626" y="40"/>
        <di:waypoint x="686" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_3_di" bpmnElement="SequenceFlow_3">
        <di:waypoint x="786" y="40"/>
        <di:waypoint x="872.5" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_1_di" bpmnElement="SequenceFlow_1">
        <di:waypoint x="36" y="40"/>
        <di:waypoint x="96" y="40"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

