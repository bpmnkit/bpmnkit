<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="true">
    <bpmn:startEvent id="start_order_received" name="Order Received">
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_check_stock" name="Check Stock">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw_in_stock" name="In Stock?">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="task_charge_card" name="Charge Card">
      <bpmn:incoming>flow_3</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="task_ship_order" name="Ship Order"/>
    <bpmn:task id="task_notify_unavailable" name="Notify Customer of Unavailability"/>
    <bpmn:endEvent id="end_fulfilled" name="Order Fulfilled"/>
    <bpmn:endEvent id="end_cancelled" name="Order Cancelled"/>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start_order_received" targetRef="task_check_stock"/>
    <bpmn:sequenceFlow id="flow_2" sourceRef="task_check_stock" targetRef="gw_in_stock"/>
    <bpmn:sequenceFlow id="flow_3" sourceRef="gw_in_stock" targetRef="task_charge_card" name="In Stock">
      <bpmn:conditionExpression>= stockAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_1">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="start_order_received_di" bpmnElement="start_order_received">
        <dc:Bounds x="32" y="22" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1" y="62" width="98" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_stock_di" bpmnElement="task_check_stock">
        <dc:Bounds x="160" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_in_stock_di" bpmnElement="gw_in_stock" isMarkerVisible="true">
        <dc:Bounds x="320" y="15" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="313.5" y="69" width="63" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_charge_card_di" bpmnElement="task_charge_card">
        <dc:Bounds x="446" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_ship_order_di" bpmnElement="task_ship_order">
        <dc:Bounds x="0" y="163" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_notify_unavailable_di" bpmnElement="task_notify_unavailable">
        <dc:Bounds x="0" y="323" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_fulfilled_di" bpmnElement="end_fulfilled">
        <dc:Bounds x="32" y="483" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-2.5" y="523" width="105" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_cancelled_di" bpmnElement="end_cancelled">
        <dc:Bounds x="32" y="617" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-2.5" y="657" width="105" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="68" y="40"/>
        <di:waypoint x="160" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="260" y="40"/>
        <di:waypoint x="320" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="370" y="40"/>
        <di:waypoint x="446" y="40"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

