<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_events" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="events" isExecutable="true">
    <bpmn:startEvent id="start"/>
    <bpmn:startEvent id="start2"/>
    <bpmn:startEvent id="startTimerDuration">
      <bpmn:timerEventDefinition id="startTimerDuration_TimerEventDefinition">
        <bpmn:timeDuration>PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:startEvent id="startCron">
      <bpmn:timerEventDefinition id="startCron_TimerEventDefinition"/>
    </bpmn:startEvent>
    <bpmn:startEvent id="startSignal">
      <bpmn:signalEventDefinition id="startSignal_SignalEventDefinition"/>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="catchNoTimer">
      <bpmn:timerEventDefinition id="catchNoTimer_TimerEventDefinition"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="catchBadDuration">
      <bpmn:timerEventDefinition id="catchBadDuration_TimerEventDefinition">
        <bpmn:timeDuration>5 minutes</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="catchDate">
      <bpmn:timerEventDefinition id="catchDate_TimerEventDefinition"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="catchCycle">
      <bpmn:timerEventDefinition id="catchCycle_TimerEventDefinition"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="catchMsgNoRef">
      <bpmn:messageEventDefinition id="catchMsgNoRef_MessageEventDefinition"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="catchMsgNoName">
      <bpmn:messageEventDefinition id="catchMsgNoName_MessageEventDefinition"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="catchMsgNoKey">
      <bpmn:messageEventDefinition id="catchMsgNoKey_MessageEventDefinition"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="catchMsgOk">
      <bpmn:messageEventDefinition id="catchMsgOk_MessageEventDefinition"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="catchLink">
      <bpmn:linkEventDefinition id="catchLink_LinkEventDefinition"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="catchSignalNoName">
      <bpmn:signalEventDefinition id="catchSignalNoName_SignalEventDefinition"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="catchConditional">
      <bpmn:conditionalEventDefinition id="catchConditional_ConditionalEventDefinition">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">=x &gt; 1</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="work" name="Work">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="work"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="boundaryCycle" attachedToRef="work" cancelActivity="true">
      <bpmn:timerEventDefinition id="boundaryCycle_TimerEventDefinition"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="boundaryErrorNoRef" attachedToRef="work" cancelActivity="true">
      <bpmn:errorEventDefinition id="boundaryErrorNoRef_ErrorEventDefinition"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="boundaryErrorExpr" attachedToRef="work" cancelActivity="true">
      <bpmn:errorEventDefinition id="boundaryErrorExpr_ErrorEventDefinition"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="boundaryEscalation" attachedToRef="work" cancelActivity="false">
      <bpmn:escalationEventDefinition id="boundaryEscalation_EscalationEventDefinition"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="boundaryCompensation" attachedToRef="work" cancelActivity="true">
      <bpmn:compensateEventDefinition id="boundaryCompensation_CompensateEventDefinition"/>
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="throwNone"/>
    <bpmn:intermediateThrowEvent id="throwEscalationNoRef">
      <bpmn:escalationEventDefinition id="throwEscalationNoRef_EscalationEventDefinition"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="throwEscalationNoCode">
      <bpmn:escalationEventDefinition id="throwEscalationNoCode_EscalationEventDefinition"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="throwMessage">
      <bpmn:messageEventDefinition id="throwMessage_MessageEventDefinition"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="throwMessageTyped">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send"/>
      </bpmn:extensionElements>
      <bpmn:messageEventDefinition id="throwMessageTyped_MessageEventDefinition"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="throwCompensation">
      <bpmn:compensateEventDefinition id="throwCompensation_CompensateEventDefinition"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="endErrorNoRef">
      <bpmn:errorEventDefinition id="endErrorNoRef_ErrorEventDefinition"/>
    </bpmn:endEvent>
    <bpmn:endEvent id="endErrorNoCode">
      <bpmn:errorEventDefinition id="endErrorNoCode_ErrorEventDefinition"/>
    </bpmn:endEvent>
    <bpmn:endEvent id="endErrorExpr">
      <bpmn:errorEventDefinition id="endErrorExpr_ErrorEventDefinition"/>
    </bpmn:endEvent>
    <bpmn:endEvent id="endTerminate">
      <bpmn:terminateEventDefinition id="endTerminate_TerminateEventDefinition"/>
    </bpmn:endEvent>
    <bpmn:endEvent id="endSignalNoRef">
      <bpmn:signalEventDefinition id="endSignalNoRef_SignalEventDefinition"/>
    </bpmn:endEvent>
    <bpmn:subProcess id="eventSub">
      <bpmn:startEvent id="subTimerCycle">
        <bpmn:timerEventDefinition id="subTimerCycle_TimerEventDefinition"/>
      </bpmn:startEvent>
      <bpmn:endEvent id="subEnd"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="signalSub">
      <bpmn:startEvent id="subSignal">
        <bpmn:signalEventDefinition id="subSignal_SignalEventDefinition"/>
      </bpmn:startEvent>
      <bpmn:endEvent id="subEnd2"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="messageSub">
      <bpmn:startEvent id="subMessage">
        <bpmn:messageEventDefinition id="subMessage_MessageEventDefinition"/>
      </bpmn:startEvent>
      <bpmn:endEvent id="subEnd3"/>
    </bpmn:subProcess>
  </bpmn:process>
