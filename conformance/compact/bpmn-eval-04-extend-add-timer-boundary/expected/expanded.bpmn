<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="order-process" name="Order Process" isExecutable="true">
    <bpmn:startEvent id="Order_received" name="Order received">
      <bpmn:outgoing>Flow_TfkhdPux</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="validate_order" name="Validate order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate:1"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TfkhdPux</bpmn:incoming>
      <bpmn:outgoing>Flow_t5C0Tmzj</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="process_payment" name="Process payment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment:1"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_t5C0Tmzj</bpmn:incoming>
      <bpmn:outgoing>Flow_lIaZ9rfj</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ship_order" name="Ship order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="shipping:1"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_lIaZ9rfj</bpmn:incoming>
      <bpmn:outgoing>Flow_fX8iY50e</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Order_shipped" name="Order shipped">
      <bpmn:incoming>Flow_fX8iY50e</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_TfkhdPux" sourceRef="Order_received" targetRef="validate_order"/>
    <bpmn:sequenceFlow id="Flow_t5C0Tmzj" sourceRef="validate_order" targetRef="process_payment"/>
    <bpmn:sequenceFlow id="Flow_lIaZ9rfj" sourceRef="process_payment" targetRef="ship_order"/>
    <bpmn:sequenceFlow id="Flow_fX8iY50e" sourceRef="ship_order" targetRef="Order_shipped"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_order-process">
    <bpmndi:BPMNPlane id="BPMNPlane_order-process" bpmnElement="order-process">
      <bpmndi:BPMNShape id="Order_received_di" bpmnElement="Order_received">
        <dc:Bounds x="0" y="22" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-31" y="62" width="98" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="validate_order_di" bpmnElement="validate_order">
        <dc:Bounds x="96" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="process_payment_di" bpmnElement="process_payment">
        <dc:Bounds x="256" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ship_order_di" bpmnElement="ship_order">
        <dc:Bounds x="416" y="0" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Order_shipped_di" bpmnElement="Order_shipped">
        <dc:Bounds x="576" y="22" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="548.5" y="62" width="91" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_TfkhdPux_di" bpmnElement="Flow_TfkhdPux">
        <di:waypoint x="36" y="40"/>
        <di:waypoint x="96" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_t5C0Tmzj_di" bpmnElement="Flow_t5C0Tmzj">
        <di:waypoint x="196" y="40"/>
        <di:waypoint x="256" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_lIaZ9rfj_di" bpmnElement="Flow_lIaZ9rfj">
        <di:waypoint x="356" y="40"/>
        <di:waypoint x="416" y="40"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_fX8iY50e_di" bpmnElement="Flow_fX8iY50e">
        <di:waypoint x="516" y="40"/>
        <di:waypoint x="576" y="40"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

