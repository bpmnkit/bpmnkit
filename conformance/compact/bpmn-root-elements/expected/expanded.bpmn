<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_roots" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_roots" name="Root element carrier" isExecutable="true">
    <bpmn:documentation>Process-level documentation.</bpmn:documentation>
    <bpmn:startEvent id="Start_order">
      <bpmn:outgoing>Flow_start_end</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_order_MessageEventDefinition"/>
    </bpmn:startEvent>
    <bpmn:endEvent id="End_done">
      <bpmn:incoming>Flow_start_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_end" sourceRef="Start_order" targetRef="End_done"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_roots">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_roots" bpmnElement="Process_roots">
      <bpmndi:BPMNShape id="Start_order_di" bpmnElement="Start_order">
        <dc:Bounds x="0" y="0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_done_di" bpmnElement="End_done">
        <dc:Bounds x="96" y="0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_end_di" bpmnElement="Flow_start_end">
        <di:waypoint x="36" y="18"/>
        <di:waypoint x="96" y="18"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

