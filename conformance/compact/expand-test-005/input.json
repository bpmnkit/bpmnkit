{
  "id": "Definitions_1",
  "processes": [
    {
      "id": "Process_1",
      "elements": [
        {
          "id": "start",
          "type": "startEvent"
        },
        {
          "id": "call",
          "type": "serviceTask",
          "jobType": "io.camunda:http-json:1",
          "inputs": {
            "authentication.type": "noAuth",
            "method": "GET",
            "url": "https://x.example"
          },
          "taskHeaders": {
            "retryBackoff": "PT1S"
          },
          "resultVariable": "out",
          "modelerTemplate": {
            "id": "io.camunda.connectors.HttpJson.v2",
            "version": 1
          }
        },
        {
          "id": "end",
          "type": "endEvent"
        }
      ],
      "flows": [
        {
          "id": "f1",
          "from": "start",
          "to": "call"
        },
        {
          "id": "f2",
          "from": "call",
          "to": "end"
        }
      ]
    }
  ]
}
