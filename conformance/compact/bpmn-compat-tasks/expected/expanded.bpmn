      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="scriptFeel_di" bpmnElement="scriptFeel">
        <dc:Bounds x="131" y="736" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="scriptNone_di" bpmnElement="scriptNone">
        <dc:Bounds x="131" y="896" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="brtNoResult_di" bpmnElement="brtNoResult">
        <dc:Bounds x="131" y="1056" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="brtBinding_di" bpmnElement="brtBinding">
        <dc:Bounds x="131" y="1216" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="brtTagExpr_di" bpmnElement="brtTagExpr">
        <dc:Bounds x="131" y="1376" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="callNoProcess_di" bpmnElement="callNoProcess">
        <dc:Bounds x="131" y="1536" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="callOptions_di" bpmnElement="callOptions">
        <dc:Bounds x="131" y="1696" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sendNoType_di" bpmnElement="sendNoType">
        <dc:Bounds x="131" y="1856" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="receiveNoRef_di" bpmnElement="receiveNoRef">
        <dc:Bounds x="131" y="2016" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="receiveOk_di" bpmnElement="receiveOk">
        <dc:Bounds x="131" y="2176" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="jobWorkerTask_di" bpmnElement="jobWorkerTask">
        <dc:Bounds x="131" y="2336" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="zeebeTask_di" bpmnElement="zeebeTask">
        <dc:Bounds x="131" y="2496" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="noForm_di" bpmnElement="noForm">
        <dc:Bounds x="131" y="2656" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="zeebeTaskOk_di" bpmnElement="zeebeTaskOk">
        <dc:Bounds x="131" y="2816" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="multi_di" bpmnElement="multi">
        <dc:Bounds x="131" y="2976" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="multiNoZeebe_di" bpmnElement="multiNoZeebe">
        <dc:Bounds x="131" y="3136" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="complex_di" bpmnElement="complex">
        <dc:Bounds x="156" y="3296" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="joinInclusive_di" bpmnElement="joinInclusive">
        <dc:Bounds x="622" y="131" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="split_di" bpmnElement="split" isMarkerVisible="true">
        <dc:Bounds x="156" y="131" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="eventGateway_di" bpmnElement="eventGateway">
        <dc:Bounds x="156" y="3441" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="afterEventGateway_di" bpmnElement="afterEventGateway">
        <dc:Bounds x="462" y="3426" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="collapsed_di" bpmnElement="collapsed" isExpanded="true">
        <dc:Bounds x="113" y="3586" width="136" height="136"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tx_di" bpmnElement="tx" isExpanded="true">
        <dc:Bounds x="113" y="3802" width="136" height="136"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="adHocEmpty_di" bpmnElement="adHocEmpty" isExpanded="true">
        <dc:Bounds x="0" y="4018" width="362" height="236"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="collapsedStart_di" bpmnElement="collapsedStart">
        <dc:Bounds x="163" y="3636" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="txStart_di" bpmnElement="txStart">
        <dc:Bounds x="163" y="3852" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="adHocThrow_di" bpmnElement="adHocThrow">
        <dc:Bounds x="50" y="4118" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="adHocEventSub_di" bpmnElement="adHocEventSub" isExpanded="true">
        <dc:Bounds x="176" y="4068" width="136" height="136"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="adHocEventStart_di" bpmnElement="adHocEventStart">
        <dc:Bounds x="226" y="4118" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flowA_di" bpmnElement="flowA">
        <di:waypoint x="562" y="296"/>
        <di:waypoint x="592" y="296"/>
        <di:waypoint x="592" y="156"/>
        <di:waypoint x="622" y="156"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flowB_di" bpmnElement="flowB">
        <di:waypoint x="562" y="156"/>
        <di:waypoint x="622" y="156"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flowNoCondition_di" bpmnElement="flowNoCondition">
        <di:waypoint x="181" y="181"/>
        <di:waypoint x="181" y="296"/>
        <di:waypoint x="462" y="296"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flowDefault_di" bpmnElement="flowDefault">
        <di:waypoint x="206" y="156"/>
        <di:waypoint x="462" y="156"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flowConditionFromTask_di" bpmnElement="flowConditionFromTask">
        <di:waypoint x="231" y="456"/>
        <di:waypoint x="462" y="456"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flowEventGateway_di" bpmnElement="flowEventGateway">
        <di:waypoint x="206" y="3466"/>
        <di:waypoint x="462" y="3466"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_notExecutable">
    <bpmndi:BPMNPlane id="BPMNPlane_notExecutable" bpmnElement="notExecutable">
      <bpmndi:BPMNShape id="complexInNonExecutable_di" bpmnElement="complexInNonExecutable">
        <dc:Bounds x="0" y="0" width="50" height="50"/>
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

