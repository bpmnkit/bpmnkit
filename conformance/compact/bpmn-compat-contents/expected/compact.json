          "type": "adHocSubProcess"
        },
        {
          "id": "secretsTask",
          "inputs": {
            "apiKey": "secrets.API_KEY",
            "ok": "=camunda.secrets.OK",
            "token": "{{secrets.TOKEN}}"
          },
          "jobType": "t",
          "properties": {
            "auth": "Bearer {{secrets.AUTH}}"
          },
          "type": "serviceTask"
        },
        {
          "id": "secretReceive",
          "type": "receiveTask"
        },
        {
          "id": "secretLiteral",
          "inputs": {
            "a": "camunda.secrets.PLAIN"
          },
          "jobType": "t",
          "type": "serviceTask"
        },
        {
          "id": "secretQuoted",
          "inputs": {
            "a": "=\"Bearer camunda.secrets.QUOTED\""
          },
          "jobType": "t",
          "type": "serviceTask"
        },
        {
          "id": "secretProperty",
          "jobType": "t",
          "properties": {
            "p": "camunda.secrets.PROP"
          },
          "type": "serviceTask"
        },
        {
          "id": "secretList",
          "inputs": {
            "a": "={keys: [camunda.secrets.A, camunda.secrets.B]}"
          },
          "jobType": "t",
          "type": "serviceTask"
        },
        {
          "id": "secretIfContext",
          "inputs": {
            "a": "=if prod then {key: camunda.secrets.PROD} else null"
          },
          "jobType": "t",
          "type": "serviceTask"
        },
        {
          "id": "secretFine",
          "inputs": {
            "a": "={auth: {key: camunda.secrets.A}}",
            "b": "=([camunda.secrets.B])",
            "c": "=camunda.secrets.C.value",
            "d": "=if prod then camunda.secrets.D else null"
          },
          "jobType": "t",
          "type": "serviceTask"
        },
