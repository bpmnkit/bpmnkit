          "jobType": "t",
          "taskHeaders": {
            "k": "=uuid()"
          },
          "type": "serviceTask"
        },
        {
          "eventType": "timer",
          "id": "feelTimer",
          "type": "intermediateCatchEvent"
        },
        {
          "id": "badVars",
          "inputs": {
            "1st": "=1"
          },
          "jobType": "t",
