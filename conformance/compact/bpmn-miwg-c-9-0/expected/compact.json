          "id": "BusinessRuleTask_CheckApplicationAutomatically",
          "name": "Check application automatically",
          "outputs": {
            "riskLevels": "= if result != null then result.riskLevel else [\"green\"]",
            "risks": "= if result != null then result.risk else []"
          },
          "resultVariable": "result",
          "type": "businessRuleTask"
        },
        {
          "documentation": "Gets credit score for prospect client",
