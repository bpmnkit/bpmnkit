<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="_5SVkEIXnEeSmwfgVk-ryvQ" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <bpmn:error id="Error_x" name="00" errorCode="00"/>
  <bpmn:error id="Error_x_2" name="02" errorCode="02"/>
  <bpmn:message id="Message_Message_CancellationRequested" name="Message_CancellationRequested">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=01"/>
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="customer_onboarding_en" name="Customer Onboarding" isExecutable="true">
    <bpmn:startEvent id="StartEvent_ApplicationReceived" name="Application received">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="= string(now())" target="documentReferenceId"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>SequenceFlow_6</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="Activity_1ke2ixr" triggeredByEvent="true">
      <bpmn:endEvent id="EndMessageEvent_Timeout" name="Timeout handled">
        <bpmn:documentation>Ends the subprocess and send message timeout handled</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="timeoutHandled"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0dppbeu</bpmn:incoming>
        <bpmn:messageEventDefinition id="EndMessageEvent_Timeout_MessageEventDefinition"/>
      </bpmn:endEvent>
      <bpmn:startEvent id="StartErrorEvent_Timeout" name="Timeout">
        <bpmn:documentation>Catches timeout error event and starts the subprocess</bpmn:documentation>
        <bpmn:outgoing>Flow_151qlxc</bpmn:outgoing>
        <bpmn:errorEventDefinition id="StartErrorEvent_Timeout_ErrorEventDefinition" errorRef="Error_x"/>
      </bpmn:startEvent>
      <bpmn:userTask id="UserTask_HandleTimeout" name="Handle Timeout">
        <bpmn:documentation>Manually handles the timeout</bpmn:documentation>
        <bpmn:incoming>Flow_151qlxc</bpmn:incoming>
        <bpmn:outgoing>Flow_0dppbeu</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_151qlxc" sourceRef="StartErrorEvent_Timeout" targetRef="UserTask_HandleTimeout"/>
      <bpmn:sequenceFlow id="Flow_0dppbeu" sourceRef="UserTask_HandleTimeout" targetRef="EndMessageEvent_Timeout"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="Activity_0vp33kx" triggeredByEvent="true">
      <bpmn:startEvent id="StartMessageEvent_CancellationRequested" name="Cancelation requested">
        <bpmn:documentation>Customer onboarding cancellation message received</bpmn:documentation>
        <bpmn:outgoing>Flow_12nmks0</bpmn:outgoing>
        <bpmn:messageEventDefinition id="StartMessageEvent_CancellationRequested_MessageEventDefinition" messageRef="Message_Message_CancellationRequested"/>
      </bpmn:startEvent>
      <bpmn:serviceTask id="ServiceTask_CancelApplication" name="Cancel application">
        <bpmn:documentation>Cancel application</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="cancelApplication"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_12nmks0</bpmn:incoming>
        <bpmn:outgoing>Flow_19iipc6</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndMessageEvent_InformCustomer" name="Customer notified about successful cancelation">
        <bpmn:documentation>Inform customer of a successful cancelation</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="informCustomerSuccessfulCancelation"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0qrakss</bpmn:incoming>
        <bpmn:messageEventDefinition id="EndMessageEvent_InformCustomer_MessageEventDefinition"/>
      </bpmn:endEvent>
      <bpmn:parallelGateway id="ParallelGateway_CancelApplication">
        <bpmn:incoming>Flow_19iipc6</bpmn:incoming>
        <bpmn:outgoing>Flow_0qrakss</bpmn:outgoing>
        <bpmn:outgoing>Flow_1jml1az</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="EndMessageEvent_InformOperations" name="Operations Team notified about successful cancelation">
        <bpmn:documentation>Inform operations team of a successful cancelation</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="informOperationsSuccessfulCancelation"/>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_1jml1az</bpmn:incoming>
        <bpmn:messageEventDefinition id="EndMessageEvent_InformOperations_MessageEventDefinition"/>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_12nmks0" sourceRef="StartMessageEvent_CancellationRequested" targetRef="ServiceTask_CancelApplication"/>
      <bpmn:sequenceFlow id="Flow_19iipc6" sourceRef="ServiceTask_CancelApplication" targetRef="ParallelGateway_CancelApplication"/>
      <bpmn:sequenceFlow id="Flow_0qrakss" sourceRef="ParallelGateway_CancelApplication" targetRef="EndMessageEvent_InformCustomer"/>
      <bpmn:sequenceFlow id="Flow_1jml1az" sourceRef="ParallelGateway_CancelApplication" targetRef="EndMessageEvent_InformOperations"/>
    </bpmn:subProcess>
    <bpmn:callActivity id="Activity_ManualCheck" name="Manual Check">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="ManualCheck"/>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_Yellow</bpmn:incoming>
      <bpmn:outgoing>Flow_0ik8h65</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="EndEvent_ApplicationIssued" name="Application&#10; issued">
      <bpmn:documentation>Customer onboarding process end application issued</bpmn:documentation>
      <bpmn:incoming>SequenceFlow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="SendTask_SendPolicy" zeebe:modelerTemplate="io.camunda.connectors.SendGrid.v1.template" name="Send confirmation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:sendgrid:1"/>
        <zeebe:ioMapping>
          <zeebe:input source="demo@camunda.com" target="from.email"/>
          <zeebe:input source="d-0d0120b0c7f148ef8a1c262f2cf07092" target="template.id"/>
          <zeebe:input source="secrets.SENDGRID_DEMO" target="apiKey"/>
          <zeebe:input source="= corporation" target="from.name"/>
          <zeebe:input source="= applicant.name" target="to.name"/>
          <zeebe:input source="= applicant.email" target="to.email"/>
          <zeebe:input source="= {&#10;    &quot;name&quot;: applicant.name,&#10;    &quot;applicationNumber&quot;: applicationNumber,&#10;    &quot;product&quot;: product&#10;}" target="template.data"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_10</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_DeliverPolicy" name="Deliver confirmation">
      <bpmn:documentation>Deliver policy</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="issuePolicy"/>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_Green</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ApplicationAccepted</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_Decision" name="Decision?">
      <bpmn:incoming>Flow_0ik8h65</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ApplicationAccepted</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ApplicationDeclined</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_ApplicationRejected" name="Application &#10;rejected">
      <bpmn:documentation>Customer onboarding process end application rejected</bpmn:documentation>
      <bpmn:incoming>SequenceFlow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ServiceTask_RejectPolicy" name="Reject application">
      <bpmn:documentation>Reject policy</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="rejectPolicy"/>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_Red</bpmn:incoming>
      <bpmn:incoming>SequenceFlow_ApplicationDeclined</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_01vh1zw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="SendTask_SendRejection" zeebe:modelerTemplate="io.camunda.connectors.SendGrid.v1.template" name="Send rejection">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:sendgrid:1"/>
        <zeebe:ioMapping>
          <zeebe:input source="secrets.SENDGRID_DEMO" target="apiKey"/>
          <zeebe:input source="demo@camunda.com" target="from.email"/>
          <zeebe:input source="d-aa6a58aaded54a83884518433ac2dd56" target="template.id"/>
          <zeebe:input source="= {&#10;    &quot;name&quot;: applicant.name&#10;}" target="template.data"/>
          <zeebe:input source="= applicant.email" target="to.email"/>
          <zeebe:input source="= applicant.name" target="to.name"/>
          <zeebe:input source="= corporation" target="from.name"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_01vh1zw</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="ErrorBoundaryEvent_FraudDetected" name="Fraud detected" attachedToRef="Activity_ManualCheck" cancelActivity="true">
      <bpmn:documentation>Captures error if fraud is detected</bpmn:documentation>
      <bpmn:outgoing>Flow_177paze</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorBoundaryEvent_FraudDetected_ErrorEventDefinition" errorRef="Error_x_2"/>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="SendTask_ReportFraud" name="Report fraud">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reportFraud"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_177paze</bpmn:incoming>
      <bpmn:outgoing>Flow_0cvhizd</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="TerminateEvent_ApplicationCanceledFraud" name="Application canceled due to fraud">
      <bpmn:documentation>Customer onboarding process terminated due to fraud</bpmn:documentation>
      <bpmn:incoming>Flow_0cvhizd</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEvent_ApplicationCanceledFraud_TerminateEventDefinition"/>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="ExclusiveGateway_Risk" name="Risk?" default="SequenceFlow_Green">
      <bpmn:documentation>Route process based on risk, "green" automatic onboarding, "yellow" manual check, "red" automatic rejection</bpmn:documentation>
      <bpmn:incoming>SequenceFlow_2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Red</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Green</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Yellow</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="BusinessRuleTask_CheckApplicationAutomatically" name="Check application automatically">
      <bpmn:documentation>Identify risk for prospect client</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="risk_check" resultVariable="result"/>
        <zeebe:ioMapping>
          <zeebe:output source="= if result != null then result.riskLevel else [&quot;green&quot;]" target="riskLevels"/>
          <zeebe:output source="= if result != null then result.risk else []" target="risks"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_1gd6p37</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="ServiceTask_GetCreditScore" name="Get credit score">
      <bpmn:documentation>Gets credit score for prospect client</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="calculateScore"/>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_6</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_1gd6p37</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="SequenceFlow_1gd6p37" sourceRef="ServiceTask_GetCreditScore" targetRef="BusinessRuleTask_CheckApplicationAutomatically"/>
    <bpmn:sequenceFlow id="SequenceFlow_01vh1zw" sourceRef="ServiceTask_RejectPolicy" targetRef="SendTask_SendRejection"/>
    <bpmn:sequenceFlow id="SequenceFlow_13" sourceRef="SendTask_SendRejection" targetRef="EndEvent_ApplicationRejected"/>
    <bpmn:sequenceFlow id="SequenceFlow_Red" sourceRef="ExclusiveGateway_Risk" targetRef="ServiceTask_RejectPolicy" name="Red (severe risk)">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= some risk in riskLevels satisfies risk = "red"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_2" sourceRef="BusinessRuleTask_CheckApplicationAutomatically" targetRef="ExclusiveGateway_Risk"/>
    <bpmn:sequenceFlow id="SequenceFlow_Green" sourceRef="ExclusiveGateway_Risk" targetRef="ServiceTask_DeliverPolicy" name="Green (no risk)"/>
    <bpmn:sequenceFlow id="SequenceFlow_10" sourceRef="ServiceTask_DeliverPolicy" targetRef="SendTask_SendPolicy"/>
    <bpmn:sequenceFlow id="SequenceFlow_11" sourceRef="SendTask_SendPolicy" targetRef="EndEvent_ApplicationIssued"/>
    <bpmn:sequenceFlow id="SequenceFlow_ApplicationAccepted" sourceRef="ExclusiveGateway_Decision" targetRef="ServiceTask_DeliverPolicy" name="Application accepted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= approved </bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_ApplicationDeclined" sourceRef="ExclusiveGateway_Decision" targetRef="ServiceTask_RejectPolicy" name="Application declined">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= not(approved)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_6" sourceRef="StartEvent_ApplicationReceived" targetRef="ServiceTask_GetCreditScore"/>
    <bpmn:sequenceFlow id="SequenceFlow_Yellow" sourceRef="ExclusiveGateway_Risk" targetRef="Activity_ManualCheck" name="Yellow (moderate risk)">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= every risk in riskLevels satisfies risk = "yellow"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0ik8h65" sourceRef="Activity_ManualCheck" targetRef="ExclusiveGateway_Decision"/>
    <bpmn:sequenceFlow id="Flow_177paze" sourceRef="ErrorBoundaryEvent_FraudDetected" targetRef="SendTask_ReportFraud"/>
    <bpmn:sequenceFlow id="Flow_0cvhizd" sourceRef="SendTask_ReportFraud" targetRef="TerminateEvent_ApplicationCanceledFraud"/>
  </bpmn:process>
