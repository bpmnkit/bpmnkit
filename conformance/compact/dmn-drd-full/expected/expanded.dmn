  <decision id="final" name="Final decision">
    <informationRequirement id="InformationRequirement_0000001">
      <requiredDecision href="#intermediate"/>
    </informationRequirement>
    <informationRequirement id="InformationRequirement_0000002">
      <requiredInput href="#applicant"/>
    </informationRequirement>
    <decisionTable id="decisionTable_0000006" hitPolicy="FIRST">
      <input id="i_final">
        <inputExpression id="inputExpression_0000003" typeRef="string">
          <text>level</text>
        </inputExpression>
      </input>
      <output id="o_final" name="approved" typeRef="boolean"/>
      <rule id="r_final">
        <inputEntry id="inputEntry_0_0000004">
          <text>"high"</text>
        </inputEntry>
        <outputEntry id="outputEntry_0_0000005">
          <text>false</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <decision id="intermediate" name="Intermediate">
    <informationRequirement id="InformationRequirement_0000007">
