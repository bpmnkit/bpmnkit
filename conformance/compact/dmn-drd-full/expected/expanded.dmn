    </informationRequirement>
    <decisionTable id="decisionTable_0000009">
      <input id="i_int">
        <inputExpression id="inputExpression_0000008" typeRef="number">
          <text>applicant.age</text>
        </inputExpression>
      </input>
      <output id="o_int" name="level" typeRef="string"/>
    </decisionTable>
  </decision>
  <inputData id="applicant" name="Applicant"/>
  <inputData id="unnamed"/>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram>
      <dmndi:DMNShape dmnElementRef="applicant">
        <dc:Bounds height="45" width="125" x="160" y="100"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape dmnElementRef="unnamed">
        <dc:Bounds height="45" width="125" x="160" y="185"/>
      </dmndi:DMNShape>
