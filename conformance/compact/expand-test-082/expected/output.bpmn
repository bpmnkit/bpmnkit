        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="box_di" bpmnElement="box" isExpanded="true">
        <dc:Bounds x="136" y="60" width="200" height="208"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
