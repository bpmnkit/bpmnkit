          <dc:Bounds x="659" y="358" width="70" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_02_di" bpmnElement="Participant_02" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="766.5" height="396"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="SequenceFlow_6_di" bpmnElement="SequenceFlow_6">
        <di:waypoint x="454" y="60"/>
        <di:waypoint x="546" y="60"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_0i97ejj_di" bpmnElement="SequenceFlow_0i97ejj">
