        <di:waypoint x="421" y="196"/>
        <di:waypoint x="514" y="196"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="SequenceFlow_1bqpxlf_di" bpmnElement="SequenceFlow_1bqpxlf">
