        <bpmndi:BPMNLabel>
          <dc:Bounds x="50" y="82" width="126" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent_1_di" bpmnElement="BoundaryEvent_1">
        <dc:Bounds x="369" y="82" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="343" y="122" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent_2_di" bpmnElement="BoundaryEvent_2">
        <dc:Bounds x="403" y="82" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="425" y="122" width="42" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ReminderSent_di" bpmnElement="EndEvent_ReminderSent">
