<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" id="Definitions_prefixed" name="Prefixed" namespace="http://bpmn.io/schema/dmn">
  <decision id="d1" name="Prefixed decision">
    <informationRequirement id="InformationRequirement_0000001">
      <requiredInput href="#in1"/>
    </informationRequirement>
    <decisionTable id="decisionTable_0000005" hitPolicy="COLLECT" aggregation="SUM">
      <input id="i1" label="Amount">
        <inputExpression id="inputExpression_0000002" typeRef="number">
          <text>amount</text>
        </inputExpression>
      </input>
      <output id="o1" name="fee" typeRef="number"/>
      <rule id="r1">
        <description>fee for any amount</description>
        <inputEntry id="inputEntry_0_0000003">
          <text>&gt; 0</text>
        </inputEntry>
        <outputEntry id="outputEntry_0_0000004">
          <text>2.5</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <inputData id="in1" name="Amount"/>
  <dmndi:DMNDI>
    <dmndi:DMNDiagram>
      <dmndi:DMNShape dmnElementRef="in1">
        <dc:Bounds height="45" width="125" x="160" y="117.5"/>
      </dmndi:DMNShape>
      <dmndi:DMNShape dmnElementRef="d1">
        <dc:Bounds height="80" width="180" x="345" y="100"/>
      </dmndi:DMNShape>
      <dmndi:DMNEdge dmnElementRef="InformationRequirement_0000001">
        <di:waypoint x="285" y="140"/>
        <di:waypoint x="345" y="140"/>
      </dmndi:DMNEdge>
    </dmndi:DMNDiagram>
  </dmndi:DMNDI>
</definitions>

