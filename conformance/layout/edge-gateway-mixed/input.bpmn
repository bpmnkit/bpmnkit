<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="S" name="Start">
      <bpmn:outgoing>f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:inclusiveGateway id="I" name="Which?" default="id">
      <bpmn:incoming>f0</bpmn:incoming>
      <bpmn:outgoing>ia</bpmn:outgoing>
      <bpmn:outgoing>ib</bpmn:outgoing>
      <bpmn:outgoing>id</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="A" name="A">
      <bpmn:incoming>ia</bpmn:incoming>
      <bpmn:outgoing>ja</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B" name="B">
      <bpmn:incoming>ib</bpmn:incoming>
      <bpmn:outgoing>jb</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="IJ">
      <bpmn:incoming>ja</bpmn:incoming>
      <bpmn:incoming>jb</bpmn:incoming>
      <bpmn:outgoing>jx</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:eventBasedGateway id="EB" name="Wait for">
      <bpmn:incoming>id</bpmn:incoming>
      <bpmn:outgoing>eb1</bpmn:outgoing>
      <bpmn:outgoing>eb2</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Msg" name="Reply">
      <bpmn:incoming>eb1</bpmn:incoming>
      <bpmn:outgoing>m1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="m1_def"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Tm" name="Timeout">
      <bpmn:incoming>eb2</bpmn:incoming>
      <bpmn:outgoing>t1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="t1_def">
        <bpmn:timeDuration>PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:complexGateway id="CX" name="Complex">
      <bpmn:incoming>jx</bpmn:incoming>
      <bpmn:outgoing>c1</bpmn:outgoing>
      <bpmn:outgoing>c2</bpmn:outgoing>
    </bpmn:complexGateway>
    <bpmn:task id="C" name="C">
      <bpmn:incoming>c1</bpmn:incoming>
      <bpmn:outgoing>c3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="D" name="D">
      <bpmn:incoming>c2</bpmn:incoming>
      <bpmn:outgoing>c4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E" name="End">
      <bpmn:incoming>m1</bpmn:incoming>
      <bpmn:incoming>c3</bpmn:incoming>
      <bpmn:incoming>c4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="E2" name="Timed out">
      <bpmn:incoming>t1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f0" sourceRef="S" targetRef="I"/>
    <bpmn:sequenceFlow id="ia" sourceRef="I" targetRef="A" name="a">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=x &gt; 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ib" sourceRef="I" targetRef="B" name="b">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=y &gt; 1</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="id" sourceRef="I" targetRef="EB" name="else"/>
    <bpmn:sequenceFlow id="ja" sourceRef="A" targetRef="IJ"/>
    <bpmn:sequenceFlow id="jb" sourceRef="B" targetRef="IJ"/>
    <bpmn:sequenceFlow id="jx" sourceRef="IJ" targetRef="CX"/>
    <bpmn:sequenceFlow id="eb1" sourceRef="EB" targetRef="Msg"/>
    <bpmn:sequenceFlow id="eb2" sourceRef="EB" targetRef="Tm"/>
    <bpmn:sequenceFlow id="m1" sourceRef="Msg" targetRef="E"/>
    <bpmn:sequenceFlow id="t1" sourceRef="Tm" targetRef="E2"/>
    <bpmn:sequenceFlow id="c1" sourceRef="CX" targetRef="C"/>
    <bpmn:sequenceFlow id="c2" sourceRef="CX" targetRef="D"/>
    <bpmn:sequenceFlow id="c3" sourceRef="C" targetRef="E"/>
    <bpmn:sequenceFlow id="c4" sourceRef="D" targetRef="E"/>
  </bpmn:process>
</bpmn:definitions>

