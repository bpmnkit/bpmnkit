<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:process id="P" isExecutable="true">
<bpmn:startEvent id="S" name="Start" /><bpmn:inclusiveGateway id="I" name="Which?" default="id" /><bpmn:task id="A" name="A" /><bpmn:task id="B" name="B" /><bpmn:inclusiveGateway id="IJ" />
<bpmn:eventBasedGateway id="EB" name="Wait for" /><bpmn:intermediateCatchEvent id="Msg" name="Reply"><bpmn:messageEventDefinition id="m1" /></bpmn:intermediateCatchEvent><bpmn:intermediateCatchEvent id="Tm" name="Timeout"><bpmn:timerEventDefinition id="t1"><bpmn:timeDuration>PT1H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
<bpmn:complexGateway id="CX" name="Complex" /><bpmn:task id="C" name="C" /><bpmn:task id="D" name="D" /><bpmn:endEvent id="E" name="End" /><bpmn:endEvent id="E2" name="Timed out" />
<bpmn:sequenceFlow id="f0" sourceRef="S" targetRef="I" /><bpmn:sequenceFlow id="ia" sourceRef="I" targetRef="A" name="a"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=x > 1</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="ib" sourceRef="I" targetRef="B" name="b"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=y > 1</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="id" sourceRef="I" targetRef="EB" name="else" /><bpmn:sequenceFlow id="ja" sourceRef="A" targetRef="IJ" /><bpmn:sequenceFlow id="jb" sourceRef="B" targetRef="IJ" /><bpmn:sequenceFlow id="jx" sourceRef="IJ" targetRef="CX" />
<bpmn:sequenceFlow id="eb1" sourceRef="EB" targetRef="Msg" /><bpmn:sequenceFlow id="eb2" sourceRef="EB" targetRef="Tm" /><bpmn:sequenceFlow id="m1" sourceRef="Msg" targetRef="E" /><bpmn:sequenceFlow id="t1" sourceRef="Tm" targetRef="E2" /><bpmn:sequenceFlow id="c1" sourceRef="CX" targetRef="C" /><bpmn:sequenceFlow id="c2" sourceRef="CX" targetRef="D" /><bpmn:sequenceFlow id="c3" sourceRef="C" targetRef="E" /><bpmn:sequenceFlow id="c4" sourceRef="D" targetRef="E" />
</bpmn:process>
</bpmn:definitions>
