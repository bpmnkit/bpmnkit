<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:process id="P" name="Nested lanes" isExecutable="true">
<bpmn:laneSet id="LS">
<bpmn:lane id="Outer1" name="Operations"><bpmn:childLaneSet id="CLS1">
<bpmn:lane id="In1" name="Intake"><bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>A</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="In2" name="Review"><bpmn:flowNodeRef>B</bpmn:flowNodeRef></bpmn:lane>
</bpmn:childLaneSet></bpmn:lane>
<bpmn:lane id="Outer2" name="Management"><bpmn:flowNodeRef>C</bpmn:flowNodeRef><bpmn:flowNodeRef>E</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S" name="Start" /><bpmn:task id="A" name="Collect" /><bpmn:task id="B" name="Review" /><bpmn:task id="C" name="Sign off" /><bpmn:endEvent id="E" name="End" />
<bpmn:sequenceFlow id="f1" sourceRef="S" targetRef="A" />
<bpmn:sequenceFlow id="f2" sourceRef="A" targetRef="B" />
<bpmn:sequenceFlow id="f3" sourceRef="B" targetRef="C" />
<bpmn:sequenceFlow id="f4" sourceRef="C" targetRef="E" />
</bpmn:process>
</bpmn:definitions>
