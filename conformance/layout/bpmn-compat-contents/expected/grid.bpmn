    <bpmndi:BPMNPlane id="BPMNPlane_recursive" bpmnElement="recursive">
      <bpmndi:BPMNShape id="recursiveStart_di" bpmnElement="recursiveStart">
        <dc:Bounds x="20" y="42" width="36" height="36"/>
      </bpmndi:BPMNShape>
