        <di:waypoint x="820" y="130"/>
        <di:waypoint x="520" y="130"/>
        <di:waypoint x="520" y="100"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_waits">
    <bpmndi:BPMNPlane id="BPMNPlane_waits" bpmnElement="waits">
      <bpmndi:BPMNShape id="waitsStart_di" bpmnElement="waitsStart">
        <dc:Bounds x="20" y="42" width="36" height="36"/>
      </bpmndi:BPMNShape>
