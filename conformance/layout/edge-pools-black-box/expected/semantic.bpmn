<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="C">
    <bpmn:participant id="PA" name="Our process" processRef="Pr"/>
    <bpmn:participant id="BB1" name="Partner API"/>
    <bpmn:participant id="BB2" name="Customer"/>
    <bpmn:messageFlow id="m1" sourceRef="Pr_call" targetRef="BB1" name="request"/>
    <bpmn:messageFlow id="m2" sourceRef="BB1" targetRef="Pr_wait" name="response"/>
    <bpmn:messageFlow id="m3" sourceRef="BB2" targetRef="Pr_s"/>
    <bpmn:messageFlow id="m4" sourceRef="Pr_e" targetRef="BB2"/>
  </bpmn:collaboration>
  <bpmn:process id="Pr" isExecutable="true">
    <bpmn:startEvent id="Pr_s" name="Start"/>
    <bpmn:sendTask id="Pr_call" name="Call partner"/>
    <bpmn:receiveTask id="Pr_wait" name="Wait for reply"/>
    <bpmn:endEvent id="Pr_e" name="End"/>
    <bpmn:sequenceFlow id="f1" sourceRef="Pr_s" targetRef="Pr_call"/>
    <bpmn:sequenceFlow id="f2" sourceRef="Pr_call" targetRef="Pr_wait"/>
    <bpmn:sequenceFlow id="f3" sourceRef="Pr_wait" targetRef="Pr_e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="C">
      <bpmndi:BPMNShape id="BB1_di" bpmnElement="BB1" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="526" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pr_s_di" bpmnElement="Pr_s">
        <dc:Bounds x="52" y="132" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="50" y="172" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pr_call_di" bpmnElement="Pr_call">
        <dc:Bounds x="148" y="110" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pr_wait_di" bpmnElement="Pr_wait">
        <dc:Bounds x="308" y="110" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pr_e_di" bpmnElement="Pr_e">
        <dc:Bounds x="468" y="132" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="466" y="172" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PA_di" bpmnElement="PA" isHorizontal="true">
        <dc:Bounds x="0" y="90" width="526" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BB2_di" bpmnElement="BB2" isHorizontal="true">
        <dc:Bounds x="0" y="240" width="526" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="88" y="150"/>
        <di:waypoint x="148" y="150"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="248" y="150"/>
        <di:waypoint x="308" y="150"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="408" y="150"/>
        <di:waypoint x="468" y="150"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m1_di" bpmnElement="m1">
        <di:waypoint x="198" y="110"/>
        <di:waypoint x="198" y="60"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m2_di" bpmnElement="m2">
        <di:waypoint x="358" y="60"/>
        <di:waypoint x="358" y="110"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m3_di" bpmnElement="m3">
        <di:waypoint x="70" y="240"/>
        <di:waypoint x="70" y="168"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m4_di" bpmnElement="m4">
        <di:waypoint x="486" y="168"/>
        <di:waypoint x="486" y="240"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

