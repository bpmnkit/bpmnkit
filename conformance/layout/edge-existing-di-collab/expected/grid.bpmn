<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="C">
    <bpmn:participant id="PA" name="Main" processRef="P"/>
    <bpmn:participant id="PB" name="Other" processRef="P2"/>
    <bpmn:messageFlow id="m1" sourceRef="A" targetRef="Q"/>
  </bpmn:collaboration>
  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="S" name="Start"/>
    <bpmn:task id="A" name="Task"/>
    <bpmn:subProcess id="Sub" name="Folded">
      <bpmn:task id="In" name="Inner"/>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="f1" sourceRef="S" targetRef="A"/>
    <bpmn:sequenceFlow id="f2" sourceRef="A" targetRef="Sub"/>
  </bpmn:process>
  <bpmn:process id="P2" isExecutable="true">
    <bpmn:task id="Q" name="Other task"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="C">
      <bpmndi:BPMNShape id="S_di" bpmnElement="S">
        <dc:Bounds x="52" y="42" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="50" y="82" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A_di" bpmnElement="A">
        <dc:Bounds x="170" y="20" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_di" bpmnElement="Sub" isExpanded="true">
        <dc:Bounds x="320" y="20" width="250" height="220"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="In_di" bpmnElement="In">
        <dc:Bounds x="395" y="90" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PA_di" bpmnElement="PA" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="590" height="260"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Q_di" bpmnElement="Q">
        <dc:Bounds x="170" y="310" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PB_di" bpmnElement="PB" isHorizontal="true">
        <dc:Bounds x="0" y="290" width="290" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="88" y="60"/>
        <di:waypoint x="170" y="60"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="270" y="60"/>
        <di:waypoint x="320" y="60"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="m1_di" bpmnElement="m1">
        <di:waypoint x="220" y="100"/>
        <di:waypoint x="220" y="310"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

