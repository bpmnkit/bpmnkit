<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="P" name="Boundary events" isExecutable="true">
    <bpmn:startEvent id="S" name="Start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="T1" name="Call service">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="B1" name="Failed" attachedToRef="T1">
      <bpmn:outgoing>b1</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ed1"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B2" name="Too slow" attachedToRef="T1">
      <bpmn:outgoing>b2</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ed2">
        <bpmn:timeDuration>PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B3" name="Reminder" attachedToRef="T1" cancelActivity="false">
      <bpmn:outgoing>b3</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ed3">
        <bpmn:timeDuration>PT1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B4" name="Escalate" attachedToRef="T1" cancelActivity="false">
      <bpmn:outgoing>b4</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="ed4"/>
    </bpmn:boundaryEvent>
    <bpmn:task id="Fix" name="Fix manually">
      <bpmn:incoming>b1</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Remind" name="Send reminder">
      <bpmn:incoming>b3</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Esc" name="Escalate">
      <bpmn:incoming>b4</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Cancel" name="Cancel order">
      <bpmn:incoming>b2</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="T2" name="Next step">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="Sub" name="Fulfilment">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:startEvent id="SS" name="Begin">
        <bpmn:outgoing>sf1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="ST" name="Inner">
        <bpmn:incoming>sf1</bpmn:incoming>
        <bpmn:outgoing>sf2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="SE" name="Finish">
        <bpmn:incoming>sf2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="sf1" sourceRef="SS" targetRef="ST"/>
      <bpmn:sequenceFlow id="sf2" sourceRef="ST" targetRef="SE"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="B5" name="Sub error" attachedToRef="Sub">
      <bpmn:outgoing>b5</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ed5"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B6" name="Sub timer" attachedToRef="Sub">
      <bpmn:outgoing>b6</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ed6">
        <bpmn:timeDuration>PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="E" name="End">
      <bpmn:incoming>f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="E2" name="Failed end">
      <bpmn:incoming>b5</bpmn:incoming>
      <bpmn:incoming>b6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="S" targetRef="T1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="T1" targetRef="T2"/>
    <bpmn:sequenceFlow id="b1" sourceRef="B1" targetRef="Fix"/>
    <bpmn:sequenceFlow id="b2" sourceRef="B2" targetRef="Cancel"/>
    <bpmn:sequenceFlow id="b3" sourceRef="B3" targetRef="Remind"/>
    <bpmn:sequenceFlow id="b4" sourceRef="B4" targetRef="Esc"/>
    <bpmn:sequenceFlow id="f3" sourceRef="T2" targetRef="Sub"/>
    <bpmn:sequenceFlow id="f4" sourceRef="Sub" targetRef="E"/>
    <bpmn:sequenceFlow id="b5" sourceRef="B5" targetRef="E2"/>
    <bpmn:sequenceFlow id="b6" sourceRef="B6" targetRef="E2"/>
    <bpmn:sequenceFlow id="f5" sourceRef="Fix" targetRef="T2"/>
  </bpmn:process>
</bpmn:definitions>

