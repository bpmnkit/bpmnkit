<bpmn:process id="P" isExecutable="true">
<bpmn:startEvent id="S" name="Message start"><bpmn:messageEventDefinition id="e1" /></bpmn:startEvent><bpmn:intermediateCatchEvent id="C1" name="Wait"><bpmn:timerEventDefinition id="e2"><bpmn:timeDuration>PT1H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent><bpmn:intermediateThrowEvent id="T1" name="Signal"><bpmn:signalEventDefinition id="e3" /></bpmn:intermediateThrowEvent><bpmn:callActivity id="CA" name="Call" calledElement="other" /><bpmn:businessRuleTask id="BR" name="Rule" /><bpmn:scriptTask id="SC" name="Script" /><bpmn:manualTask id="MT" name="Manual" /><bpmn:endEvent id="E" name="Terminate"><bpmn:terminateEventDefinition id="e4" /></bpmn:endEvent>
<bpmn:sequenceFlow id="f1" sourceRef="S" targetRef="C1" />
<bpmn:sequenceFlow id="f2" sourceRef="C1" targetRef="T1" />
<bpmn:sequenceFlow id="f3" sourceRef="T1" targetRef="CA" />
<bpmn:sequenceFlow id="f4" sourceRef="CA" targetRef="BR" />
