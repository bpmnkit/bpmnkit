    </bpmn:endEvent>
    <bpmn:sequenceFlow id="FlowB" sourceRef="StartB" targetRef="EndB"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="DiagramA">
    <bpmndi:BPMNPlane id="PlaneA" bpmnElement="ProcessA">
      <bpmndi:BPMNShape id="StartA_di" bpmnElement="StartA">
        <dc:Bounds x="20" y="20" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndA_di" bpmnElement="EndA">
        <dc:Bounds x="116" y="20" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="FlowA_di" bpmnElement="FlowA">
        <di:waypoint x="56" y="38"/>
        <di:waypoint x="116" y="38"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="DiagramB">
    <bpmndi:BPMNPlane id="PlaneB" bpmnElement="ProcessB">
      <bpmndi:BPMNShape id="StartB_di" bpmnElement="StartB">
        <dc:Bounds x="20" y="20" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndB_di" bpmnElement="EndB">
        <dc:Bounds x="116" y="20" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="FlowB_di" bpmnElement="FlowB">
