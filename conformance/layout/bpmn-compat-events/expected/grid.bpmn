    </bpmn:endEvent>
    <bpmn:endEvent id="endTerminate">
      <bpmn:terminateEventDefinition id="TE1"/>
    </bpmn:endEvent>
    <bpmn:endEvent id="endSignalNoRef">
      <bpmn:signalEventDefinition id="S3"/>
    </bpmn:endEvent>
    <bpmn:subProcess id="eventSub" triggeredByEvent="true">
      <bpmn:startEvent id="subTimerCycle">
        <bpmn:timerEventDefinition id="T8">
          <bpmn:timeCycle>R/PT1H</bpmn:timeCycle>
        </bpmn:timerEventDefinition>
      </bpmn:startEvent>
      <bpmn:endEvent id="subEnd"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="signalSub" triggeredByEvent="true">
      <bpmn:startEvent id="subSignal" isInterrupting="false">
        <bpmn:signalEventDefinition id="S4" signalRef="Sig_ok"/>
      </bpmn:startEvent>
      <bpmn:endEvent id="subEnd2"/>
    </bpmn:subProcess>
    <bpmn:subProcess id="messageSub" triggeredByEvent="true">
      <bpmn:startEvent id="subMessage" isInterrupting="false">
        <bpmn:messageEventDefinition id="M7" messageRef="Msg_nokey"/>
      </bpmn:startEvent>
      <bpmn:endEvent id="subEnd3"/>
    </bpmn:subProcess>
  </bpmn:process>
