        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Orphan_di" bpmnElement="Orphan">
        <dc:Bounds x="470" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L2_di" bpmnElement="L2" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="860" height="87"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L1_di" bpmnElement="L1" isHorizontal="true">
        <dc:Bounds x="0" y="87" width="860" height="130"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L3_di" bpmnElement="L3" isHorizontal="true">
        <dc:Bounds x="0" y="217" width="860" height="43"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="88" y="60"/>
        <di:waypoint x="170" y="60"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="270" y="60"/>
        <di:waypoint x="345" y="60"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="395" y="60"/>
        <di:waypoint x="470" y="60"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="413" y="36" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="370" y="85"/>
