<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="C">
    <bpmn:participant id="PA" name="Notes" processRef="Pn"/>
    <bpmn:participant id="PB" name="Work" processRef="Pw"/>
    <bpmn:participant id="PX" name="External"/>
    <bpmn:messageFlow id="M1" sourceRef="Pw_Do" targetRef="PA"/>
    <bpmn:messageFlow id="M2" sourceRef="PX" targetRef="Pw_Do"/>
  </bpmn:collaboration>
  <bpmn:process id="Pn" isExecutable="false">
    <bpmn:textAnnotation id="Ann1">
      <bpmn:text>A rather long note that is wider than the work pool would be on its own</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann2">
      <bpmn:text>Linked note</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:process>
  <bpmn:process id="Pw" isExecutable="true">
    <bpmn:startEvent id="Pw_s" name="Start">
      <bpmn:outgoing>Pw_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Pw_Do" name="Do">
      <bpmn:incoming>Pw_f1</bpmn:incoming>
      <bpmn:outgoing>Pw_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Pw_e" name="End">
      <bpmn:incoming>Pw_f2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Pw_f1" sourceRef="Pw_s" targetRef="Pw_Do"/>
    <bpmn:sequenceFlow id="Pw_f2" sourceRef="Pw_Do" targetRef="Pw_e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="C">
      <bpmndi:BPMNShape id="Ann1_di" bpmnElement="Ann1">
        <dc:Bounds x="50" y="20" width="200" height="58"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ann2_di" bpmnElement="Ann2">
        <dc:Bounds x="50" y="120" width="200" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PA_di" bpmnElement="PA" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="270" height="170"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pw_s_di" bpmnElement="Pw_s">
        <dc:Bounds x="52" y="242" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="50" y="282" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pw_Do_di" bpmnElement="Pw_Do">
        <dc:Bounds x="170" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pw_e_di" bpmnElement="Pw_e">
        <dc:Bounds x="352" y="242" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="350" y="282" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PB_di" bpmnElement="PB" isHorizontal="true">
        <dc:Bounds x="0" y="200" width="410" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PX_di" bpmnElement="PX" isHorizontal="true">
        <dc:Bounds x="0" y="350" width="410" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Pw_f1_di" bpmnElement="Pw_f1">
        <di:waypoint x="88" y="260"/>
        <di:waypoint x="170" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Pw_f2_di" bpmnElement="Pw_f2">
        <di:waypoint x="270" y="260"/>
        <di:waypoint x="352" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M1_di" bpmnElement="M1">
        <di:waypoint x="220" y="220"/>
        <di:waypoint x="220" y="170"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="M2_di" bpmnElement="M2">
        <di:waypoint x="220" y="350"/>
        <di:waypoint x="220" y="300"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

