<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="KYCOnboarding" name="KYC Customer Onboarding" isExecutable="true">
    <bpmn:startEvent id="start" name="Onboarding Started">
      <bpmn:outgoing>Flow_compact_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="uploadDocument" name="Upload Identity Document">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="identity-upload-form"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_compact_1</bpmn:incoming>
      <bpmn:incoming>Flow_compact_4</bpmn:incoming>
      <bpmn:outgoing>Flow_compact_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="verifyDocument" name="Verify Document via OCR">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1"/>
        <zeebe:taskHeaders>
          <zeebe:header key="resultVariable" value="ocrResponse"/>
          <zeebe:header key="resultExpression" value="=ocrResponse.body"/>
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_compact_2</bpmn:incoming>
      <bpmn:outgoing>Flow_compact_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="documentQuality" name="Document Verified?">
      <bpmn:incoming>Flow_compact_3</bpmn:incoming>
      <bpmn:outgoing>Flow_compact_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_compact_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_compact_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="sanctionsScreening" name="Sanctions &amp; PEP Screening">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1"/>
        <zeebe:taskHeaders>
          <zeebe:header key="resultVariable" value="screeningResponse"/>
          <zeebe:header key="resultExpression" value="=screeningResponse.body"/>
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_compact_6</bpmn:incoming>
      <bpmn:outgoing>Flow_compact_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="riskRouting" name="Risk Level?">
      <bpmn:incoming>Flow_compact_7</bpmn:incoming>
      <bpmn:outgoing>Flow_compact_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_compact_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="standardDueDiligence" name="Standard Due Diligence">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1"/>
        <zeebe:taskHeaders>
          <zeebe:header key="resultVariable" value="sddResponse"/>
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_compact_8</bpmn:incoming>
      <bpmn:outgoing>Flow_compact_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="enhancedDueDiligence" name="Enhanced Due Diligence Review">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="compliance-edd-form"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_compact_9</bpmn:incoming>
      <bpmn:outgoing>Flow_compact_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="finalRiskClassification" name="Final Risk Classification">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="kyc-risk-classification" resultVariable="riskClassification"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_compact_10</bpmn:incoming>
      <bpmn:incoming>Flow_compact_11</bpmn:incoming>
      <bpmn:outgoing>Flow_compact_12</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="classificationGateway" name="Classification Outcome?">
      <bpmn:incoming>Flow_compact_12</bpmn:incoming>
      <bpmn:outgoing>Flow_compact_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_compact_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_compact_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="notifyRejection" name="Notify Rejection">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="email-sender"/>
        <zeebe:taskHeaders>
          <zeebe:header key="template" value="kyc-rejected"/>
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_compact_5</bpmn:incoming>
      <bpmn:incoming>Flow_compact_14</bpmn:incoming>
      <bpmn:outgoing>Flow_compact_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="notifyApproval" name="Notify Approval">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="email-sender"/>
        <zeebe:taskHeaders>
          <zeebe:header key="template" value="kyc-approved"/>
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_compact_13</bpmn:incoming>
      <bpmn:outgoing>Flow_compact_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endApproved" name="Customer Approved">
      <bpmn:incoming>Flow_compact_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endRejected" name="Customer Rejected">
      <bpmn:incoming>Flow_compact_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endEscalated" name="Escalated to Compliance">
      <bpmn:incoming>Flow_compact_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_compact_1" sourceRef="start" targetRef="uploadDocument"/>
    <bpmn:sequenceFlow id="Flow_compact_2" sourceRef="uploadDocument" targetRef="verifyDocument"/>
    <bpmn:sequenceFlow id="Flow_compact_3" sourceRef="verifyDocument" targetRef="documentQuality"/>
    <bpmn:sequenceFlow id="Flow_compact_4" sourceRef="documentQuality" targetRef="uploadDocument" name="verification-failed-retry">
      <bpmn:conditionExpression>=ocrResponse.verified = false and (uploadRetries != null and uploadRetries &lt; 2)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_compact_5" sourceRef="documentQuality" targetRef="notifyRejection" name="verification-failed-exhausted">
      <bpmn:conditionExpression>=ocrResponse.verified = false and (uploadRetries = null or uploadRetries &gt;= 2)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_compact_6" sourceRef="documentQuality" targetRef="sanctionsScreening" name="verification-passed">
      <bpmn:conditionExpression>=ocrResponse.verified = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_compact_7" sourceRef="sanctionsScreening" targetRef="riskRouting"/>
    <bpmn:sequenceFlow id="Flow_compact_8" sourceRef="riskRouting" targetRef="standardDueDiligence" name="standard-risk">
      <bpmn:conditionExpression>=screeningResponse.riskLevel = "low"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_compact_9" sourceRef="riskRouting" targetRef="enhancedDueDiligence" name="enhanced-risk">
      <bpmn:conditionExpression>=screeningResponse.riskLevel = "high" or screeningResponse.pepMatch = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_compact_10" sourceRef="standardDueDiligence" targetRef="finalRiskClassification"/>
    <bpmn:sequenceFlow id="Flow_compact_11" sourceRef="enhancedDueDiligence" targetRef="finalRiskClassification"/>
    <bpmn:sequenceFlow id="Flow_compact_12" sourceRef="finalRiskClassification" targetRef="classificationGateway"/>
    <bpmn:sequenceFlow id="Flow_compact_13" sourceRef="classificationGateway" targetRef="notifyApproval" name="approved">
      <bpmn:conditionExpression>=riskClassification.outcome = "approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_compact_14" sourceRef="classificationGateway" targetRef="notifyRejection" name="rejected">
      <bpmn:conditionExpression>=riskClassification.outcome = "rejected"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_compact_15" sourceRef="classificationGateway" targetRef="endEscalated" name="escalate">
      <bpmn:conditionExpression>=riskClassification.outcome = "escalate"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_compact_16" sourceRef="notifyApproval" targetRef="endApproved"/>
    <bpmn:sequenceFlow id="Flow_compact_17" sourceRef="notifyRejection" targetRef="endRejected"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="KYCOnboarding">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="65" y="42" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="20" y="82" width="126" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="uploadDocument_di" bpmnElement="uploadDocument">
        <dc:Bounds x="164" y="20" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="verifyDocument_di" bpmnElement="verifyDocument">
        <dc:Bounds x="324" y="20" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="documentQuality_di" bpmnElement="documentQuality" isMarkerVisible="true">
        <dc:Bounds x="484" y="35" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="517" y="89" width="126" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sanctionsScreening_di" bpmnElement="sanctionsScreening">
        <dc:Bounds x="687" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="riskRouting_di" bpmnElement="riskRouting" isMarkerVisible="true">
        <dc:Bounds x="847" y="175" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="834" y="157" width="77" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="standardDueDiligence_di" bpmnElement="standardDueDiligence">
        <dc:Bounds x="1008" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="enhancedDueDiligence_di" bpmnElement="enhancedDueDiligence">
        <dc:Bounds x="1008" y="300" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="finalRiskClassification_di" bpmnElement="finalRiskClassification">
        <dc:Bounds x="1168" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="classificationGateway_di" bpmnElement="classificationGateway" isMarkerVisible="true">
        <dc:Bounds x="1342" y="175" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1286" y="229" width="161" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notifyRejection_di" bpmnElement="notifyRejection">
        <dc:Bounds x="1496" y="20" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="notifyApproval_di" bpmnElement="notifyApproval">
        <dc:Bounds x="1496" y="160" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endApproved_di" bpmnElement="endApproved">
        <dc:Bounds x="1686" y="182" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1644" y="222" width="119" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endRejected_di" bpmnElement="endRejected">
        <dc:Bounds x="1686" y="42" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1644" y="82" width="119" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEscalated_di" bpmnElement="endEscalated">
        <dc:Bounds x="1528" y="322" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1465" y="362" width="161" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_compact_1_di" bpmnElement="Flow_compact_1">
        <di:waypoint x="101" y="60"/>
        <di:waypoint x="164" y="60"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_compact_2_di" bpmnElement="Flow_compact_2">
        <di:waypoint x="264" y="60"/>
        <di:waypoint x="324" y="60"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_compact_3_di" bpmnElement="Flow_compact_3">
        <di:waypoint x="424" y="60"/>
        <di:waypoint x="484" y="60"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_compact_4_di" bpmnElement="Flow_compact_4">
        <di:waypoint x="509" y="35"/>
        <di:waypoint x="509" y="-20"/>
        <di:waypoint x="214" y="-20"/>
        <di:waypoint x="214" y="20"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="515" y="15" width="175" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_compact_5_di" bpmnElement="Flow_compact_5">
        <di:waypoint x="534" y="60"/>
        <di:waypoint x="1496" y="60"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="540" y="43" width="203" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_compact_6_di" bpmnElement="Flow_compact_6">
        <di:waypoint x="509" y="85"/>
        <di:waypoint x="509" y="200"/>
        <di:waypoint x="687" y="200"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="532" y="176" width="133" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_compact_7_di" bpmnElement="Flow_compact_7">
        <di:waypoint x="787" y="200"/>
        <di:waypoint x="847" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_compact_8_di" bpmnElement="Flow_compact_8">
        <di:waypoint x="897" y="200"/>
        <di:waypoint x="1008" y="200"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="903" y="183" width="91" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_compact_9_di" bpmnElement="Flow_compact_9">
        <di:waypoint x="872" y="225"/>
        <di:waypoint x="872" y="340"/>
        <di:waypoint x="1008" y="340"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="878" y="231" width="91" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_compact_10_di" bpmnElement="Flow_compact_10">
        <di:waypoint x="1108" y="200"/>
        <di:waypoint x="1168" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_compact_11_di" bpmnElement="Flow_compact_11">
        <di:waypoint x="1058" y="300"/>
        <di:waypoint x="1058" y="270"/>
        <di:waypoint x="1218" y="270"/>
        <di:waypoint x="1218" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_compact_12_di" bpmnElement="Flow_compact_12">
        <di:waypoint x="1268" y="200"/>
        <di:waypoint x="1342" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_compact_13_di" bpmnElement="Flow_compact_13">
        <di:waypoint x="1392" y="200"/>
        <di:waypoint x="1496" y="200"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1398" y="183" width="56" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_compact_14_di" bpmnElement="Flow_compact_14">
        <di:waypoint x="1367" y="175"/>
        <di:waypoint x="1367" y="130"/>
        <di:waypoint x="1546" y="130"/>
        <di:waypoint x="1546" y="100"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1373" y="155" width="56" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_compact_15_di" bpmnElement="Flow_compact_15">
        <di:waypoint x="1367" y="225"/>
        <di:waypoint x="1367" y="340"/>
        <di:waypoint x="1528" y="340"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1419" y="316" width="56" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_compact_16_di" bpmnElement="Flow_compact_16">
        <di:waypoint x="1596" y="200"/>
        <di:waypoint x="1686" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_compact_17_di" bpmnElement="Flow_compact_17">
        <di:waypoint x="1596" y="60"/>
        <di:waypoint x="1686" y="60"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

