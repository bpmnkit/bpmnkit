<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="S" name="Start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="A" name="Try">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:incoming>back1</bpmn:incoming>
      <bpmn:incoming>back2</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G" name="OK?">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="B" name="Process">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G2" name="More?">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>back2</bpmn:outgoing>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="R" name="Repair">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:incoming>self</bpmn:incoming>
      <bpmn:outgoing>back1</bpmn:outgoing>
      <bpmn:outgoing>self</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E" name="End">
      <bpmn:incoming>f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="S" targetRef="A"/>
    <bpmn:sequenceFlow id="f2" sourceRef="A" targetRef="G"/>
    <bpmn:sequenceFlow id="f3" sourceRef="G" targetRef="B" name="yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=ok</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" sourceRef="G" targetRef="R" name="no"/>
    <bpmn:sequenceFlow id="back1" sourceRef="R" targetRef="A" name="retry"/>
    <bpmn:sequenceFlow id="f5" sourceRef="B" targetRef="G2"/>
    <bpmn:sequenceFlow id="back2" sourceRef="G2" targetRef="A" name="again">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">=more</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f6" sourceRef="G2" targetRef="E" name="no"/>
    <bpmn:sequenceFlow id="self" sourceRef="R" targetRef="R"/>
  </bpmn:process>
