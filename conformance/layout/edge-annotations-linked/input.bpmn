<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="C">
    <bpmn:participant id="PA" name="Notes" processRef="Pn"/>
    <bpmn:participant id="PB" name="Work" processRef="Pw"/>
  </bpmn:collaboration>
  <bpmn:process id="Pn" isExecutable="true">
    <bpmn:textAnnotation id="Pn_N1">
      <bpmn:text>A note</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Pn_N2">
      <bpmn:text>Its follow-up</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Pn_a1" sourceRef="Pn_N1" targetRef="Pn_N2"/>
  </bpmn:process>
  <bpmn:process id="Pw" isExecutable="true">
    <bpmn:startEvent id="Pw_s" name="Start">
      <bpmn:outgoing>Pw_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Pw_Do" name="Do">
      <bpmn:incoming>Pw_f1</bpmn:incoming>
      <bpmn:outgoing>Pw_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Pw_Check" name="Check">
      <bpmn:incoming>Pw_f2</bpmn:incoming>
      <bpmn:outgoing>Pw_f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Pw_e" name="End">
      <bpmn:incoming>Pw_f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Pw_f1" sourceRef="Pw_s" targetRef="Pw_Do"/>
    <bpmn:sequenceFlow id="Pw_f2" sourceRef="Pw_Do" targetRef="Pw_Check"/>
    <bpmn:sequenceFlow id="Pw_f3" sourceRef="Pw_Check" targetRef="Pw_e"/>
    <bpmn:textAnnotation id="Pw_N1">
      <bpmn:text>Explains Do</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Pw_N2">
      <bpmn:text>Refines the note on Do</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Pw_N3">
      <bpmn:text>On Check</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Pw_N4">
      <bpmn:text>Links two notes</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Pw_a1" sourceRef="Pw_Do" targetRef="Pw_N1"/>
    <bpmn:association id="Pw_a2" sourceRef="Pw_N1" targetRef="Pw_N2"/>
    <bpmn:association id="Pw_a3" sourceRef="Pw_N3" targetRef="Pw_Check"/>
    <bpmn:association id="Pw_a4" sourceRef="Pw_N3" targetRef="Pw_N4"/>
    <bpmn:association id="Pw_a5" sourceRef="Pw_N4" targetRef="Pw_N1"/>
  </bpmn:process>
</bpmn:definitions>
