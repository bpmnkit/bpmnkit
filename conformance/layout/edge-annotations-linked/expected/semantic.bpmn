<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="C">
    <bpmn:participant id="PA" name="Notes" processRef="Pn"/>
    <bpmn:participant id="PB" name="Work" processRef="Pw"/>
  </bpmn:collaboration>
  <bpmn:process id="Pn" isExecutable="true">
    <bpmn:textAnnotation id="Pn_N1">
      <bpmn:text>A note</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Pn_N2">
      <bpmn:text>Its follow-up</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Pn_a1" sourceRef="Pn_N1" targetRef="Pn_N2"/>
  </bpmn:process>
  <bpmn:process id="Pw" isExecutable="true">
    <bpmn:startEvent id="Pw_s" name="Start">
      <bpmn:outgoing>Pw_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Pw_Do" name="Do">
      <bpmn:incoming>Pw_f1</bpmn:incoming>
      <bpmn:outgoing>Pw_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Pw_Check" name="Check">
      <bpmn:incoming>Pw_f2</bpmn:incoming>
      <bpmn:outgoing>Pw_f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Pw_e" name="End">
      <bpmn:incoming>Pw_f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Pw_f1" sourceRef="Pw_s" targetRef="Pw_Do"/>
    <bpmn:sequenceFlow id="Pw_f2" sourceRef="Pw_Do" targetRef="Pw_Check"/>
    <bpmn:sequenceFlow id="Pw_f3" sourceRef="Pw_Check" targetRef="Pw_e"/>
    <bpmn:textAnnotation id="Pw_N1">
      <bpmn:text>Explains Do</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Pw_N2">
      <bpmn:text>Refines the note on Do</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Pw_N3">
      <bpmn:text>On Check</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Pw_N4">
      <bpmn:text>Links two notes</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Pw_a1" sourceRef="Pw_Do" targetRef="Pw_N1"/>
    <bpmn:association id="Pw_a2" sourceRef="Pw_N1" targetRef="Pw_N2"/>
    <bpmn:association id="Pw_a3" sourceRef="Pw_N3" targetRef="Pw_Check"/>
    <bpmn:association id="Pw_a4" sourceRef="Pw_N3" targetRef="Pw_N4"/>
    <bpmn:association id="Pw_a5" sourceRef="Pw_N4" targetRef="Pw_N1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="C">
      <bpmndi:BPMNShape id="Pn_N1_di" bpmnElement="Pn_N1">
        <dc:Bounds x="50" y="20" width="200" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pn_N2_di" bpmnElement="Pn_N2">
        <dc:Bounds x="50" y="70" width="200" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PA_di" bpmnElement="PA" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="270" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pw_s_di" bpmnElement="Pw_s">
        <dc:Bounds x="52" y="322" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="50" y="362" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pw_Do_di" bpmnElement="Pw_Do">
        <dc:Bounds x="148" y="300" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pw_Check_di" bpmnElement="Pw_Check">
        <dc:Bounds x="308" y="300" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pw_e_di" bpmnElement="Pw_e">
        <dc:Bounds x="468" y="322" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="466" y="362" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pw_N1_di" bpmnElement="Pw_N1">
        <dc:Bounds x="98" y="220" width="200" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pw_N2_di" bpmnElement="Pw_N2">
        <dc:Bounds x="98" y="170" width="200" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pw_N3_di" bpmnElement="Pw_N3">
        <dc:Bounds x="318" y="220" width="200" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pw_N4_di" bpmnElement="Pw_N4">
        <dc:Bounds x="318" y="170" width="200" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PB_di" bpmnElement="PB" isHorizontal="true">
        <dc:Bounds x="0" y="150" width="538" height="250"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Pn_a1_di" bpmnElement="Pn_a1">
        <di:waypoint x="150" y="50"/>
        <di:waypoint x="150" y="70"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Pw_f1_di" bpmnElement="Pw_f1">
        <di:waypoint x="88" y="340"/>
        <di:waypoint x="148" y="340"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Pw_f2_di" bpmnElement="Pw_f2">
        <di:waypoint x="248" y="340"/>
        <di:waypoint x="308" y="340"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Pw_f3_di" bpmnElement="Pw_f3">
        <di:waypoint x="408" y="340"/>
        <di:waypoint x="468" y="340"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Pw_a1_di" bpmnElement="Pw_a1">
        <di:waypoint x="198" y="300"/>
        <di:waypoint x="198" y="250"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Pw_a2_di" bpmnElement="Pw_a2">
        <di:waypoint x="198" y="220"/>
        <di:waypoint x="198" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Pw_a3_di" bpmnElement="Pw_a3">
        <di:waypoint x="358" y="250"/>
        <di:waypoint x="408" y="300"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Pw_a4_di" bpmnElement="Pw_a4">
        <di:waypoint x="418" y="220"/>
        <di:waypoint x="418" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Pw_a5_di" bpmnElement="Pw_a5">
        <di:waypoint x="318" y="200"/>
        <di:waypoint x="298" y="220"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

