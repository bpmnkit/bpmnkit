<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="P1" name="First" isExecutable="true">
    <bpmn:startEvent id="P1_s">
      <bpmn:outgoing>P1_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="P1_e">
      <bpmn:incoming>P1_f1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P1_f1" sourceRef="P1_s" targetRef="P1_e"/>
  </bpmn:process>
  <bpmn:process id="P2" name="Second" isExecutable="true">
    <bpmn:laneSet id="P2_LS">
      <bpmn:lane id="P2_L1" name="Clerk">
        <bpmn:flowNodeRef>P2_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_A</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_L2" name="Manager">
        <bpmn:flowNodeRef>P2_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P2_s" name="Request">
      <bpmn:outgoing>P2_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="P2_A" name="Fill form">
      <bpmn:incoming>P2_f1</bpmn:incoming>
      <bpmn:outgoing>P2_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P2_B" name="Approve">
      <bpmn:incoming>P2_f2</bpmn:incoming>
      <bpmn:outgoing>P2_f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="P2_e" name="Done">
      <bpmn:incoming>P2_f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P2_f1" sourceRef="P2_s" targetRef="P2_A"/>
    <bpmn:sequenceFlow id="P2_f2" sourceRef="P2_A" targetRef="P2_B"/>
    <bpmn:sequenceFlow id="P2_f3" sourceRef="P2_B" targetRef="P2_e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="P1">
      <bpmndi:BPMNShape id="P1_s_di" bpmnElement="P1_s">
        <dc:Bounds x="20" y="20" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P1_e_di" bpmnElement="P1_e">
        <dc:Bounds x="170" y="20" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P1_f1_di" bpmnElement="P1_f1">
        <di:waypoint x="56" y="38"/>
        <di:waypoint x="170" y="38"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P2">
    <bpmndi:BPMNPlane id="BPMNPlane_P2" bpmnElement="P2">
      <bpmndi:BPMNShape id="P2_s_di" bpmnElement="P2_s">
        <dc:Bounds x="57" y="42" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="50" y="82" width="49" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_A_di" bpmnElement="P2_A">
        <dc:Bounds x="175" y="20" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_B_di" bpmnElement="P2_B">
        <dc:Bounds x="325" y="20" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_e_di" bpmnElement="P2_e">
        <dc:Bounds x="507" y="42" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="505" y="82" width="40" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L1_di" bpmnElement="P2_L1" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="565" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P2_L2_di" bpmnElement="P2_L2" isHorizontal="true">
        <dc:Bounds x="0" y="60" width="565" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P2_f1_di" bpmnElement="P2_f1">
        <di:waypoint x="93" y="60"/>
        <di:waypoint x="175" y="60"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_f2_di" bpmnElement="P2_f2">
        <di:waypoint x="275" y="60"/>
        <di:waypoint x="325" y="60"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P2_f3_di" bpmnElement="P2_f3">
        <di:waypoint x="425" y="60"/>
        <di:waypoint x="507" y="60"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

