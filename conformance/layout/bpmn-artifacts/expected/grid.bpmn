<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_artifacts" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:category id="Category_phases">
    <bpmn:categoryValue id="CategoryValue_intake" value="Intake"/>
    <bpmn:categoryValue id="CategoryValue_review" value="Review"/>
  </bpmn:category>
  <bpmn:process id="Process_artifacts" name="Annotated process" isExecutable="true">
    <bpmn:startEvent id="Start_art">
      <bpmn:outgoing>Flow_a1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_review" name="Review">
      <bpmn:documentation>Reviewer checks the submission against policy.</bpmn:documentation>
      <bpmn:incoming>Flow_a1</bpmn:incoming>
      <bpmn:outgoing>Flow_a2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_art">
      <bpmn:incoming>Flow_a2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_a1" sourceRef="Start_art" targetRef="Task_review"/>
    <bpmn:sequenceFlow id="Flow_a2" sourceRef="Task_review" targetRef="End_art"/>
    <bpmn:textAnnotation id="TextAnnotation_sla">
      <bpmn:text>Must complete within one business day.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_sla" sourceRef="Task_review" targetRef="TextAnnotation_sla" associationDirection="None"/>
    <bpmn:group id="Group_intake" categoryValueRef="CategoryValue_intake"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_artifacts">
      <bpmndi:BPMNShape id="Start_art_di" bpmnElement="Start_art">
        <dc:Bounds x="20" y="135" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_review_di" bpmnElement="Task_review">
        <dc:Bounds x="138" y="113" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_art_di" bpmnElement="End_art">
        <dc:Bounds x="320" y="135" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TextAnnotation_sla_di" bpmnElement="TextAnnotation_sla">
        <dc:Bounds x="88" y="20" width="200" height="43"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_a1_di" bpmnElement="Flow_a1">
        <di:waypoint x="56" y="153"/>
        <di:waypoint x="138" y="153"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_a2_di" bpmnElement="Flow_a2">
        <di:waypoint x="238" y="153"/>
        <di:waypoint x="320" y="153"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_sla_di" bpmnElement="Association_sla">
        <di:waypoint x="188" y="113"/>
        <di:waypoint x="188" y="63"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

