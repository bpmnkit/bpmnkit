<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_agents" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="agents" isExecutable="true">
    <bpmn:serviceTask id="outsideTool">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="t"/>
        <zeebe:ioMapping>
          <zeebe:input source="=fromAi(toolCall.x, &quot;x&quot;)" target="x"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:adHocSubProcess id="plainAdHoc" name="Plain">
      <bpmn:serviceTask id="plainTool">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="t"/>
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.x)" target="x"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
    </bpmn:adHocSubProcess>
    <bpmn:adHocSubProcess id="tools" name="Tools">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="io.camunda.agenticai.toolContainer" value="true"/>
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:serviceTask id="toolGood">
        <bpmn:documentation>Looks up the weather.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="t"/>
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.city, &quot;The city&quot;, &quot;string&quot;)" target="city"/>
            <zeebe:input source="=fromAi(value: toolCall.days, description: &quot;Days&quot;)" target="days"/>
            <zeebe:output source="=weather" target="toolCallResult"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="toolNoResult">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="t"/>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="toolUnmapped">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="t"/>
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(&quot;city&quot;)" target="a"/>
            <zeebe:input source="=fromAi(city, 1)" target="b"/>
            <zeebe:input source="=fromAi()" target="c"/>
            <zeebe:output source="=r" target="result"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="toolCasing">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="t"/>
          <zeebe:ioMapping>
            <zeebe:input source="=FromAI(toolCall.x)" target="a"/>
            <zeebe:input source="=fromAi(toolCall.a.b) + fromAi(other.x)" target="b"/>
            <zeebe:input source="=fromAi(if x then toolCall.x else toolCall.y)" target="c"/>
            <zeebe:input source="=fromAi(toolCall[&quot;x&quot;], null)" target="d"/>
            <zeebe:input source="=fromAi(null) + fromAi(1 + 2) + fromAi(-1)" target="e"/>
            <zeebe:input source="=fromAi([1]) + fromAi((toolCall.p)) + fromAi(toolCall.q, (&quot;d&quot;))" target="f"/>
            <zeebe:output source="=r" target="ToolCallResult"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="toolDuplicateKey">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="t"/>
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.q)" target="a"/>
            <zeebe:input source="=fromAi(toolCall.q, &quot;again&quot;)" target="b"/>
            <zeebe:output source="=r" target="toolCallResult"/>
            <zeebe:output source="=r" target="toolcallresult.extra"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="toolOutputFromAi">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="t"/>
          <zeebe:ioMapping>
            <zeebe:output source="=fromAi(toolCall.o)" target="toolCallResult"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="chainA" name="Fetch">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="t"/>
          <zeebe:ioMapping>
            <zeebe:output source="=r" target="toolCallResult"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:outgoing>chainAtoB</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="chainB">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="t"/>
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.y)" target="y"/>
            <zeebe:output source="=r" target="toolCallResult"/>
            <zeebe:output source="=context put(toolCallResult, &quot;b&quot;, 1)" target="toolCallResult"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>chainAtoB</bpmn:incoming>
        <bpmn:outgoing>chainBtoC</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:scriptTask id="chainC">
        <bpmn:extensionElements>
          <zeebe:script expression="=1" resultVariable="toolCallResult"/>
        </bpmn:extensionElements>
        <bpmn:incoming>chainBtoC</bpmn:incoming>
      </bpmn:scriptTask>
      <bpmn:serviceTask id="branch">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="t"/>
        </bpmn:extensionElements>
        <bpmn:outgoing>branchToA</bpmn:outgoing>
        <bpmn:outgoing>branchToB</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="branchA">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="t"/>
          <zeebe:ioMapping>
            <zeebe:output source="=a" target="toolCallResult"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>branchToA</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="branchB">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="t"/>
          <zeebe:taskHeaders>
            <zeebe:header key="resultExpression" value="={toolCallResult: b, other: toolcallresult}"/>
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>branchToB</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:subProcess id="toolSub">
        <bpmn:startEvent id="toolSubStart">
          <bpmn:outgoing>toolSubToStep</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:serviceTask id="toolSubStep">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="t"/>
            <zeebe:ioMapping>
              <zeebe:input source="=fromAi(toolCall.k)" target="k"/>
            </zeebe:ioMapping>
            <zeebe:taskHeaders>
              <zeebe:header key="resultVariable" value="toolResult"/>
            </zeebe:taskHeaders>
          </bpmn:extensionElements>
          <bpmn:incoming>toolSubToStep</bpmn:incoming>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="toolSubToStep" sourceRef="toolSubStart" targetRef="toolSubStep"/>
      </bpmn:subProcess>
      <bpmn:serviceTask id="toolBoundary">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="t"/>
          <zeebe:ioMapping>
            <zeebe:output source="=a" target="toolCallResult"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:boundaryEvent id="toolBoundaryError" attachedToRef="toolBoundary">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="=e" target="toolCallResult"/>
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:errorEventDefinition id="toolBoundaryErrorDef"/>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="chainAtoB" sourceRef="chainA" targetRef="chainB"/>
      <bpmn:sequenceFlow id="chainBtoC" sourceRef="chainB" targetRef="chainC"/>
      <bpmn:sequenceFlow id="branchToA" sourceRef="branch" targetRef="branchA">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=fromAi(toolCall.z) = 1</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="branchToB" sourceRef="branch" targetRef="branchB"/>
    </bpmn:adHocSubProcess>
    <bpmn:adHocSubProcess id="legacyAgent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.jobworker.v1">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="agent"/>
      </bpmn:extensionElements>
      <bpmn:serviceTask id="legacyTool">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="t"/>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
    </bpmn:adHocSubProcess>
    <bpmn:adHocSubProcess id="forkedAgent">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1"/>
      </bpmn:extensionElements>
      <bpmn:serviceTask id="forkedTool">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="t"/>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
    </bpmn:adHocSubProcess>
    <bpmn:adHocSubProcess id="definedAgent">
      <bpmn:extensionElements>
        <zeebe:agentDefinition/>
      </bpmn:extensionElements>
      <bpmn:serviceTask id="definedTool">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="t"/>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
    </bpmn:adHocSubProcess>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="agents">
      <bpmndi:BPMNShape id="outsideTool_di" bpmnElement="outsideTool">
        <dc:Bounds x="455" y="20" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="plainAdHoc_di" bpmnElement="plainAdHoc" isExpanded="true">
        <dc:Bounds x="405" y="180" width="200" height="208"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tools_di" bpmnElement="tools" isExpanded="true">
        <dc:Bounds x="20" y="468" width="970" height="1118"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="legacyAgent_di" bpmnElement="legacyAgent" isExpanded="true">
        <dc:Bounds x="405" y="1666" width="200" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="forkedAgent_di" bpmnElement="forkedAgent" isExpanded="true">
        <dc:Bounds x="405" y="1926" width="200" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="definedAgent_di" bpmnElement="definedAgent" isExpanded="true">
        <dc:Bounds x="405" y="2186" width="200" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="plainTool_di" bpmnElement="plainTool">
        <dc:Bounds x="455" y="258" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="toolGood_di" bpmnElement="toolGood">
        <dc:Bounds x="168" y="546" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="toolNoResult_di" bpmnElement="toolNoResult">
        <dc:Bounds x="504" y="546" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="toolUnmapped_di" bpmnElement="toolUnmapped">
        <dc:Bounds x="840" y="546" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="toolCasing_di" bpmnElement="toolCasing">
        <dc:Bounds x="168" y="746" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="toolDuplicateKey_di" bpmnElement="toolDuplicateKey">
        <dc:Bounds x="504" y="746" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="toolOutputFromAi_di" bpmnElement="toolOutputFromAi">
        <dc:Bounds x="840" y="746" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="chainA_di" bpmnElement="chainA">
        <dc:Bounds x="168" y="1156" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="chainB_di" bpmnElement="chainB">
        <dc:Bounds x="466" y="1156" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="chainC_di" bpmnElement="chainC">
        <dc:Bounds x="626" y="1156" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="branch_di" bpmnElement="branch">
        <dc:Bounds x="168" y="1316" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="branchA_di" bpmnElement="branchA">
        <dc:Bounds x="466" y="1316" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="branchB_di" bpmnElement="branchB">
        <dc:Bounds x="466" y="1456" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="toolSub_di" bpmnElement="toolSub" isExpanded="true">
        <dc:Bounds x="70" y="896" width="296" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="toolBoundary_di" bpmnElement="toolBoundary">
        <dc:Bounds x="504" y="946" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="toolBoundaryError_di" bpmnElement="toolBoundaryError">
        <dc:Bounds x="536" y="1008" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="toolSubStart_di" bpmnElement="toolSubStart">
        <dc:Bounds x="120" y="968" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="toolSubStep_di" bpmnElement="toolSubStep">
        <dc:Bounds x="216" y="946" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="legacyTool_di" bpmnElement="legacyTool">
        <dc:Bounds x="455" y="1716" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="forkedTool_di" bpmnElement="forkedTool">
        <dc:Bounds x="455" y="1976" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="definedTool_di" bpmnElement="definedTool">
        <dc:Bounds x="455" y="2236" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="chainAtoB_di" bpmnElement="chainAtoB">
        <di:waypoint x="268" y="1196"/>
        <di:waypoint x="466" y="1196"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="chainBtoC_di" bpmnElement="chainBtoC">
        <di:waypoint x="566" y="1196"/>
        <di:waypoint x="626" y="1196"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="branchToA_di" bpmnElement="branchToA">
        <di:waypoint x="268" y="1356"/>
        <di:waypoint x="466" y="1356"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="branchToB_di" bpmnElement="branchToB">
        <di:waypoint x="218" y="1396"/>
        <di:waypoint x="218" y="1496"/>
        <di:waypoint x="466" y="1496"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="toolSubToStep_di" bpmnElement="toolSubToStep">
        <di:waypoint x="156" y="986"/>
        <di:waypoint x="216" y="986"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

