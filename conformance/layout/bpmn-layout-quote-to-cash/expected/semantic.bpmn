        <dc:Bounds x="1388" y="305" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1375" y="287" width="77" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
