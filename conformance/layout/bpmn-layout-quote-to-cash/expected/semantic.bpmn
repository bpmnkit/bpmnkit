        <dc:Bounds x="1728" y="290" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="provisionBundle_di" bpmnElement="provisionBundle" isExpanded="true">
        <dc:Bounds x="1556" y="430" width="444" height="208"/>
