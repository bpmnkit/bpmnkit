    <serviceTask id="archiveInvoice" camunda:delegateExpression="#{archiveService}" w4:serviceName="ArchiveInvoiceService" completionQuantity="1" startQuantity="1" implementation="##unspecified" name="Archive&#10;Invoice">
      <extensionElements>
