        <camunda:field name="text1">
          <camunda:expression>${genderBean.getGenderString(gender)}</camunda:expression>
        </camunda:field>
        <camunda:field name="text2">
          <camunda:expression>Hello ${gender == 'male' ? 'Mr.' : 'Mrs.'} ${name}</camunda:expression>
