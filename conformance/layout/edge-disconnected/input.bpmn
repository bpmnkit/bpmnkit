<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="S" name="Start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="A" name="A">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E" name="End">
      <bpmn:incoming>f2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="X1" name="Island 1">
      <bpmn:outgoing>fx</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="X2" name="Island 2">
      <bpmn:incoming>fx</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Lonely" name="Lonely"/>
    <bpmn:intermediateThrowEvent id="Thr" name="Lone throw"/>
    <bpmn:startEvent id="S2" name="Second start">
      <bpmn:outgoing>fs</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="E2" name="Second end">
      <bpmn:incoming>fs</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="S" targetRef="A"/>
    <bpmn:sequenceFlow id="f2" sourceRef="A" targetRef="E"/>
    <bpmn:sequenceFlow id="fx" sourceRef="X1" targetRef="X2"/>
    <bpmn:sequenceFlow id="fs" sourceRef="S2" targetRef="E2"/>
  </bpmn:process>
</bpmn:definitions>

