      <bpmndi:BPMNShape id="E2_di" bpmnElement="E2">
        <dc:Bounds x="930" y="470" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="917" y="510" width="63" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="sf1_di" bpmnElement="sf1">
