<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_1" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:process id="P" isExecutable="true">
<bpmn:startEvent id="S" name="Start" /><bpmn:task id="A" name="Task A" /><bpmn:task id="B" name="Task B" /><bpmn:endEvent id="E" name="End" /><bpmn:sequenceFlow id="f1" sourceRef="S" targetRef="A" />
<bpmn:sequenceFlow id="f2" sourceRef="A" targetRef="B" />
<bpmn:sequenceFlow id="f3" sourceRef="B" targetRef="E" />
<bpmn:textAnnotation id="N1"><bpmn:text>Explains task A</bpmn:text></bpmn:textAnnotation><bpmn:association id="as1" sourceRef="A" targetRef="N1" />
<bpmn:textAnnotation id="N2"><bpmn:text>Applies to both the start event and the end event with a rather long description</bpmn:text></bpmn:textAnnotation><bpmn:association id="as2" sourceRef="S" targetRef="N2" /><bpmn:association id="as3" sourceRef="E" targetRef="N2" />
<bpmn:textAnnotation id="N3"><bpmn:text>On a flow</bpmn:text></bpmn:textAnnotation><bpmn:association id="as4" sourceRef="f2" targetRef="N3" />
<bpmn:textAnnotation id="N4" /><bpmn:association id="as5" sourceRef="B" targetRef="N4" associationDirection="One" />
<bpmn:textAnnotation id="N5"><bpmn:text>Floating</bpmn:text></bpmn:textAnnotation>
</bpmn:process>
</bpmn:definitions>
