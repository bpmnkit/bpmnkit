  <bpmn:process id="P" isExecutable="true">
    <bpmn:startEvent id="S" name="Start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="A" name="Task A">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="B" name="Task B">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E" name="End">
      <bpmn:incoming>f3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="S" targetRef="A"/>
    <bpmn:sequenceFlow id="f2" sourceRef="A" targetRef="B"/>
    <bpmn:sequenceFlow id="f3" sourceRef="B" targetRef="E"/>
    <bpmn:textAnnotation id="N1">
      <bpmn:text>Explains task A</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="N2">
      <bpmn:text>Applies to both the start event and the end event with a rather long description</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="N3">
      <bpmn:text>On a flow</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="N4"/>
    <bpmn:textAnnotation id="N5">
      <bpmn:text>Floating</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="as1" sourceRef="A" targetRef="N1"/>
