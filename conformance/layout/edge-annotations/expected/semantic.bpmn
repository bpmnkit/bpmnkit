    <bpmn:association id="as3" sourceRef="E" targetRef="N2"/>
    <bpmn:association id="as4" sourceRef="f2" targetRef="N3"/>
    <bpmn:association id="as5" sourceRef="B" targetRef="N4" associationDirection="One"/>
  </bpmn:process>
