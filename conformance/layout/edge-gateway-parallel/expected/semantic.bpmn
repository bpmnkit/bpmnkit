    <bpmn:task id="C" name="Branch C">
      <bpmn:incoming>c</bpmn:incoming>
      <bpmn:outgoing>jc</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="D" name="After B">
      <bpmn:incoming>bd</bpmn:incoming>
      <bpmn:outgoing>jd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Join">
      <bpmn:incoming>ja</bpmn:incoming>
      <bpmn:incoming>jd</bpmn:incoming>
      <bpmn:incoming>jc</bpmn:incoming>
      <bpmn:outgoing>fe</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="E" name="End">
      <bpmn:incoming>fe</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f0" sourceRef="S" targetRef="Split"/>
    <bpmn:sequenceFlow id="a" sourceRef="Split" targetRef="A"/>
    <bpmn:sequenceFlow id="b" sourceRef="Split" targetRef="B"/>
    <bpmn:sequenceFlow id="c" sourceRef="Split" targetRef="C"/>
    <bpmn:sequenceFlow id="bd" sourceRef="B" targetRef="D"/>
    <bpmn:sequenceFlow id="ja" sourceRef="A" targetRef="Join"/>
    <bpmn:sequenceFlow id="jd" sourceRef="D" targetRef="Join"/>
    <bpmn:sequenceFlow id="jc" sourceRef="C" targetRef="Join"/>
    <bpmn:sequenceFlow id="fe" sourceRef="Join" targetRef="E"/>
  </bpmn:process>
