<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_test" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="p" isExecutable="true">
    <bpmn:serviceTask id="t">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="note">Paid ${claim.id}</camunda:inputParameter>
          <camunda:inputParameter name="audit">
            <camunda:script scriptFormat="groovy">x.collect()</camunda:script>
          </camunda:inputParameter>
          <camunda:outputParameter name="my-var">${a}</camunda:outputParameter>
        </camunda:inputOutput>
        <zeebe:taskDefinition type="x"/>
        <zeebe:ioMapping>
          <zeebe:input source="=a" target="ok"/>
          <zeebe:input source="=a + 1" target="feel"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
  </bpmn:process>
</bpmn:definitions>

