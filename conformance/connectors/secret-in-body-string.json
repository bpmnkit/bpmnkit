{
  "description": "secrets inside FEEL-built strings in the body",
  "env": {
    "API_KEY": "key-998877"
  },
  "exchanges": [
    {
      "request": {
        "body": {
          "nested": [
            "key-998877"
          ],
          "text": "key=key-998877"
        },
        "method": "POST",
        "path": "/msg"
      },
      "response": {
        "body": {
          "sent": true
        },
        "status": 200
      }
    }
  ],
  "expected": {
    "complete": {
      "variables": {
        "myResponseBody": {
          "sent": true
        }
      }
    }
  },
  "job": {
    "headers": {
      "resultExpression": "={\n  myResponseBody: response.body\n}"
    },
    "retries": 3,
    "variables": {
      "body": {
        "nested": [
          "{{secrets.API_KEY}}"
        ],
        "text": "key={{secrets.API_KEY}}"
      },
      "method": "POST",
      "url": "http://mock.local/msg"
    }
  },
  "recorded": false,
  "source": "https://docs.camunda.io/docs/self-managed/components/connectors/connectors-configuration/#secrets"
}
