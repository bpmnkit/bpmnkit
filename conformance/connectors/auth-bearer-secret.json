{
  "description": "bearer token from a secret",
  "env": {
    "BEARER_TOKEN": "tok-abcdef123"
  },
  "exchanges": [
    {
      "request": {
        "headers": {
          "authorization": "Bearer tok-abcdef123"
        },
        "method": "GET",
        "path": "/me"
      },
      "response": {
        "body": {
          "login": "ada"
        },
        "status": 200
      }
    }
  ],
  "expected": {
    "complete": {
      "variables": {
        "myResponseBody": {
          "login": "ada"
        }
      }
    }
  },
  "job": {
    "headers": {
      "resultExpression": "={\n  myResponseBody: response.body\n}"
    },
    "retries": 3,
    "variables": {
      "authentication": {
        "token": "{{secrets.BEARER_TOKEN}}",
        "type": "bearer"
      },
      "method": "GET",
      "url": "http://mock.local/me"
    }
  },
  "recorded": false,
  "source": "https://docs.camunda.io/docs/components/connectors/protocol/rest/#rest-connector-bearer-token"
}
