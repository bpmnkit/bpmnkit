{
  "description": "API key in a header (catalog template: authentication.name/value)",
  "env": {
    "API_KEY": "key-998877"
  },
  "exchanges": [
    {
      "request": {
        "headers": {
          "x-api-key": "key-998877"
        },
        "method": "GET",
        "path": "/k"
      },
      "response": {
        "body": {
          "ok": true
        },
        "status": 200
      }
    }
  ],
  "expected": {
    "complete": {
      "variables": {
        "myResponseBody": {
          "ok": true
        }
      }
    }
  },
  "job": {
    "headers": {
      "resultExpression": "={\n  myResponseBody: response.body\n}"
    },
    "retries": 3,
    "variables": {
      "authentication": {
        "apiKeyLocation": "headers",
        "name": "X-API-Key",
        "type": "apiKey",
        "value": "{{secrets.API_KEY}}"
      },
      "method": "GET",
      "url": "http://mock.local/k"
    }
  },
  "recorded": false,
  "source": "https://docs.camunda.io/docs/components/connectors/protocol/rest/"
}
