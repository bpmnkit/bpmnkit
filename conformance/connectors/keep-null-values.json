{
  "description": "nulls stay in the body by default",
  "exchanges": [
    {
      "request": {
        "body": {
          "a": 1,
          "b": null
        },
        "method": "POST",
        "path": "/p"
      },
      "response": {
        "body": {},
        "status": 200
      }
    }
  ],
  "expected": {
    "complete": {
      "variables": {
        "myResponseBody": {}
      }
    }
  },
  "job": {
    "headers": {
      "resultExpression": "={\n  myResponseBody: response.body\n}"
    },
    "retries": 3,
    "variables": {
      "body": {
        "a": 1,
        "b": null
      },
      "method": "POST",
      "url": "http://mock.local/p"
    }
  },
  "recorded": false,
  "source": "https://docs.camunda.io/docs/components/connectors/protocol/rest/"
}
