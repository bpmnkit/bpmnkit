{
  "description": "CAMUNDA_CONNECTOR_SECRETPROVIDER_ENVIRONMENT_PREFIX: {{secrets.MY_SECRET}} reads SUPER_SECRETS_MY_SECRET",
  "env": {
    "MY_SECRET": "unprefixed-leak",
    "SUPER_SECRETS_MY_SECRET": "foo-prefixed"
  },
  "exchanges": [
    {
      "request": {
        "headers": {
          "x-token": "foo-prefixed"
        },
        "method": "GET",
        "path": "/x"
      },
      "response": {
        "body": {},
        "status": 200
      }
    }
  ],
  "expected": {
    "complete": {
      "variables": {
        "myResponseBody": {}
      }
    }
  },
  "job": {
    "headers": {
      "resultExpression": "={\n  myResponseBody: response.body\n}"
    },
    "retries": 3,
    "variables": {
      "headers": {
        "X-Token": "{{ secrets.MY_SECRET }}"
      },
      "method": "GET",
      "url": "http://mock.local/x"
    }
  },
  "recorded": false,
  "secretPrefix": "SUPER_SECRETS_",
  "source": "https://docs.camunda.io/docs/self-managed/components/connectors/connectors-configuration/#secrets"
}
