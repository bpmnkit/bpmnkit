{
  "description": "deprecated bare secrets.X as a whole value still resolves",
  "env": {
    "BEARER_TOKEN": "tok-abcdef123"
  },
  "exchanges": [
    {
      "request": {
        "headers": {
          "authorization": "Bearer tok-abcdef123"
        },
        "method": "GET",
        "path": "/x"
      },
      "response": {
        "body": {},
        "status": 200
      }
    }
  ],
  "expected": {
    "complete": {
      "variables": {
        "myResponseBody": {}
      }
    }
  },
  "job": {
    "headers": {
      "resultExpression": "={\n  myResponseBody: response.body\n}"
    },
    "retries": 3,
    "variables": {
      "authentication": {
        "token": "secrets.BEARER_TOKEN",
        "type": "bearer"
      },
      "method": "GET",
      "url": "http://mock.local/x"
    }
  },
  "recorded": false,
  "source": "https://docs.camunda.io/docs/self-managed/components/connectors/connectors-configuration/#secrets"
}
