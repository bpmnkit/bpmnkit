{
  "description": "the docs' HTTP headers map",
  "exchanges": [
    {
      "request": {
        "headers": {
          "origin": "https://modeler.camunda.io/"
        },
        "method": "GET",
        "path": "/cors"
      },
      "response": {
        "body": {
          "ok": true
        },
        "status": 200
      }
    }
  ],
  "expected": {
    "complete": {
      "variables": {
        "myResponseBody": {
          "ok": true
        }
      }
    }
  },
  "job": {
    "headers": {
      "resultExpression": "={\n  myResponseBody: response.body\n}"
    },
    "retries": 3,
    "variables": {
      "headers": {
        "Origin": "https://modeler.camunda.io/"
      },
      "method": "GET",
      "url": "http://mock.local/cors"
    }
  },
  "recorded": false,
  "source": "https://docs.camunda.io/docs/components/connectors/protocol/rest/#http-headers"
}
