{
  "description": "a map body with Content-Type application/x-www-form-urlencoded is form-encoded",
  "exchanges": [
    {
      "request": {
        "form": {
          "lang": "en&de",
          "name": "Ada Lovelace"
        },
        "method": "POST",
        "path": "/form"
      },
      "response": {
        "body": {
          "ok": true
        },
        "status": 200
      }
    }
  ],
  "expected": {
    "complete": {
      "variables": {
        "myResponseBody": {
          "ok": true
        }
      }
    }
  },
  "job": {
    "headers": {
      "resultExpression": "={\n  myResponseBody: response.body\n}"
    },
    "retries": 3,
    "variables": {
      "body": {
        "lang": "en&de",
        "name": "Ada Lovelace"
      },
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded"
      },
      "method": "POST",
      "url": "http://mock.local/form"
    }
  },
  "recorded": false,
  "source": "https://docs.camunda.io/docs/components/connectors/protocol/rest/#content-type"
