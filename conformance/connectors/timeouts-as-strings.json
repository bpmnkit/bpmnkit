{
  "description": "timeouts given as strings (Zeebe literal inputs)",
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "path": "/t"
      },
      "response": {
        "body": {
          "ok": true
        },
        "status": 200
      }
    }
  ],
  "expected": {
    "complete": {
      "variables": {
        "myResponseBody": {
          "ok": true
        }
      }
    }
  },
  "job": {
    "headers": {
      "resultExpression": "={\n  myResponseBody: response.body\n}"
