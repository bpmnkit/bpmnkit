{
  "description": "a secret inside the URL",
  "env": {
    "BOT_TOKEN": "123:ABCxyz"
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "path": "/bot123:ABCxyz/getMe"
      },
      "response": {
        "body": {
          "ok": true
        },
        "status": 200
      }
    }
  ],
  "expected": {
    "complete": {
      "variables": {
        "myResponseBody": {
          "ok": true
        }
      }
    }
  },
  "job": {
    "headers": {
      "resultExpression": "={\n  myResponseBody: response.body\n}"
    },
    "retries": 3,
    "variables": {
      "method": "GET",
      "url": "http://mock.local/bot{{secrets.BOT_TOKEN}}/getMe"
    }
  },
  "recorded": false,
  "source": "https://docs.camunda.io/docs/self-managed/components/connectors/connectors-configuration/#secrets"
}
