{
  "description": "OAuth 2.0 client credentials, credentials in the body (docs steps 1–7)",
  "env": {
    "AUDIENCE": "api.example",
    "CLIENT_ID": "cid-4242",
    "CLIENT_SECRET": "csecret-9999"
  },
  "exchanges": [
    {
      "request": {
        "form": {
          "audience": "api.example",
          "client_id": "cid-4242",
          "client_secret": "csecret-9999",
          "grant_type": "client_credentials",
          "scope": "read:clients"
        },
        "method": "POST",
        "path": "/oauth/token"
      },
      "response": {
        "body": {
          "access_token": "at-777",
          "expires_in": 3600,
          "token_type": "Bearer"
        },
        "status": 200
      }
    },
    {
      "request": {
        "headers": {
          "authorization": "Bearer at-777"
        },
        "method": "GET",
        "path": "/clients"
      },
      "response": {
        "body": [
          {
            "id": 1
          }
        ],
        "status": 200
      }
    }
  ],
  "expected": {
    "complete": {
      "variables": {
        "myResponseBody": [
          {
            "id": 1
          }
        ]
      }
    }
  },
  "job": {
    "headers": {
      "resultExpression": "={\n  myResponseBody: response.body\n}"
    },
    "retries": 3,
    "variables": {
      "authentication": {
        "audience": "{{secrets.AUDIENCE}}",
        "clientAuthentication": "credentialsBody",
        "clientId": "{{secrets.CLIENT_ID}}",
        "clientSecret": "{{secrets.CLIENT_SECRET}}",
        "oauthTokenEndpoint": "http://mock.local/oauth/token",
        "scopes": "read:clients",
        "type": "oauth-client-credentials-flow"
      },
      "method": "GET",
      "url": "http://mock.local/clients"
    }
  },
  "recorded": false,
  "source": "https://docs.camunda.io/docs/components/connectors/protocol/rest/#rest-connector-oauth-token"
}
