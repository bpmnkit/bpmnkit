{
  "description": "basic auth from secrets",
  "env": {
    "PASS": "pw-secret",
    "USER": "ada"
  },
  "exchanges": [
    {
      "request": {
        "headers": {
          "authorization": "Basic YWRhOnB3LXNlY3JldA=="
        },
        "method": "GET",
        "path": "/basic"
      },
      "response": {
        "body": {
          "ok": true
        },
        "status": 200
      }
    }
  ],
  "expected": {
    "complete": {
      "variables": {
        "myResponseBody": {
          "ok": true
        }
      }
    }
  },
  "job": {
    "headers": {
      "resultExpression": "={\n  myResponseBody: response.body\n}"
    },
    "retries": 3,
    "variables": {
      "authentication": {
        "password": "{{secrets.PASS}}",
        "type": "basic",
        "username": "{{secrets.USER}}"
      },
      "method": "GET",
      "url": "http://mock.local/basic"
    }
  },
  "recorded": false,
  "source": "https://docs.camunda.io/docs/components/connectors/protocol/rest/#rest-connector-basic"
}
