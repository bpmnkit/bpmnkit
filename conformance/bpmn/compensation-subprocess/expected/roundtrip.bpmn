    <bpmn:transaction id="Tx" isForCompensation="true"/>
    <bpmn:adHocSubProcess id="Adhoc" isForCompensation="true"/>
    <bpmn:subProcess id="Evt" triggeredByEvent="true" isForCompensation="true"/>
    <bpmn:subProcess id="Plain"/>
  </bpmn:process>
</bpmn:definitions>

